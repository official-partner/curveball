---
import "@/styles/global.css";
import BaseHead from "@/components/utility/BaseHead.astro";
import SkipLink from "@/components/global/SkipLink.astro";
import Nav from "@/components/global/Nav.astro";
import Footer from "@/components/global/Footer.astro";
import Loader from "@/components/system/Loader.astro";
import PageTransitions from "@/components/system/PageTransitions.astro";
import SmoothScroll from "@/components/system/SmoothScroll.astro";
import type { SeoProps } from "@/types.ts";
import { SITE_LOCALE } from "@/consts.ts";
import { finishes } from "@/utils/finishes.ts";
import config from "../../op.config.json";

type Props = SeoProps & {
  /** Theme for the whole page. `inherit` leaves the root defaults in place (dark). */
  theme?: "inherit" | "light" | "dark" | "mustard" | "teal" | "brand";
  /** The page's own colour: the footer's symbol, the ball and the curve (red on Home, mustard on News, teal on
   * Contact). */
  accent?: "red" | "mustard" | "teal";
  /**
   * Fix the nav over the page rather than letting it stick in flow, so the
   * first section starts underneath it. Give that section
   * `paddingTop="navoverlap"` to clear the bar.
   */
  overlap?: boolean;
  /** A link at the right end of the menu, on a computer (a director's page: « Enquire about Jasper »). */
  action?: { text: string; href: string };
  /** The footer: with the curve (Home, News, Contact) or plain, a rule over it (a director's page, About). */
  footer?: "curve" | "plain";
};

const { theme = "inherit", accent = "red", overlap = false, action, footer = "curve", ...seo } = Astro.props;

/* The finishing touches, each off until op.config.json turns it on (src/utils/finishes.ts): the loading screen, the
   transition between pages, the smooth scroll. A "custom" one without its file stands in as its first preset. */
const own = Object.keys(
  import.meta.glob(
    "/src/components/system/{LoaderCustom,TransitionCustom}.astro",
  ),
);
const has = (name: string) => own.some((f) => f.endsWith(`/${name}.astro`));
const finish = finishes(config);
const loader =
  finish.loader === "custom" && !has("LoaderCustom") ? "logo" : finish.loader;
const transition =
  finish.transition === "custom" && !has("TransitionCustom")
    ? "slide"
    : finish.transition;
const { smoothScroll } = finish;
---

<!doctype html>
<html
  lang={SITE_LOCALE}
  class:list={[theme !== "inherit" && `theme-${theme}`]}
  data-page-theme={theme !== "inherit" ? `theme-${theme}` : undefined}
  data-page-transition={transition ?? undefined}
>
  <head>
    <BaseHead {...seo} />
    {loader && <Loader part="head" preset={loader} />}
    {transition && <PageTransitions part="head" preset={transition} />}
    {
      smoothScroll && (
        <SmoothScroll
          intensity={smoothScroll.intensity}
          touch={smoothScroll.touch}
        />
      )
    }
    <slot name="head" />
  </head>
  <body class={`accent-${accent}`}>
    {loader && <Loader part="cover" preset={loader} />}
    {transition && <PageTransitions part="body" preset={transition} />}
    <SkipLink />
    <Nav overlap={overlap} action={action} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer variant={footer} />
  </body>
</html>
