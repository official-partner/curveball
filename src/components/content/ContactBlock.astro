---
/* One way in on Contact: a question in h3, a line of text, the address. The whole block writes to the address. On
   hover the Figma's dot comes in before the question and the question makes room for it (a transform, nothing
   moves around it). */
import type { ContactBlock as Block } from "@/data/contact.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The block. */
  block: Block;
  /** Its place in the list, for OP System's Modifier. */
  index?: number;
}

const { render = true, block, index = 0 } = Astro.props;
---

{
  render && (
    <a class="contact-block" href={`mailto:${block.email}`} data-op-item={String(index)}>
      <h3 class="contact-block_title text-style-h3">
        <span class="contact-block_words" data-op-field="title">
          {block.title}
        </span>
      </h3>
      <p class="contact-block_text text-style-main" data-op-field="text">
        {block.text}
      </p>
      <p class="contact-block_email text-style-large" data-op-field="email">
        {block.email}
      </p>
    </a>
  )
}

<style is:global>
  @layer components {
    .contact-block {
      display: flex;
      flex-direction: column;
      align-items: start;
      color: inherit;
      text-decoration: none;
    }
    .contact-block_title {
      position: relative;
      max-width: 7.2em;
      --_dot: max(var(--dot-floor), var(--dot));
      &::before {
        content: "";
        position: absolute;
        inset-inline-start: 0;
        top: calc((var(--cap-height) - var(--_dot)) / 2);
        width: var(--_dot);
        aspect-ratio: 1;
        border-radius: var(--radius-round);
        background-color: var(--dot-color);
        scale: 0;
        transition: scale var(--hover-duration) var(--hover-ease);
      }
    }
    .contact-block_words {
      display: block;
      transition: translate var(--hover-duration) var(--hover-ease);
    }
    .contact-block_text {
      max-width: 19.5em;
      margin-top: var(--space-title);
    }
    .contact-block_email {
      margin-top: var(--space-action);
    }
    @media (hover: hover) {
      .contact-block:hover {
        & .contact-block_title::before {
          scale: 1;
        }
        & .contact-block_words {
          translate: calc(var(--_dot) + var(--space-dot)) 0;
        }
      }
    }
  }
</style>
