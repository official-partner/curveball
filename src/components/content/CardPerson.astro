---
/* A person of the team: the round portrait over two columns, the name and the role (the role at 30 %), the city with
   Email and LinkedIn a column over, then a few lines in large. */
import Img from "@/components/media/Img.astro";
import When from "@/components/system/When.astro";
import { img, type Item } from "@/utils/content.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The person, from the collection « Team ». */
  person: Item<"team">;
  /** Its place in the list, for where the list sets it. */
  index?: number;
  /** More classes, for where a list places it. */
  class?: string;
  /** Custom properties a list places it with. */
  style?: string;
  /** How much faster or slower than the page it travels (src/utils/parallax.ts). */
  depth?: number;
}

const { render = true, person, index = 0, class: extra, style = "", depth } = Astro.props;
const { name, role, location, email, linkedin, bio, photo } = person.data;
const links = [
  { label: "Email", href: email ? `mailto:${email}` : "" },
  { label: "Linkedin", href: linkedin ?? "" },
].filter((l) => l.href);
---

{
  render && (
    <article class:list={["card-person", extra]} data-op-item={person.id} data-parallax={depth || undefined} style={`--_order: ${index}; ${style}`}>
      <div class="card-person_media">
        {photo && <Img class="card-person_img cover-absolute object-fit-cover" {...img(photo)} alt={`Portrait of ${name}`} variant="constrained" sizes="(min-width: 64rem) 16vw, 50vw" />}
      </div>
      <p class="card-person_name text-style-main">
        <span data-op-field="name">{name}</span>
        {role && <br />}
        <When field="role" value={role} as="span" class="card-person_role">
          {role}
        </When>
      </p>
      <When field="location" value={location} as="p" class="card-person_location text-style-main">
        {location}
      </When>
      {links.length > 0 && (
        <ul class="card-person_links text-style-main">
          {links.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))}
        </ul>
      )}
      <When field="bio" value={bio} as="p" class="card-person_bio text-style-large">
        {bio}
      </When>
    </article>
  )
}

<style is:global>
  @layer components {
    .card-person {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--site-gutter);
      align-content: start;
      @media (width >= 64rem) {
        grid-template-columns: subgrid;
      }
    }
    .card-person_media {
      grid-column: 1 / span 2;
      position: relative;
      aspect-ratio: 1;
      border-radius: var(--radius-round);
      overflow: clip;
      background-color: var(--background-2);
    }
    .card-person_name {
      grid-column: 1 / -1;
      margin-top: var(--space-media);
    }
    .card-person_role,
    .card-person_links {
      color: var(--text-3);
    }
    .card-person_location {
      grid-column: 1 / span 2;
      margin-top: var(--space-title);
      @media (width >= 64rem) {
        grid-column: 1;
      }
    }
    .card-person_links {
      grid-column: 3;
      grid-row: 3;
      @media (width >= 64rem) {
        grid-column: 2 / -1;
      }
      margin-top: var(--space-title);
      & a {
        color: inherit;
        transition: color var(--hover-duration) var(--hover-ease);
        @media (hover: hover) {
          &:hover {
            color: var(--text);
          }
        }
      }
    }
    .card-person_bio {
      grid-column: 1 / -1;
      max-width: 18.5em;
      margin-top: var(--space-6);
    }
  }
</style>
