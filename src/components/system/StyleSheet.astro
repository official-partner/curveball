---
/* The style sheet: the system as the site uses it, read from system/curveball.json (the same file base.css is
   generated from), so what this page shows is what the site is made of. */
import system from "../../../system/curveball.json";
import LogoSymbol from "@/assets/logo/symbol.svg";
import Wordmark from "@/assets/logo/logo.svg";

const S = system as any;
const R = S.viewport.reference;
const weight: Record<number, string> = { 400: "Regular", 500: "Medium", 700: "Bold" };
const samples: Record<string, string> = {
  display: "jasper soloff",
  h1: "baz & wilder",
  h2: "We're in cahoots with filmmakers who live between the expected and the unexpected.",
  h3: "Off the usual playbook? Tell us, we'll find who was made for it.",
  "text-label": "Get in touch.",
  "text-large": "Started Five to Sixty in his second year at USC and has grown it into a group of four companies.",
  "text-main": "Briefs, bids, availability, awkward timelines. This is the one you want.",
  "text-small": "© 2026 Curveball Films. Part of the Five to Sixty family, with Clockwork Post and FatHappy Media.",
};
const fmt = (v: number) => (Math.round(v * 10) / 10).toString();
const styles = Object.keys(S.text).map((n) => {
  const t = S.text[n];
  const [ph, tb, dk] = S.fluid[n];
  const floor = S.floors[n];
  const at = (w: number) => Math.max(floor ?? 0, (dk * w) / R);
  const cls = n.startsWith("text-") ? "text-style-" + n.slice(5) : "text-style-" + n;
  return { n, cls, t, dk, tb, ph, floor, s1440: at(1440), s1024: at(1024), sample: samples[n] ?? n };
});
const swatches = Object.entries(S.swatches) as [string, { hex: string; from: string }][];
const themes = [
  ["dark", "the default: Home, the footer"],
  ["mustard", "News"],
  ["teal", "Contact"],
  ["light", "stone, black text"],
  ["brand", "red, black text"],
];
const accents = ["red", "mustard", "teal"];
const spaces = Object.keys(S.fluid).filter((k) => /^(space-\d+|section-space-\w+)$/.test(k));
const rails = [["margin", "c1"], ["nav", "c3"], ["two", "c5"], ["split", "c6"], ["half", "c7"], ["three", "c9"], ["aside", "c10"], ["last", "c12"]];
---

<section class="style-sheet_wrap">
  <div class="style-sheet_layout site-grid">
    <header class="style-sheet_head">
      <p class="text-style-label style-sheet_t2">Curveball · Lumos for Astro</p>
      <h1 class="text-style-h2">Style sheet</h1>
      <p class="style-sheet_lede text-style-main">
        Generated from <code>system/curveball.json</code>, like <code>base.css</code>: this page shows exactly what the
        site uses. Values at 1728 px (the Figma); from 1728 down to 1024 everything scales with the grid, then the tablet
        and the phone have their own. Current width: <b class="style-sheet_vw">…</b>
      </p>
    </header>

    <h2 class="style-sheet_title text-style-label">Typography · ES Build</h2>
    <div class="style-sheet_types">
      {styles.map((s) => (
        <div class="style-sheet_type">
          <div class="style-sheet_meta text-style-small">
            <code>.{s.cls}</code>
            <span>{weight[s.t.weight]} {fmt(s.dk)} / {s.t.lh} / {s.t.ls}{s.t.tt !== "none" ? " · each word capitalised" : ""}</span>
            <span>1440: {fmt(s.s1440)} · 1024: {fmt(s.s1024)}{s.floor ? ` (floor ${s.floor})` : ""} · tablet {s.tb} · phone {s.ph}</span>
            <span class="style-sheet_live">now: …</span>
          </div>
          <p class:list={["style-sheet_sample", s.cls]}>{s.sample}</p>
        </div>
      ))}
    </div>

    <h2 class="style-sheet_title text-style-label">Colours and themes</h2>
    <div class="style-sheet_swatches">
      {swatches.map(([n, v]) => (
        <div class="style-sheet_swatch text-style-small">
          <span class="style-sheet_chip" style={`--_c: var(--${n})`} />
          <code>--{n}</code>
          <span>{v.hex}</span>
          <span class="style-sheet_t2">{v.from}</span>
        </div>
      ))}
    </div>
    <div class="style-sheet_themes">
      {themes.map(([n, label]) => (
        <div class:list={["style-sheet_theme", `theme-${n}`]}>
          <p class="text-style-label">theme-{n}</p>
          <p class="text-style-main">{label}</p>
          <p class="text-style-main style-sheet_t2">text 2 · 50 %</p>
          <p class="text-style-main style-sheet_t3">text 3 · 30 %</p>
          <p class="text-style-h3 style-sheet_accent">Baz & Wilder</p>
        </div>
      ))}
    </div>
    <div class="style-sheet_accents">
      {accents.map((a) => (
        <div class:list={["style-sheet_accent-card", "theme-dark", `accent-${a}`]}>
          <LogoSymbol class="style-sheet_symbol" aria-hidden="true" />
          <p class="text-style-small"><code>.accent-{a}</code>: the page's colour on the footer's mark, the ball and the curve</p>
        </div>
      ))}
    </div>

    <h2 class="style-sheet_title text-style-label">Grid and rails</h2>
    <div class="style-sheet_grid text-style-small">
      {rails.map(([n, c]) => (
        <span class="style-sheet_rail" style={`grid-column: ${n} / span 1`}>
          <code>{n}</code>
          <span>{c}</span>
        </span>
      ))}
      <span class="style-sheet_rail is-end"><code>end</code></span>
    </div>
    <p class="style-sheet_note text-style-small style-sheet_t2">
      12 columns, margin 32, gutter 12 at 1728 (Sam, Nov 11). 8 columns on a tablet, 4 on a phone, the same names.
    </p>

    <h2 class="style-sheet_title text-style-label">Spacing</h2>
    <div class="style-sheet_spaces text-style-small">
      {spaces.map((k) => (
        <div class="style-sheet_space">
          <code>--{k}</code>
          <span class="style-sheet_bar" style={`--_w: var(--${k})`} />
          <span>{fmt(S.fluid[k][2])} at 1728 · tablet {S.fluid[k][1]} · phone {S.fluid[k][0]}</span>
        </div>
      ))}
      {(Object.entries(S.roles ?? {}) as [string, { ref: string; job: string }][]).map(([k, r]) => (
        <div class="style-sheet_space">
          <code>--{k}</code>
          <span class="style-sheet_bar" style={`--_w: var(--${k})`} />
          <span>= {r.ref}, {fmt(S.fluid[r.ref][2])} at 1728: {r.job}</span>
        </div>
      ))}
    </div>

    <h2 class="style-sheet_title text-style-label">Logo and parts</h2>
    <div class="style-sheet_parts">
      <Wordmark class="style-sheet_wordmark" aria-hidden="true" />
      <div class="style-sheet_row">
        <LogoSymbol class="style-sheet_mark" aria-hidden="true" />
        <span class="style-sheet_dot" />
        <span class="style-sheet_photo" />
      </div>
    </div>
  </div>
</section>

<script>
  import { onPage } from "@/utils/page.ts";
  onPage((signal) => {
    const show = () => {
      const vw = document.querySelector(".style-sheet_vw");
      if (vw) vw.textContent = document.documentElement.clientWidth + " px";
      document.querySelectorAll<HTMLElement>(".style-sheet_live").forEach((el) => {
        const probe = el.closest(".style-sheet_type")?.querySelector(".style-sheet_sample");
        if (probe) el.textContent = "now: " + parseFloat(getComputedStyle(probe).fontSize).toFixed(1) + " px";
      });
    };
    show();
    addEventListener("resize", show, { signal });
  });
</script>

<style is:global>
  @layer components {
    .style-sheet_wrap {
      padding-top: calc(var(--nav-height) + var(--section-space-small));
      padding-bottom: var(--section-space-large);
    }
    .style-sheet_layout {
      row-gap: var(--space-6);
      align-items: start;
    }
    .style-sheet_head,
    .style-sheet_title,
    .style-sheet_types,
    .style-sheet_swatches,
    .style-sheet_themes,
    .style-sheet_accents,
    .style-sheet_grid,
    .style-sheet_note,
    .style-sheet_spaces,
    .style-sheet_parts {
      grid-column: margin / end;
    }
    .style-sheet_head {
      display: flex;
      flex-direction: column;
      gap: var(--space-label);
    }
    .style-sheet_lede {
      max-width: 60ch;
    }
    .style-sheet_title {
      padding-top: var(--space-rule);
      border-top: var(--border-width) solid var(--border);
    }
    .style-sheet_t2 {
      color: var(--text-2);
    }
    .style-sheet_t3 {
      color: var(--text-3);
    }
    .style-sheet_types {
      display: grid;
      grid-template-columns: subgrid;
      row-gap: var(--space-8);
    }
    .style-sheet_type {
      grid-column: margin / end;
      display: grid;
      grid-template-columns: subgrid;
      row-gap: var(--space-4);
      align-items: start;
    }
    .style-sheet_meta {
      grid-column: margin / span 4;
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      color: var(--text-2);
      @media (width >= 64rem) {
        grid-column: margin / two;
      }
    }
    .style-sheet_sample {
      grid-column: margin / end;
      @media (width >= 64rem) {
        grid-column: two / end;
      }
    }
    .text-style-display.style-sheet_sample,
    .text-style-h1.style-sheet_sample {
      color: var(--heading-accent);
    }
    .style-sheet_swatches {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
      gap: var(--space-6) var(--site-gutter);
    }
    .style-sheet_swatch {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }
    .style-sheet_chip {
      display: block;
      width: 100%;
      aspect-ratio: 1;
      border-radius: var(--radius-round);
      background-color: var(--_c);
      outline: var(--border-width) solid var(--border);
    }
    .style-sheet_themes {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
      gap: var(--site-gutter);
    }
    .style-sheet_theme {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      padding: var(--space-5);
      outline: var(--border-width) solid var(--border);
    }
    .style-sheet_accent {
      color: var(--heading-accent);
    }
    .style-sheet_accents {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
      gap: var(--site-gutter);
    }
    .style-sheet_accent-card {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      padding: var(--space-5);
    }
    .style-sheet_symbol {
      width: var(--space-9);
      color: var(--page-accent);
    }
    .style-sheet_grid {
      display: grid;
      grid-template-columns: subgrid;
      row-gap: var(--space-2);
    }
    .style-sheet_rail {
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
      padding-top: var(--space-2);
      border-top: var(--border-width) solid var(--text);
      &.is-end {
        grid-column: last / end;
        justify-self: end;
        text-align: end;
      }
    }
    .style-sheet_spaces {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }
    .style-sheet_space {
      display: grid;
      grid-template-columns: minmax(8rem, 14rem) auto 1fr;
      align-items: center;
      gap: var(--space-4);
    }
    .style-sheet_bar {
      display: block;
      width: var(--_w);
      height: var(--space-2);
      background-color: var(--text);
    }
    .style-sheet_parts {
      display: flex;
      flex-direction: column;
      gap: var(--space-8);
    }
    .style-sheet_wordmark {
      width: 100%;
      height: auto;
    }
    .style-sheet_row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-8);
    }
    .style-sheet_mark {
      width: var(--logo-size);
      color: var(--text);
    }
    .style-sheet_dot {
      width: max(var(--dot-floor), var(--dot));
      aspect-ratio: 1;
      border-radius: var(--radius-round);
      background-color: var(--dot-color);
    }
    .style-sheet_photo {
      width: 12rem;
      aspect-ratio: 1;
      border-radius: var(--radius-round);
      background-color: var(--background-3);
    }
  }
</style>
