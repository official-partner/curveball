---
/* The site's menu, over the top of every page: the symbol at the margin, then directors, about and news stacked at
   column 7, contact us at column 10, as the footer's menu (the same place on every page: Sam, Nov 11). Their cap tops
   line up with the symbol's top, one margin from the top of the page. */
import LogoSymbol from "@/assets/logo/symbol.svg";
import ArrowLink from "@/components/content/ArrowLink.astro";
import { SITE_NAME } from "@/consts.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Kept for the starter's layout: the menu always lies over the page. */
  overlap?: boolean;
  /** A link at the right end, from a computer up (a director's page: « Enquire about Jasper »). */
  action?: { text: string; href: string };
  /** What it lies over: the page's ground (its theme's colour for the menu), or a picture or a film (light). */
  over?: "ground" | "visual";
}

const { render = true, action, over = "ground" } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const links = [
  { href: "/directors", label: "directors" },
  { href: "/about", label: "about" },
  { href: "/news", label: "news" },
];
const current = (href: string) => (path === href || path.startsWith(href + "/") ? "page" : undefined);
---

{
  render && (
    <header class:list={["nav_wrap", over === "visual" && "is-over-visual"]} data-op-section="Nav">
      <div class="nav_layout site-grid">
        <a class="nav_logo" href="/" aria-label={`${SITE_NAME}, home`}>
          <LogoSymbol class="logo-art" aria-hidden="true" />
        </a>
        <nav class="nav_menu" aria-label="Main">
          <ul class="nav_links text-style-large">
            {links.map((l) => (
              <li>
                <a class="nav_link" href={l.href} aria-current={current(l.href)}>
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <a class="nav_contact nav_link text-style-large" href="/contact" aria-current={current("/contact")}>
          contact us
        </a>
        {action && <ArrowLink class="nav_action nav_link" href={action.href} text={action.text} />}
      </div>
    </header>
  )
}

<style is:global>
  @layer components {
    .nav_wrap {
      position: absolute;
      inset: 0 0 auto;
      z-index: 20;
      padding-top: var(--site-margin);
      view-transition-name: site-nav;
      /* it steps aside while a film is watched, as the page's other parts do, and comes back as the film dissolves
         (60 % of its way back) */
      transition: opacity var(--duration-medium) var(--ease-out) calc(var(--duration-base) * 0.6);
      @media (prefers-reduced-motion: reduce) {
        transition-delay: 0s;
      }
      :root[data-watching] & {
        opacity: 0;
        pointer-events: none;
        transition-delay: 0s;
      }
    }
    /* over a picture or a film (Home's opening), light whatever the ground: the taupe is for text on the black
       (Sam, Nov 27, comment 51) */
    .nav_wrap.is-over-visual {
      --nav-text: var(--on-visual);
    }
    .nav_layout {
      align-items: start;
    }
    /* the menu in the theme's own colour for it: taupe on the black, as the page's text (Sam, Nov 25, comment 47);
       the text's colour on the other grounds */
    .nav_logo {
      grid-column: margin;
      display: block;
      width: max(var(--logo-size-floor), var(--logo-size));
      color: var(--nav-text);
    }
    .nav_menu {
      grid-column: half;
    }
    .nav_contact {
      grid-column: last;
      justify-self: start;
      @media (width >= 48rem) {
        grid-column: aside;
      }
    }
    /* at the right end, from a computer up; below it the page carries it (DirectorHero) */
    .nav_action {
      display: none;
      @media (width >= 64rem) {
        display: inline-flex;
        grid-column: last;
        justify-self: end;
        white-space: nowrap;
      }
    }
    .nav_link {
      color: var(--nav-text);
      transition: color var(--hover-duration) var(--hover-ease);
      &[aria-current="page"] {
        color: color-mix(in srgb, var(--nav-text) var(--tone-muted), transparent);
      }
      @media (hover: hover) {
        &:hover {
          color: color-mix(in srgb, var(--nav-text) var(--tone-muted), transparent);
        }
      }
    }
  }
</style>
