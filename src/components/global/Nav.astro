---
/* The site's menu, over the top of every page: the symbol at the margin, then directors, about and news stacked at
   column 7, contact us at column 10, as the footer's menu (the same place on every page: Sam, Nov 11). Their cap tops
   line up with the symbol's top, one margin from the top of the page. */
import LogoSymbol from "@/assets/logo/symbol.svg";
import { SITE_NAME } from "@/consts.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Kept for the starter's layout: the menu always lies over the page. */
  overlap?: boolean;
}

const { render = true } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const links = [
  { href: "/directors", label: "directors" },
  { href: "/about", label: "about" },
  { href: "/news", label: "news" },
];
const current = (href: string) => (path === href || path.startsWith(href + "/") ? "page" : undefined);
---

{
  render && (
    <header class="nav_wrap" data-op-section="Nav">
      <div class="nav_layout site-grid">
        <a class="nav_logo" href="/" aria-label={`${SITE_NAME}, home`}>
          <LogoSymbol aria-hidden="true" />
        </a>
        <nav class="nav_menu" aria-label="Main">
          <ul class="nav_links text-style-large">
            {links.map((l) => (
              <li>
                <a class="nav_link" href={l.href} aria-current={current(l.href)}>
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <a class="nav_contact nav_link text-style-large" href="/contact" aria-current={current("/contact")}>
          contact us
        </a>
      </div>
    </header>
  )
}

<style is:global>
  @layer components {
    .nav_wrap {
      position: absolute;
      inset: 0 0 auto;
      z-index: 20;
      padding-top: var(--site-margin);
      view-transition-name: site-nav;
    }
    .nav_layout {
      align-items: start;
    }
    .nav_logo {
      grid-column: margin;
      display: block;
      width: max(var(--logo-size-floor), var(--logo-size));
      color: var(--text);
      & svg {
        display: block;
        width: 100%;
        height: auto;
      }
    }
    .nav_menu {
      grid-column: half;
    }
    .nav_contact {
      grid-column: last;
      justify-self: start;
      @media (width >= 48rem) {
        grid-column: aside;
      }
    }
    .nav_link {
      color: var(--text);
      transition: color var(--hover-duration) var(--hover-ease);
      &[aria-current="page"] {
        color: var(--text-2);
      }
      @media (hover: hover) {
        &:hover {
          color: var(--text-2);
        }
      }
    }
  }
</style>
