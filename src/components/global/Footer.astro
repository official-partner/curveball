---
/* The footer: the curve that closes every page (ES Build's « u », the Figma's own outline) drawn in the page's colour
   above the black, the symbol in that colour, the menu, the line and the small print. Measured on News and Contact,
   identical on both (Home's curve sat 61 px to the right: one curve for all). Geometry in the Figma's units, scaled
   with the footer's width (cqw): 1728 wide, the symbol 290 below the top, 531 wide. */
import LogoSymbol from "@/assets/logo/symbol.svg";
import { SITE_NAME } from "@/consts.ts";
import { social, legal } from "@/data/site.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** `plain`: no curve, a rule over it (a director's page, About: the Figma's own). */
  variant?: "curve" | "plain";
}

const { render = true, variant = "curve" } = Astro.props;
const menu = [
  { href: "/directors", label: "directors" },
  { href: "/about", label: "about" },
  { href: "/news", label: "news" },
];
/* The bottom curve: the « u » turned a quarter, its top stem running off the right edge (Figma 9:452 on News) */
const curve =
  "M-281.952 957.828C-277.695 1570.84 105.436 1907.14 646.077 1907.14L1765.67 1907.14L1765.67 1319.67L688.647 1319.67C407.684 1319.67 233.146 1196.22 228.889 957.828C224.632 698.15 399.17 587.468 684.39 587.468L1765.67 587.468L1765.67 0L641.82 0C126.721 0 -286.209 395.902 -281.952 957.828Z";
---

{
  render && (
    <footer class:list={["footer_wrap theme-dark", variant === "plain" && "is-plain"]} data-paint="theme-dark" data-op-section="Footer">
      {variant === "curve" && (
        <svg class="footer_curve" viewBox="0 0 1728 300" aria-hidden="true" focusable="false">
          <rect class="footer_curve-ground" width="1728" height="300" />
          <path class="footer_curve-shape" d={curve} />
        </svg>
      )}
      <div class="footer_layout site-grid">
        <a class="footer_symbol" href="/" aria-label={`${SITE_NAME}, home`}>
          <LogoSymbol aria-hidden="true" />
        </a>
        <nav class="footer_menu" aria-label="Footer">
          <ul class="text-style-large">
            {menu.map((l) => (
              <li>
                <a class="footer_link" href={l.href}>
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <a class="footer_contact footer_link text-style-large" href="/contact">
          contact us
        </a>
        <p class="footer_social text-style-large" data-op-list="social" data-op-source="src/data/site.ts">
          {social.map((s, i) => (
            <>
              {s.href ? (
                <a class="footer_link" href={s.href} data-op-item={s.label} aria-label={s.name}>
                  {s.label}
                </a>
              ) : (
                <span data-op-item={s.label} title={s.name}>
                  {s.label}
                </span>
              )}
              {i < social.length - 1 && ", "}
            </>
          ))}
        </p>
        <p class="footer_line text-style-h2">
          We're in cahoots with filmmakers who live between the expected and the unexpected.
        </p>
        <p class="footer_legal text-style-small">
          © 2026 Curveball Films. Part of the Five to Sixty family, with Clockwork Post and FatHappy Media.
        </p>
        <p class="footer_policies text-style-small">
          {legal.map((l, i) => (
            <>
              <a class="footer_link" href={l.href}>
                {l.label}
              </a>
              {i < legal.length - 1 && ", "}
            </>
          ))}
        </p>
      </div>
    </footer>
  )
}

<style is:global>
  @layer components {
    .footer_wrap {
      position: relative;
      container-type: inline-size;
      overflow: clip;
      --_u: calc(100cqw / 1728);
      /* on a computer, the footer's height without its symbol, which grows with the width: the curve, the line and the
         small print come to 40.2 % of it; the plain one's rule instead of the curve, 24.8 % (measured from 1024 to
         1920) */
      --_rest: 40.2cqw;
      /* what may sit above the screen's top: the curve's 290 over the symbol and the menu, which come to the top
         with a small margin (the site's) over them (Sam, Nov 12, comment 16); the plain one keeps its rule on screen */
      --_above: calc(var(--_u) * 290 - var(--site-margin));
      &.is-plain {
        --_rest: 24.8cqw;
        --_above: calc(-1 * var(--space-3));
      }
    }
    .footer_curve {
      position: absolute;
      inset: 0 0 auto;
      width: 100%;
      height: auto;
      pointer-events: none;
    }
    .footer_curve-ground {
      fill: var(--page-accent);
    }
    .footer_curve-shape {
      fill: var(--background);
    }
    .footer_layout {
      position: relative;
      padding-top: calc(var(--_u) * 290);
      padding-bottom: var(--site-margin);
      row-gap: var(--space-9);
      align-items: start;
      /* plain: the rule margin to margin at its top, the symbol 24 under it (the Figma's director page and About) */
      .is-plain & {
        padding-top: var(--space-5);
        background: linear-gradient(var(--border), var(--border)) var(--site-margin) 0 / calc(100% - 2 * var(--site-margin))
          var(--border-width) no-repeat;
      }
    }
    .footer_symbol {
      grid-column: margin / span 2;
      grid-row: 1;
      display: block;
      color: var(--page-accent);
      @media (width >= 48rem) {
        grid-column: margin / span 3;
      }
      /* the Figma's 531 at most, smaller on a short screen so the footer, from its symbol and menu down, stays within
         one (Sam, Nov 12: « idéalement max 100vh ... avec un min »), 144 at least */
      @media (width >= 64rem) {
        grid-column: margin / span 4;
        width: clamp(9rem, calc(100svh - var(--_rest) + var(--_above)), calc(var(--_u) * 531));
      }
      & svg {
        display: block;
        width: 100%;
        height: auto;
      }
      /* on a red ground (the footer painted a red director's colour, data-paint), the symbol in the text's black */
      .theme-brand & {
        color: var(--text);
      }
      transition: color var(--paint-duration, 0s) var(--ease-travel);
    }
    .footer_menu,
    .footer_contact,
    .footer_social {
      grid-row: 1;
      color: var(--heading-accent);
    }
    .footer_menu {
      grid-column: two;
      @media (width >= 48rem) {
        grid-column: half;
      }
    }
    .footer_contact {
      grid-column: last;
      justify-self: start;
      @media (width >= 48rem) {
        grid-column: aside;
      }
    }
    .footer_social {
      grid-column: last;
      align-self: start;
      margin-top: calc(var(--text-large) * 2);
      @media (width >= 48rem) {
        margin-top: 0;
      }
    }
    .footer_line {
      grid-column: margin / end;
      color: var(--heading-accent);
      @media (width >= 64rem) {
        grid-column: margin / last;
        /* the Figma's 1421, which keeps its three lines as drawn */
        max-width: calc(var(--_u) * 1421);
      }
    }
    .footer_legal,
    .footer_policies {
      color: var(--text-3);
    }
    .footer_legal {
      grid-column: margin / end;
      margin-top: calc(var(--space-8) - var(--space-9));
      @media (width >= 48rem) {
        grid-column: margin / aside;
      }
    }
    .footer_policies {
      grid-column: margin / end;
      margin-top: calc(var(--space-3) - var(--space-9));
      @media (width >= 48rem) {
        grid-column: aside / end;
        grid-row: 3;
        justify-self: end;
        margin-top: calc(var(--space-8) - var(--space-9));
      }
    }
    .footer_link {
      color: inherit;
      transition: color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          color: var(--text);
        }
      }
    }
  }
</style>
