---
/* A director's page opens on their colour (the page's theme): their portrait in a circle and their name in the
   display type on one line, then the rule and the row of their bio (with the Figma's dot and plus), where they are
   based (column 7) and their clients (column 10), each label on its own line above its names, as the Figma sets them.
   Measured on the Figma's « Directors » frame (Jasper Soloff): the name's cap top 342 down, the portrait 0.8 of the
   type's size, 64 to the rule, 144 to the reel. It paints its own ground, above the reel, whose film waits under it
   (DirectorReel). */
import Img from "@/components/media/Img.astro";
import ArrowLink from "@/components/content/ArrowLink.astro";
import When from "@/components/system/When.astro";
import { img, type Item } from "@/utils/content.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The director, from the collection « Directors ». */
  director: Item<"directors">;
  /** « Enquire about … »: in the menu on a computer, under the bio below it. */
  enquire?: { text: string; href: string };
}

const { render = true, director, enquire } = Astro.props;
const { name, portrait, bio, based, clients } = director.data;
const empty = !bio && !(based ?? []).length && !(clients ?? []).length;
---

{
  render && (
    <section class="director-hero_wrap" data-op-section="DirectorHero">
      <div class="director-hero_layout site-grid">
        <div class="director-hero_title" data-page-reveal>
          <When field="portrait" value={portrait} class="director-hero_portrait">
            {portrait && <Img {...img(portrait)} alt={`Portrait of ${name}`} variant="constrained" loading="eager" />}
          </When>
          <h1 class="director-hero_name text-style-display" data-op-field="name">
            {name}
          </h1>
        </div>
        <div class:list={["director-hero_row rule-top", empty && "is-empty"]} data-page-reveal>
          <When field="bio" value={bio} as="p" class="director-hero_bio dot-label is-plus text-style-large">
            {bio}
          </When>
          <When field="based" value={based} as="p" class="director-hero_based text-style-main">
            <span class="director-hero_key">Based</span>
            {(based ?? []).map((city) => [<br />, city])}
          </When>
          <When field="clients" value={clients} as="p" class="director-hero_clients text-style-main">
            <span class="director-hero_key">Clients</span>
            {(clients ?? []).map((client) => [<br />, client])}
          </When>
          {enquire && <ArrowLink class="director-hero_enquire" href={enquire.href} text={enquire.text} />}
        </div>
      </div>
    </section>
  )
}

<style is:global>
  @layer components {
    .director-hero_wrap {
      position: relative;
      z-index: 1;
      padding-top: calc(var(--page-top) + var(--section-space-medium));
      padding-bottom: var(--section-space-medium);
      background-color: var(--background);
    }
    .director-hero_layout {
      row-gap: var(--space-9);
    }
    .director-hero_title {
      grid-column: margin / end;
      display: flex;
      align-items: center;
      gap: var(--space-6);
      min-width: 0;
    }
    .director-hero_portrait {
      flex: none;
      /* the Figma's 168 for type 210: 0.8 of the name's size, centred on its capitals */
      width: calc(0.8 * var(--display));
      aspect-ratio: 1;
      overflow: hidden;
      border-radius: var(--radius-round);
      & img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
    }
    .director-hero_name {
      min-width: 0;
      color: var(--text);
    }
    .director-hero_row {
      grid-column: margin / end;
      &.is-empty {
        @media (width >= 64rem) {
          display: none;
        }
      }
      display: grid;
      grid-template-columns: subgrid;
      row-gap: var(--space-7);
      align-items: start;
    }
    .director-hero_bio {
      grid-column: margin / end;
      max-width: 36em;
      @media (width >= 48rem) {
        grid-column: margin / two;
      }
      @media (width >= 64rem) {
        grid-column: margin / split;
      }
    }
    .director-hero_based {
      grid-column: margin / span 2;
      @media (width >= 48rem) {
        grid-column: two / span 2;
      }
      @media (width >= 64rem) {
        grid-column: half / span 3;
      }
    }
    .director-hero_clients {
      grid-column: three / end;
      @media (width >= 48rem) {
        grid-column: aside / end;
      }
    }
    .director-hero_key {
      color: var(--text-3);
    }
    .director-hero_enquire {
      grid-column: margin / end;
      justify-self: start;
      @media (width >= 64rem) {
        display: none;
      }
    }
  }
</style>
