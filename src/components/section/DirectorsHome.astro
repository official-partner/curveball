---
/* The directors: the row « Directors » with its two filters (Industry at column 7, Location at column 10, as the
   Figma), then every director's name in the big type, one per line, each a link to their page. A filter keeps the
   names that match it; « All » shows everyone. The directors come from the collection « Directors ».
   The name that crosses the middle of the screen is the active one (Sam, Nov 11: « les noms seraient actifs au milieu
   de l'écran et non pas au over »; Nov 12: the first caught earlier, the last kept later): the whole page takes that
   director's colour (the same as their page), the active name turns black, the others black at 30 %, « View
   director » stands at the row's far right (Sam, Nov 12) and travels from name to name as they take their turn, and
   that director's own balls, carrying their films, rise through the screen. Each row is one link, and « View
   director » links to the active one. Home shows it on the page's dark; a
   director's page shows it as « Other Directors » (without them) on its own dark. */
import { getImage } from "astro:assets";
import ArrowLink from "@/components/content/ArrowLink.astro";
import { getItems, LIVE } from "@/utils/content.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The row's label. */
  label?: string;
  /** A director left out (their own page). */
  exclude?: string;
  /** On a page of another colour: the section paints the dark itself. */
  dark?: boolean;
  /** `h1` when the list is the page (the directors' own page): it then starts a page's height down. */
  as?: "h1" | "h2";
}

const { render = true, label = "Directors", exclude, dark = false, as: Heading = "h2" } = Astro.props;
const directors = (await getItems("directors")).filter((d) => d.id !== exclude);
const projects = await getItems("projects");
/* Each director's film stills, as small pictures for the balls (480 wide, twice a ball's size on a computer); on the
   live staging, whose images pass through untouched, the build's own file (an optimized URL would not resolve there) */
const stills = Object.fromEntries(
  await Promise.all(
    directors.map(async (d) => {
      const own = projects.filter((p) => p.data.director?.id === d.id && p.data.still);
      const urls = await Promise.all(
        own.map(async (p) => {
          const pic = p.data.still!;
          if (!("format" in pic)) return pic.src;
          return LIVE ? pic.src : (await getImage({ src: pic, width: 480, format: "webp" })).src;
        }),
      );
      return [d.id, urls] as const;
    }),
  ),
);
const industries = ["Docustyle", "Comedy", "Story", "Spectacle", "Fashion"];
const locations = ["Chicago", "Los Angeles", "New Orleans", "New York"];
const filters = [
  { key: "industry", label: "Industry", options: industries, class: "is-industry" },
  { key: "location", label: "Location", options: locations, class: "is-location" },
];
---

{
  render && (
    <section
      class:list={["directors-home_wrap", dark && "theme-dark is-dark", Heading === "h1" && "is-page"]}
      data-paint={dark ? "theme-dark" : undefined}
      data-op-section="DirectorsHome"
    >
      <div class="directors-home_layout site-grid">
        <div class="directors-home_row rule-top">
          <Heading class="directors-home_label dot-label text-style-large" data-page-reveal={Heading === "h1" ? "" : undefined}>
            {label}
          </Heading>
          {filters.map((f) => (
            <div class:list={["directors-home_filter", f.class]} role="group" aria-label={`Filter by ${f.label.toLowerCase()}`}>
              <p class="text-style-main">{f.label}</p>
              <ul class="directors-home_options text-style-main">
                {["All", ...f.options].map((o) => (
                  <li>
                    <button
                      class="directors-home_option"
                      type="button"
                      data-filter={f.key}
                      data-value={o === "All" ? "" : o}
                      aria-pressed={o === "All" ? "true" : "false"}
                    >
                      {o}
                    </button>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <div class="directors-home_names">
        <ul class="directors-home_list text-style-h1" data-op-list="directors" data-op-source="astro:directors">
          {directors.map((d) => (
            <li
              class="directors-home_item"
              data-op-item={d.id}
              data-industry={(d.data.industries ?? []).join("|")}
              data-location={d.data.location ?? ""}
              data-colour={d.data.colour ?? "red"}
            >
              <a class="directors-home_name" href={`/directors/${d.id}`}>
                <span data-op-field="name">{d.data.name}</span>
              </a>
            </li>
          ))}
        </ul>
          {/* one for the list, a mouse's shortcut to the active row's own link (keyboards and readers use the row) */}
          <a class="directors-home_view" href={directors[0] ? `/directors/${directors[0].id}` : "/directors"} tabindex="-1" aria-hidden="true">
            <ArrowLink text="View director" />
          </a>
        </div>
        <p class="directors-home_empty text-style-main" hidden>
          No director here yet.
        </p>
      </div>
      <div class="directors-home_balls" aria-hidden="true">
        {directors.map((d) =>
          (stills[d.id] ?? []).slice(0, 3).map((src) => (
            <span class="directors-home_ball" data-for={d.id}>
              <img class="directors-home_film" alt="" decoding="async" data-src={src} />
            </span>
          )),
        )}
      </div>
    </section>
  )
}

<script>
  import { gsap } from "gsap";
  import { CustomEase } from "gsap/CustomEase";
  import { onPage } from "@/utils/page.ts";

  gsap.registerPlugin(CustomEase);
  const THEMES: Record<string, string> = { red: "theme-brand", mustard: "theme-mustard", teal: "theme-teal" };
  const ALL = Object.values(THEMES);
  /* Each director's balls, after the Figma's three hover frames (James, Jasper, Kevin) and Sam (Nov 12: « moins de
     boules, 2, 3 ou 4 par écran, plus scattered ... chaque director a ses propres boules qui scroll de bas en haut »):
     [x, y, pace], where the ball's centre is when its director's name is in the middle of the screen (fractions of
     the screen), and how much faster than the names it rises. Directors take the three in turn, mirrored every
     other round, so two neighbours never share a place. */
  const LAYOUTS: [number, number, number][][] = [
    [
      [0.32, 0.16, 1.45],
      [0.77, 0.62, 1.85],
      [0.42, 0.9, 1.6],
    ],
    [
      [0.42, 0.26, 1.5],
      [0.76, 0.74, 1.8],
      [0.18, 0.92, 1.6],
    ],
    [
      [0.52, 0.04, 1.55],
      [0.89, 0.68, 1.85],
      [0.25, 0.82, 1.45],
    ],
  ];
  const css = (name: string) => getComputedStyle(document.documentElement).getPropertyValue(name).trim();
  const seconds = (name: string) => (parseFloat(css(name)) || 0) / (css(name).endsWith("ms") ? 1000 : 1);
  const curve = (name: string, fallback: string) => {
    const m = css(name).match(/cubic-bezier\(([^)]+)\)/);
    return CustomEase.create(`directors${name}`, m ? m[1] : fallback);
  };

  onPage((signal) => {
    document.querySelectorAll<HTMLElement>(".directors-home_wrap").forEach((wrap) => {
      const items = [...wrap.querySelectorAll<HTMLElement>(".directors-home_item")];
      const empty = wrap.querySelector<HTMLElement>(".directors-home_empty");
      const reduce = matchMedia("(prefers-reduced-motion: reduce)");
      const root = document.documentElement;
      const out = curve("--ease-out", "0.23, 1, 0.32, 1");
      const leave = curve("--ease-leave", "0.5, 0, 0.75, 0");
      const view = wrap.querySelector<HTMLAnchorElement>(".directors-home_view");

      /* The whole page takes the active director's colour (Sam, Nov 12: « c'est la page au complet qui devrait
         changer de couleur ... même le background du footer »): the page's theme turns to theirs, and so does every
         part that paints its own ground (`data-paint`, its own theme as the value: Home's opening, the reel and
         « Other Directors » on a director's page, the footer), back to their own when no name is active. Each keeps
         its own theme in the markup, read from there, never from what a script left on the page. Grounds, text and
         the curves' fills change together (CSS: --paint-duration on the travel curve): base to or from the page's own
         ground (Sam: the change to the black was too quick), medium between two directors. */
      const pageThemes = (root.dataset.pageTheme ?? "").split(" ").filter(Boolean);
      const painted = [...document.querySelectorAll<HTMLElement>("[data-paint]")].map((el) => ({
        el,
        own: (el.dataset.paint ?? "").split(" ").filter(Boolean),
      }));
      let paintedAs: string | null = null;
      root.dataset.paints = "";
      const paint = (colour: string | null, instant = false) => {
        const theme = colour ? (THEMES[colour] ?? "theme-brand") : null;
        if (theme === paintedAs) return;
        const duration = instant
          ? 0
          : reduce.matches
            ? seconds("--duration-faster")
            : seconds(theme && paintedAs ? "--duration-medium" : "--duration-base");
        paintedAs = theme;
        root.style.setProperty("--paint-duration", `${duration}s`);
        root.classList.remove(...ALL, ...pageThemes);
        root.classList.add(...(theme ? [theme] : pageThemes));
        painted.forEach(({ el, own }) => {
          el.classList.remove(...ALL, ...own);
          el.classList.add(...(theme ? [theme] : own));
        });
      };

      /* The balls (job: show the active director's films, playfully). Only the active director's are out, two to
         four on the screen at once, spread as the Figma spreads them; each rises with the scroll faster than the names
         (its pace), a little behind it (a quick catch-up gives it weight), so they travel from the foot of the screen
         to its top as the names go by. A director's balls grow in when their name becomes active (base, ease-out, 80
         ms apart) and shrink away when it gives way (medium, the leave curve), still rising. They move only with the
         scroll: at rest, they rest. None with reduced motion. */
      type Ball = { el: HTMLElement; img: HTMLImageElement | null; item: HTMLElement; x: number; y: number; pace: number; s: number; at: number | null };
      const balls: Ball[] = [];
      items.forEach((item, k) => {
        const layout = LAYOUTS[k % LAYOUTS.length];
        const mirror = Math.floor(k / LAYOUTS.length) % 2 === 1;
        wrap.querySelectorAll<HTMLElement>(`.directors-home_ball[data-for="${item.dataset.opItem}"]`).forEach((el, i) => {
          const [x, y, pace] = layout[i % layout.length];
          balls.push({ el, img: el.querySelector("img"), item, x: mirror ? 1 - x : x, y, pace, s: 0, at: null });
        });
      });
      const load = (item: HTMLElement | undefined) =>
        balls.forEach((b) => {
          if (b.item === item && b.img && !b.img.getAttribute("src") && b.img.dataset.src) b.img.src = b.img.dataset.src;
        });
      let size = 0;
      const measure = () => {
        size = balls[0]?.el.offsetWidth ?? 0;
      };
      const draw = () => {
        const middle = innerHeight / 2;
        const rows = new Map<HTMLElement, number>();
        // reads first: the rows of the directors whose balls are out
        balls.forEach((b) => {
          if (b.s > 0.001 && !rows.has(b.item)) {
            const box = b.item.getBoundingClientRect();
            rows.set(b.item, box.top + box.height / 2 - middle);
          }
        });
        const k = 1 - Math.exp(-gsap.ticker.deltaRatio() / 6);
        balls.forEach((b) => {
          if (b.s <= 0.001) {
            b.at = null;
            if (b.el.style.visibility !== "hidden") b.el.style.visibility = "hidden";
            return;
          }
          const target = innerHeight * b.y + (rows.get(b.item) ?? 0) * b.pace;
          b.at = b.at === null ? target : b.at + (target - b.at) * k;
          const r = size / 2;
          b.el.style.visibility = "visible";
          b.el.style.transform = `translate3d(${(innerWidth * b.x - r).toFixed(1)}px, ${(b.at - r).toFixed(1)}px, 0) scale(${b.s.toFixed(3)})`;
        });
      };
      let running = false;
      const start = () => {
        if (running || reduce.matches || !balls.length) return;
        running = true;
        measure();
        gsap.ticker.add(draw);
      };
      const stop = () => {
        if (!running) return;
        running = false;
        gsap.ticker.remove(draw);
      };
      let idle = 0;
      const show = (item: HTMLElement | null) => {
        if (reduce.matches) return;
        let i = 0;
        balls.forEach((b) => {
          const on = b.item === item;
          if (!on && b.s === 0) return;
          gsap.to(b, on
            ? { s: 1, duration: seconds("--duration-base"), ease: out, delay: i++ * 0.08, overwrite: true }
            : { s: 0, duration: seconds("--duration-medium"), ease: leave, overwrite: true });
        });
        if (item) {
          // its films, and the neighbours' ahead of their turn
          const k = items.indexOf(item);
          [k, k + 1, k - 1].forEach((n) => load(items[n]));
          clearTimeout(idle);
          start();
        } else {
          clearTimeout(idle);
          idle = window.setTimeout(stop, seconds("--duration-medium") * 1000 + 100);
        }
      };

      /* « View director » (job: the way into the active director, never lost from sight): one for the whole list, at
         its far right, level with the active name. When the next name takes over it travels there (base, ease-out,
         taken up again from where it is when the scroll is quick) rather than leaving and coming back (Sam, Nov 12:
         « voyage de director en director ... au lieu de disparaitre puis réapparaitre »); it fades in on the first
         name and out after the last. With reduced motion it moves at once. */
      let viewShown = false;
      if (view) gsap.set(view, { yPercent: -50, autoAlpha: 0 });
      const place = (item: HTMLElement | null) => {
        if (!view) return;
        if (!item) {
          if (viewShown) gsap.to(view, { autoAlpha: 0, duration: seconds("--duration-medium"), ease: out, overwrite: "auto" });
          viewShown = false;
          return;
        }
        const y = item.offsetTop + item.offsetHeight / 2;
        view.href = item.querySelector<HTMLAnchorElement>(".directors-home_name")?.href ?? view.href;
        if (!viewShown || reduce.matches) {
          gsap.killTweensOf(view, "y");
          gsap.set(view, { y });
          gsap.to(view, { autoAlpha: 1, duration: seconds(reduce.matches ? "--duration-faster" : "--duration-medium"), ease: out, overwrite: "auto" });
        } else {
          gsap.to(view, { y, autoAlpha: 1, duration: seconds("--duration-base"), ease: out, overwrite: "auto" });
        }
        viewShown = true;
      };

      /* The active name (job: show whose colour and films these are): the one under the middle of the screen; the
         first is caught a quarter of a screen early (as its top reaches 75 % down) and the last kept a tenth late
         (until its foot rises to 40 %; Sam, Nov 12: « switch au noir un peu plus tôt pour le dernier »), so neither
         flicks by */
      let active: HTMLElement | null = null;
      const setActive = (item: HTMLElement | null, instant = false) => {
        if (item === active) return;
        active = item;
        items.forEach((i) => i.classList.toggle("is-active", i === item));
        wrap.classList.toggle("is-coloured", !!item);
        paint(item ? (item.dataset.colour ?? "red") : null, instant);
        show(item);
        place(item);
      };
      const check = (instant = false) => {
        const middle = innerHeight / 2;
        const shown = items.filter((i) => !i.hidden);
        let found: HTMLElement | null = null;
        shown.forEach((item, k) => {
          if (found) return;
          const box = item.getBoundingClientRect();
          const from = k === 0 ? middle + innerHeight * 0.25 : middle;
          const until = k === shown.length - 1 ? middle - innerHeight * 0.1 : middle;
          if (box.top <= from && box.bottom > until) found = item;
        });
        setActive(found, instant);
      };

      /* Filters: Industry and Location keep the names that match; « All » shows everyone */
      const chosen: Record<string, string> = { industry: "", location: "" };
      const apply = () => {
        let shown = 0;
        items.forEach((item) => {
          const industries = (item.dataset.industry ?? "").split("|").filter(Boolean);
          const ok =
            (!chosen.industry || industries.includes(chosen.industry)) &&
            (!chosen.location || item.dataset.location === chosen.location);
          item.hidden = !ok;
          if (ok) shown++;
        });
        if (empty) empty.hidden = shown > 0;
        check();
        // the names moved: it follows the active one to its new line
        place(active);
      };
      wrap.addEventListener(
        "click",
        (event) => {
          const button = (event.target as HTMLElement).closest<HTMLButtonElement>(".directors-home_option");
          if (!button) return;
          const key = button.dataset.filter ?? "";
          chosen[key] = button.dataset.value ?? "";
          wrap.querySelectorAll<HTMLButtonElement>(`.directors-home_option[data-filter="${key}"]`).forEach((b) => {
            b.setAttribute("aria-pressed", String(b === button));
          });
          apply();
        },
        { signal },
      );

      // the page as it opens: its colour at once (a page change's veil still covers it)
      check(true);
      let frame = 0;
      const onScroll = () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => check());
      };
      window.addEventListener("scroll", onScroll, { passive: true, signal });
      window.addEventListener(
        "resize",
        () => {
          measure();
          check();
          if (view && active) gsap.set(view, { y: active.offsetTop + active.offsetHeight / 2 });
        },
        { signal },
      );
      reduce.addEventListener(
        "change",
        () => {
          if (reduce.matches) {
            stop();
            balls.forEach((b) => {
              gsap.killTweensOf(b);
              b.s = 0;
              b.el.style.visibility = "hidden";
            });
          } else show(active);
        },
        { signal },
      );
      // leaving the page: the next page brings its own theme with it, nothing to put back
      signal.addEventListener(
        "abort",
        () => {
          stop();
          clearTimeout(idle);
          cancelAnimationFrame(frame);
          balls.forEach((b) => gsap.killTweensOf(b));
          if (view) gsap.killTweensOf(view);
        },
        { once: true },
      );
    });
  });
</script>

<style is:global>
  @layer components {
    /* On Home, above the curve that follows it, with no ground of its own: the page's ground shows through, dark, or
       the active director's colour (the page's theme turns to it, src: the script; the change: project.css) */
    .directors-home_wrap {
      position: relative;
      z-index: 1;
      isolation: isolate;
      padding-top: var(--space-6);
      padding-bottom: var(--space-9);
    }
    /* On a director's page it paints its own dark over the reel's end, and the list ends 144 above the footer's rule
       (keyed on .is-dark, which stays: its theme changes with the page's colour) */
    .directors-home_wrap.is-dark {
      padding-top: var(--section-space-small);
      padding-bottom: var(--section-space-medium);
    }
    .directors-home_wrap.is-page {
      padding-top: var(--page-top);
      padding-bottom: var(--section-space-medium);
    }
    .directors-home_layout {
      row-gap: var(--section-space-large);
    }
    .directors-home_row {
      grid-column: margin / end;
      display: grid;
      grid-template-columns: subgrid;
      row-gap: var(--space-7);
      align-items: start;
    }
    .directors-home_label {
      grid-column: margin / end;
      @media (width >= 48rem) {
        grid-column: margin / half;
      }
    }
    .directors-home_filter {
      display: flex;
      flex-direction: column;
      gap: var(--space-6);
      &.is-industry {
        grid-column: margin / span 2;
        @media (width >= 48rem) {
          grid-column: half / span 2;
        }
      }
      &.is-location {
        grid-column: three / end;
        @media (width >= 48rem) {
          grid-column: aside / end;
        }
      }
    }
    .directors-home_option {
      color: var(--text-2);
      transition: color var(--hover-duration) var(--hover-ease);
      &[aria-pressed="true"] {
        color: var(--text);
      }
      @media (hover: hover) {
        &:hover {
          color: var(--text);
        }
      }
    }
    .directors-home_names,
    .directors-home_empty {
      grid-column: margin / end;
    }
    .directors-home_names {
      position: relative;
    }
    .directors-home_list {
      color: var(--heading-accent);
      /* on a phone the names grow to 72 px and over (80 at most), each on two lines (Sam, Nov 12: « noms plus gros,
         sur 2 lignes »), meeting the tablet's size at 768 */
      @media (width < 48rem) {
        font-size: clamp(4.5rem, 18.5vw, 5rem);
      }
    }
    /* Under the balls but the active one, which stays above them (the Figma's hover frames) */
    .directors-home_item {
      position: relative;
      z-index: 1;
      .is-coloured & {
        color: var(--text-3);
      }
      &.is-active {
        z-index: 3;
        color: var(--text);
      }
    }
    /* The row is the link, across the whole width. A name not active answers a hover quietly, from 30 % to 40 %
       (Sam, Nov 12: « hover plus subtil », then « réduire encore plus ») */
    .directors-home_name {
      display: flex;
      color: inherit;
      transition: color var(--duration-medium) var(--ease-out);
      @media (hover: hover) {
        &:hover {
          color: var(--text);
          .is-coloured .directors-home_item:not(.is-active) & {
            color: color-mix(in srgb, var(--text) var(--tone-hover), transparent);
          }
        }
      }
    }
    /* « View director »: one for the list, at its far right, level with the active name (src: the script moves it
       and fades it); from a tablet up. Its arrow slides on a hover of it or of the active row */
    .directors-home_view {
      position: absolute;
      top: 0;
      right: 0;
      z-index: 3;
      color: var(--text);
      opacity: 0;
      visibility: hidden;
      @media (width < 48rem) {
        display: none;
      }
    }
    @media (hover: hover) {
      .directors-home_view:hover .arrow-link_icon,
      .directors-home_names:has(.is-active .directors-home_name:hover) .directors-home_view .arrow-link_icon {
        translate: 0.25em 0;
      }
    }
    .directors-home_empty {
      color: var(--text-2);
    }
    /* The balls: a layer over the screen, over the other sections (the list's own stacking sits above them); the
       Figma's 238 at 1728 (13.8 % of the width), 128 at the least on a phone */
    .directors-home_balls {
      position: fixed;
      inset: 0;
      z-index: 2;
      overflow: clip;
      pointer-events: none;
      @media (prefers-reduced-motion: reduce) {
        display: none;
      }
    }
    .directors-home_ball {
      position: absolute;
      top: 0;
      left: 0;
      width: max(13.8vw, 8rem);
      aspect-ratio: 1;
      overflow: hidden;
      border-radius: 50%;
      background-color: var(--black);
      visibility: hidden;
      will-change: transform;
    }
    .directors-home_film {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      &:not([src]) {
        visibility: hidden;
      }
    }
  }
</style>
