---
/* The directors: the row « Directors » with its two filters (Industry at column 7, Location at column 10, as the
   Figma), then every director's name in the big type, one per line, each a link to their page. A filter keeps the
   names that match it; « All » shows everyone. The directors come from the collection « Directors ».
   The name that crosses the middle of the screen is the active one (Sam, Nov 11: « les noms seraient actifs au milieu
   de l'écran et non pas au over »): the section takes that director's colour (the same as their page), the active
   name turns black, the others black at 30 %, and balls carrying their films rise through the screen. Home shows it on
   the page's dark; a director's page shows it as « Other Directors » (without them) on its own dark. */
import { getImage } from "astro:assets";
import { getItems, LIVE } from "@/utils/content.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The row's label. */
  label?: string;
  /** A director left out (their own page). */
  exclude?: string;
  /** On a page of another colour: the section paints the dark itself. */
  dark?: boolean;
  /** `h1` when the list is the page (the directors' own page): it then starts a page's height down. */
  as?: "h1" | "h2";
}

const { render = true, label = "Directors", exclude, dark = false, as: Heading = "h2" } = Astro.props;
const directors = (await getItems("directors")).filter((d) => d.id !== exclude);
const projects = await getItems("projects");
/* Each director's film stills, as small pictures for the balls (480 wide, twice a ball's size on a computer); on the
   live staging, whose images pass through untouched, the build's own file (an optimized URL would not resolve there) */
const stills = Object.fromEntries(
  await Promise.all(
    directors.map(async (d) => {
      const own = projects.filter((p) => p.data.director?.id === d.id && p.data.still);
      const urls = await Promise.all(
        own.map(async (p) => {
          const pic = p.data.still!;
          if (!("format" in pic)) return pic.src;
          return LIVE ? pic.src : (await getImage({ src: pic, width: 480, format: "webp" })).src;
        }),
      );
      return [d.id, urls] as const;
    }),
  ),
);
const BALLS = 7;
const industries = ["Docustyle", "Comedy", "Story", "Spectacle", "Fashion"];
const locations = ["Chicago", "Los Angeles", "New Orleans", "New York"];
const filters = [
  { key: "industry", label: "Industry", options: industries, class: "is-industry" },
  { key: "location", label: "Location", options: locations, class: "is-location" },
];
---

{
  render && (
    <section class:list={["directors-home_wrap", dark && "theme-dark", Heading === "h1" && "is-page"]} data-op-section="DirectorsHome">
      <div class="directors-home_layout site-grid">
        <div class="directors-home_row rule-top">
          <Heading class="directors-home_label dot-label text-style-large" data-page-reveal={Heading === "h1" ? "" : undefined}>
            {label}
          </Heading>
          {filters.map((f) => (
            <div class:list={["directors-home_filter", f.class]} role="group" aria-label={`Filter by ${f.label.toLowerCase()}`}>
              <p class="text-style-main">{f.label}</p>
              <ul class="directors-home_options text-style-main">
                {["All", ...f.options].map((o) => (
                  <li>
                    <button
                      class="directors-home_option"
                      type="button"
                      data-filter={f.key}
                      data-value={o === "All" ? "" : o}
                      aria-pressed={o === "All" ? "true" : "false"}
                    >
                      {o}
                    </button>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <ul class="directors-home_list text-style-h1" data-op-list="directors" data-op-source="astro:directors">
          {directors.map((d) => (
            <li
              class="directors-home_item"
              data-op-item={d.id}
              data-industry={(d.data.industries ?? []).join("|")}
              data-location={d.data.location ?? ""}
              data-colour={d.data.colour ?? "red"}
              data-stills={JSON.stringify(stills[d.id] ?? [])}
            >
              <a class="directors-home_name" href={`/directors/${d.id}`} data-op-field="name">
                {d.data.name}
              </a>
            </li>
          ))}
        </ul>
        <p class="directors-home_empty text-style-main" hidden>
          No director here yet.
        </p>
      </div>
      <div class="directors-home_balls" aria-hidden="true">
        {Array.from({ length: BALLS }, () => (
          <span class="directors-home_ball">
            <img class="directors-home_film" alt="" decoding="async" />
            <img class="directors-home_film" alt="" decoding="async" />
          </span>
        ))}
      </div>
    </section>
  )
}

<script>
  import { gsap } from "gsap";
  import { onPage } from "@/utils/page.ts";

  /* The balls, after Sam (Nov 12: « scale up apparaître, down disparaître en haut, plus smooth, mieux réfléchi »).
     Each is born low in the list, grows to its size (ease-out), rises, and near the top shrinks to nothing (ease-in)
     before being born again low down with another film: it never meets an edge, of the screen or of a section. The
     scroll carries them up, the near (big) ones faster than the far (small) ones, a parallax; their speed follows the
     scroll's own, smoothed, so they ease in and out of motion; after a scroll they keep drifting up a little and
     settle within four seconds of rest (WCAG 2.2.2). Seven lanes across the width, a slight sway while they move. */
  const LANES = [0.12, 0.72, 0.42, 0.9, 0.27, 0.58, 0.05];
  const DEPTH = [1.15, 0.82, 1, 0.75, 1.25, 0.9, 1.05];
  const THEMES: Record<string, string> = { red: "theme-brand", mustard: "theme-mustard", teal: "theme-teal" };
  const grow = (t: number) => 1 - (1 - Math.min(1, Math.max(0, t))) ** 3;

  onPage((signal) => {
    document.querySelectorAll<HTMLElement>(".directors-home_wrap").forEach((wrap) => {
      const items = [...wrap.querySelectorAll<HTMLElement>(".directors-home_item")];
      const list = wrap.querySelector<HTMLElement>(".directors-home_list");
      const empty = wrap.querySelector<HTMLElement>(".directors-home_empty");
      const layer = wrap.querySelector<HTMLElement>(".directors-home_balls");
      const reduce = matchMedia("(prefers-reduced-motion: reduce)");
      const root = document.documentElement;
      const pageThemes = [...root.classList].filter((c) => c.startsWith("theme-"));
      const ownTheme = [...wrap.classList].filter((c) => c.startsWith("theme-"));

      const balls = [...(layer?.querySelectorAll<HTMLElement>(".directors-home_ball") ?? [])].map((el, i) => ({
        el,
        films: [...el.querySelectorAll<HTMLImageElement>(".directors-home_film")],
        front: 0,
        lane: LANES[i % LANES.length],
        depth: DEPTH[i % DEPTH.length],
        u: i / 7 + 0.04 * (i % 3),
        x: 0,
        from: 0,
        to: 0,
        d: 0,
        film: i,
        room: true,
      }));
      balls.forEach((b) => (b.el.style.zIndex = String(Math.round(b.depth * 10))));
      let base = 0;
      let films: string[] = [];
      const show = (b: (typeof balls)[number], src: string | undefined, fade: boolean) => {
        if (!src) return;
        const next = fade ? 1 - b.front : b.front;
        const img = b.films[next];
        if (img.getAttribute("src") !== src) img.src = src;
        img.style.opacity = "1";
        if (fade) b.films[b.front].style.opacity = "0";
        b.front = next;
      };
      /* a life's path, on the screen: born just above the list's foot (or the screen's), dying just under its top */
      const path = (b: (typeof balls)[number]) => {
        const box = (list ?? wrap).getBoundingClientRect();
        const r = b.d / 2;
        b.from = Math.min(innerHeight * 0.9, box.bottom) - r;
        b.to = Math.max(innerHeight * 0.1, box.top) + r;
        b.room = b.from - b.to > b.d;
        const jitter = (((b.film * 37) % 9) - 4) / 100;
        b.x = Math.min(0.94, Math.max(0.06, b.lane + jitter)) * innerWidth - r;
      };
      const measure = () => {
        base = innerWidth >= 768 ? innerWidth * 0.138 : innerWidth * 0.26;
        balls.forEach((b) => {
          b.d = base * b.depth;
          b.el.style.width = `${b.d}px`;
          b.el.style.height = `${b.d}px`;
          path(b);
        });
      };

      let last = window.scrollY;
      let speed = 0;
      let calm = 0;
      let clock = 0;
      let running = false;
      const tick = (_time: number, deltaMs: number) => {
        const dt = Math.min(deltaMs, 50) / 1000;
        if (!dt) return;
        clock += dt;
        const scroll = window.scrollY;
        const target = (scroll - last) / dt;
        last = scroll;
        calm = target === 0 ? calm + dt : 0;
        // the scroll's speed, smoothed (a quarter second), so the balls ease in and out of it
        speed += (target - speed) * (1 - Math.exp(-dt / 0.25));
        const alive = Math.max(0, 1 - calm / 4);
        balls.forEach((b, i) => {
          const length = Math.max(1, b.from - b.to);
          const rise = speed * (0.55 + b.depth * 0.55) + 26 * b.depth * alive;
          b.u += (rise * dt) / length;
          if (b.u >= 1 || b.u < 0) {
            b.u -= Math.floor(b.u);
            b.film += balls.length;
            path(b);
            show(b, films[b.film % Math.max(1, films.length)], false);
          }
          // grows over the first quarter of its life (ease-out), shrinks to nothing over the last (ease-in)
          const shrink = b.u > 0.72 ? 1 - ((b.u - 0.72) / 0.28) ** 3 : 1;
          const size = b.room ? grow(b.u / 0.25) * shrink : 0;
          const y = b.from - b.u * length - b.d / 2;
          const sway = Math.sin(clock * (0.55 + i * 0.07) + i * 1.7) * 8 * alive;
          b.el.style.transform = `translate3d(${(b.x + sway).toFixed(1)}px, ${y.toFixed(1)}px, 0) scale(${Math.max(0, size).toFixed(3)})`;
          b.el.style.opacity = size > 0.02 ? "1" : "0";
        });
      };
      const start = () => {
        if (running || reduce.matches || !layer) return;
        running = true;
        last = window.scrollY;
        speed = 0;
        measure();
        gsap.ticker.add(tick);
      };
      const stop = () => {
        if (!running) return;
        running = false;
        gsap.ticker.remove(tick);
      };

      /* The whole page takes the active director's colour (Sam, Nov 12: « sur toute la page »): the page's theme turns
         to theirs (and a section that paints its own dark, on a director's page, with it), back to its own when no
         name is in the middle. Colours and text change over the fast duration (CSS). */
      const paint = (colour: string | null) => {
        const theme = colour ? (THEMES[colour] ?? "theme-brand") : null;
        root.classList.remove(...Object.values(THEMES), ...pageThemes);
        root.classList.add(...(theme ? [theme] : pageThemes));
        if (ownTheme.length) {
          wrap.classList.remove(...Object.values(THEMES), ...ownTheme);
          wrap.classList.add(...(theme ? [theme] : ownTheme));
        }
      };

      /* The active name: the one under the middle of the screen (job: show whose colour and films these are) */
      let active: HTMLElement | null = null;
      let fadeOut = 0;
      const setActive = (item: HTMLElement | null) => {
        if (item === active) return;
        const first = !active;
        active = item;
        items.forEach((i) => i.classList.toggle("is-active", i === item));
        wrap.classList.toggle("is-coloured", !!item);
        paint(item ? (item.dataset.colour ?? "red") : null);
        clearTimeout(fadeOut);
        if (!item || !layer) {
          // the balls stop once their layer has faded out
          fadeOut = window.setTimeout(stop, 600);
          return;
        }
        films = JSON.parse(item.dataset.stills ?? "[]") as string[];
        balls.forEach((b, i) => {
          b.film = i;
          show(b, films[i % Math.max(1, films.length)], !first);
        });
        start();
      };
      const check = () => {
        const middle = innerHeight / 2;
        let found: HTMLElement | null = null;
        for (const item of items) {
          if (item.hidden) continue;
          const box = item.getBoundingClientRect();
          if (box.top <= middle && box.bottom > middle) {
            found = item;
            break;
          }
        }
        setActive(found);
      };

      /* Filters: Industry and Location keep the names that match; « All » shows everyone */
      const chosen: Record<string, string> = { industry: "", location: "" };
      const apply = () => {
        let shown = 0;
        items.forEach((item) => {
          const industries = (item.dataset.industry ?? "").split("|").filter(Boolean);
          const ok =
            (!chosen.industry || industries.includes(chosen.industry)) &&
            (!chosen.location || item.dataset.location === chosen.location);
          item.hidden = !ok;
          if (ok) shown++;
        });
        if (empty) empty.hidden = shown > 0;
        check();
      };
      wrap.addEventListener(
        "click",
        (event) => {
          const button = (event.target as HTMLElement).closest<HTMLButtonElement>(".directors-home_option");
          if (!button) return;
          const key = button.dataset.filter ?? "";
          chosen[key] = button.dataset.value ?? "";
          wrap.querySelectorAll<HTMLButtonElement>(`.directors-home_option[data-filter="${key}"]`).forEach((b) => {
            b.setAttribute("aria-pressed", String(b === button));
          });
          apply();
        },
        { signal },
      );

      measure();
      check();
      let frame = 0;
      const onScroll = () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(check);
      };
      window.addEventListener("scroll", onScroll, { passive: true, signal });
      window.addEventListener(
        "resize",
        () => {
          measure();
          check();
        },
        { signal },
      );
      reduce.addEventListener("change", () => (reduce.matches ? stop() : active && start()), { signal });
      // leaving the page: the next page brings its own theme with it, nothing to put back
      signal.addEventListener(
        "abort",
        () => {
          stop();
          clearTimeout(fadeOut);
          cancelAnimationFrame(frame);
        },
        { once: true },
      );
    });
  });
</script>

<style is:global>
  @layer components {
    /* On Home, above the curve that follows it, with no ground of its own: the page's ground shows through, dark, or
       the active director's colour (the page's theme turns to it, src: the script) */
    .directors-home_wrap {
      position: relative;
      z-index: 1;
      isolation: isolate;
      padding-top: var(--space-6);
      padding-bottom: var(--space-9);
      transition:
        background-color var(--duration-fast) var(--ease-out),
        color var(--duration-fast) var(--ease-out);
      @media (prefers-reduced-motion: reduce) {
        transition-duration: var(--duration-faster);
      }
    }
    /* the page's ground turning to a director's colour and back: quick (fast), so a quick scroll through the names
       never lingers on the mix of two colours */
    :root:has(.directors-home_wrap) {
      transition:
        background-color var(--duration-fast) var(--ease-out),
        color var(--duration-fast) var(--ease-out);
      @media (prefers-reduced-motion: reduce) {
        transition-duration: var(--duration-faster);
      }
    }
    /* On a director's page it follows the reel's dark, and the list ends 144 above the footer's rule */
    .directors-home_wrap.theme-dark {
      padding-top: var(--section-space-small);
      padding-bottom: var(--section-space-medium);
    }
    .directors-home_wrap.is-page {
      padding-top: var(--page-top);
      padding-bottom: var(--section-space-medium);
    }
    .directors-home_layout {
      row-gap: var(--section-space-large);
    }
    .directors-home_row {
      grid-column: margin / end;
      display: grid;
      grid-template-columns: subgrid;
      row-gap: var(--space-7);
      align-items: start;
    }
    .directors-home_label {
      grid-column: margin / end;
      @media (width >= 48rem) {
        grid-column: margin / half;
      }
    }
    .directors-home_filter {
      display: flex;
      flex-direction: column;
      gap: var(--space-6);
      &.is-industry {
        grid-column: margin / span 2;
        @media (width >= 48rem) {
          grid-column: half / span 2;
        }
      }
      &.is-location {
        grid-column: three / end;
        @media (width >= 48rem) {
          grid-column: aside / end;
        }
      }
    }
    .directors-home_option {
      color: var(--text-2);
      transition: color var(--hover-duration) var(--hover-ease);
      &[aria-pressed="true"] {
        color: var(--text);
      }
      @media (hover: hover) {
        &:hover {
          color: var(--text);
        }
      }
    }
    .directors-home_list,
    .directors-home_empty {
      grid-column: margin / end;
    }
    .directors-home_list {
      color: var(--heading-accent);
      /* on a phone the names grow to 72 px and over (80 at most), each on two lines (Sam, Nov 12: « noms plus gros,
         sur 2 lignes »), meeting the tablet's size at 768 */
      @media (width < 48rem) {
        font-size: clamp(4.5rem, 18.5vw, 5rem);
      }
    }
    /* Under the balls but the active one, which stays above them (the Figma's hover frames) */
    .directors-home_item {
      position: relative;
      z-index: 1;
      .is-coloured & {
        color: var(--text-3);
      }
      &.is-active {
        z-index: 3;
        color: var(--text);
      }
    }
    .directors-home_name {
      color: inherit;
      transition: color var(--duration-fast) var(--ease-out);
      @media (hover: hover) {
        &:hover {
          color: var(--text);
        }
      }
    }
    .directors-home_empty {
      color: var(--text-2);
    }
    /* The balls: a layer over the screen while a name is active, fading in and out with the colour */
    .directors-home_balls {
      position: fixed;
      inset: 0;
      z-index: 2;
      overflow: clip;
      pointer-events: none;
      opacity: 0;
      transition: opacity var(--duration-medium) var(--ease-out);
      .is-coloured & {
        opacity: 1;
      }
      @media (prefers-reduced-motion: reduce) {
        display: none;
      }
    }
    .directors-home_ball {
      position: absolute;
      top: 0;
      left: 0;
      overflow: hidden;
      border-radius: var(--radius-round);
      background-color: var(--black);
      will-change: transform;
    }
    .directors-home_film {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0;
      transition: opacity var(--duration-fast) var(--ease-out);
      &:not([src]) {
        visibility: hidden;
      }
    }
  }
</style>
