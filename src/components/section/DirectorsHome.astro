---
/* The directors: the row « Directors » with its two filters (Industry at column 7, Location at column 10, as the
   Figma), then every director's name in the big type, one per line, each a link to their page. A filter keeps the
   names that match it; « All » shows everyone. The directors come from the collection « Directors ».
   The name that crosses the middle of the screen is the active one (Sam, Nov 11: « les noms seraient actifs au milieu
   de l'écran et non pas au over »; Nov 12: the first caught earlier, the last kept later): the whole page takes that
   director's colour (the same as their page), the active name turns black, the others black at 30 %, « View
   director » stands at the row's far right (Sam, Nov 12) and travels from name to name as they take their turn, and
   that director's own balls, carrying their films, rise through the screen. Each row is one link, and « View
   director » links to the active one. Home shows it on the page's dark; a
   director's page shows it as « Other Directors » (without them) on its own dark.
   On Home (`featured`), « Featured work » stands beside « Directors » (Sam, Nov 27, comment 49): a switch, its dot
   outlined until it is chosen; chosen, the names give way to the featured films (the films marked « Featured work »,
   the list « home-featured-work » of src/data/lists.json) shown as a director's reel (Sam, Nov 27: « comme la liste
   des films full screen dans la page des directors »), and the filters, which are the directors', step aside. */
import { getImage } from "astro:assets";
import ArrowLink from "@/components/content/ArrowLink.astro";
import { getItems, LIVE } from "@/utils/content.ts";
import { listed, ruleMarks } from "@/utils/lists.ts";
import DirectorReel from "@/components/section/DirectorReel.astro";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The row's label. */
  label?: string;
  /** A director left out (their own page). */
  exclude?: string;
  /** On a page of another colour: the section paints the dark itself. */
  dark?: boolean;
  /** `h1` when the list is the page (the directors' own page): it then starts a page's height down. */
  as?: "h1" | "h2";
  /** Home: the switch to the featured work beside the label. */
  featured?: boolean;
}

const { render = true, label = "Directors", exclude, dark = false, as: Heading = "h2", featured = false } = Astro.props;
const directors = (await getItems("directors")).filter((d) => d.id !== exclude);
const projects = await getItems("projects");
/* Each director's films for the balls: a small still (480 wide, twice a ball's size on a computer; on the live
   staging, whose images pass through untouched, the build's own file: an optimized URL would not resolve there) and
   the film's short loop, which plays over it */
const stills = Object.fromEntries(
  await Promise.all(
    directors.map(async (d) => {
      const own = projects.filter((p) => p.data.director?.id === d.id && p.data.still);
      const urls = await Promise.all(
        own.map(async (p) => {
          const pic = p.data.still!;
          const loop = p.data.loop;
          if (!("format" in pic)) return { id: p.id, src: pic.src, loop };
          return { id: p.id, src: LIVE ? pic.src : (await getImage({ src: pic, width: 480, format: "webp" })).src, loop };
        }),
      );
      return [d.id, urls] as const;
    }),
  ),
);
/* Home's featured work: the films marked « Featured work » (the list « home-featured-work »), shown as a director's reel */
const works = featured ? await listed<"projects">("home-featured-work") : [];
const industries = ["Docustyle", "Comedy", "Story", "Spectacle", "Fashion"];
const locations = ["Chicago", "Los Angeles", "New Orleans", "New York"];
const filters = [
  { key: "industry", label: "Industry", options: industries, class: "is-industry" },
  { key: "location", label: "Location", options: locations, class: "is-location" },
];
---

{
  render && (
    <section
      class:list={["directors-home_wrap", dark && "theme-dark is-dark", Heading === "h1" && "is-page"]}
      data-paint={dark ? "theme-dark" : undefined}
      data-op-section="DirectorsHome"
    >
      <div class="directors-home_layout site-grid">
        <div class="directors-home_row rule-top">
          {featured ? (
            <div class="directors-home_switch" role="group" aria-label="Show">
              <Heading class="directors-home_label text-style-large">
                <button class="directors-home_mode dot-label text-style-large" type="button" data-mode="director" aria-pressed="true">
                  {label}
                </button>
              </Heading>
              <button class="directors-home_mode dot-label text-style-large" type="button" data-mode="work" aria-pressed="false">
                Featured work
              </button>
            </div>
          ) : (
            <Heading class="directors-home_label dot-label text-style-large" data-page-reveal={Heading === "h1" ? "" : undefined}>
              {label}
            </Heading>
          )}
          {filters.map((f) => (
            <div class:list={["directors-home_filter", f.class]} role="group" aria-label={`Filter by ${f.label.toLowerCase()}`}>
              <p class="text-style-main">{f.label}</p>
              <ul class="directors-home_options text-style-main">
                {["All", ...f.options].map((o) => (
                  <li>
                    <button
                      class="directors-home_option"
                      type="button"
                      data-filter={f.key}
                      data-value={o === "All" ? "" : o}
                      aria-pressed={o === "All" ? "true" : "false"}
                    >
                      {o}
                    </button>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <div class="directors-home_names">
        <ul class="directors-home_list text-style-h1" data-op-list="directors" data-op-source="astro:directors">
          {directors.map((d) => (
            <li
              class="directors-home_item"
              data-op-item={d.id}
              data-industry={(d.data.industries ?? []).join("|")}
              data-location={d.data.location ?? ""}
              data-colour={d.data.colour ?? "red"}
            >
              <a class="directors-home_name" href={`/directors/${d.id}`}>
                <span data-op-field="name">{d.data.name}</span>
              </a>
            </li>
          ))}
        </ul>
          {/* one for the list, a mouse's shortcut to the active row's own link (keyboards and readers use the row) */}
          <a class="directors-home_view" href={directors[0] ? `/directors/${directors[0].id}` : "/directors"} tabindex="-1" aria-hidden="true">
            <ArrowLink text="View director" />
          </a>
          {/* in the list's own box, so it starts where the first name does */}
          <p class="directors-home_empty directors-home_list text-style-h1 text-transform-none" hidden>
            No director
            <br />
            here yet.
          </p>
        </div>
      </div>
      {featured && works.length > 0 && (
        <div class="directors-home_reel" hidden>
          <DirectorReel projects={works} colour="black" alone marks={ruleMarks("home-featured-work")} />
        </div>
      )}
      <div class="directors-home_balls" aria-hidden="true">
        {directors.map((d) =>
          (stills[d.id] ?? []).slice(0, 3).map(({ src, loop }) => (
            <span class="directors-home_ball" data-for={d.id}>
              <img class="directors-home_film cover-absolute object-fit-cover" alt="" decoding="async" data-src={src} />
              {loop && <video class="directors-home_film cover-absolute object-fit-cover" data-src={loop} muted loop playsinline preload="none" />}
            </span>
          )),
        )}
      </div>
    </section>
  )
}

<script>
  import { gsap } from "gsap";
  import { CustomEase } from "gsap/CustomEase";
  import { onPage } from "@/utils/page.ts";
  import { pageLenis } from "@/utils/smooth-scroll.ts";

  gsap.registerPlugin(CustomEase);
  const THEMES: Record<string, string> = { red: "theme-brand", mustard: "theme-mustard", teal: "theme-teal" };
  const ALL = Object.values(THEMES);
  /* Each director's balls, after the Figma's three hover frames (James, Jasper, Kevin) and Sam (Nov 12: « moins de
     boules, 2, 3 ou 4 par écran, plus scattered ... chaque director a ses propres boules qui scroll de bas en haut »):
     [x, y, pace], where the ball's centre is when its director's name is in the middle of the screen (fractions of
     the screen), and how much faster than the names it rises. Directors take the three in turn, mirrored every
     other round, so two neighbours never share a place. */
  const LAYOUTS: [number, number, number][][] = [
    [
      [0.32, 0.16, 1.45],
      [0.77, 0.62, 1.85],
      [0.42, 0.9, 1.6],
    ],
    [
      [0.42, 0.26, 1.5],
      [0.76, 0.74, 1.8],
      [0.18, 0.92, 1.6],
    ],
    [
      [0.52, 0.04, 1.55],
      [0.89, 0.68, 1.85],
      [0.25, 0.82, 1.45],
    ],
  ];
  const css = (name: string) => getComputedStyle(document.documentElement).getPropertyValue(name).trim();
  const seconds = (name: string) => (parseFloat(css(name)) || 0) / (css(name).endsWith("ms") ? 1000 : 1);
  const curve = (name: string, fallback: string) => {
    const m = css(name).match(/cubic-bezier\(([^)]+)\)/);
    return CustomEase.create(`directors${name}`, m ? m[1] : fallback);
  };

  onPage((signal) => {
    document.querySelectorAll<HTMLElement>(".directors-home_wrap").forEach((wrap) => {
      const items = [...wrap.querySelectorAll<HTMLElement>(".directors-home_item")];
      const empty = wrap.querySelector<HTMLElement>(".directors-home_empty");
      const filterRow = wrap.querySelector<HTMLElement>(".directors-home_row");
      const reduce = matchMedia("(prefers-reduced-motion: reduce)");
      const root = document.documentElement;
      const out = curve("--ease-out", "0.23, 1, 0.32, 1");
      const leave = curve("--ease-leave", "0.5, 0, 0.75, 0");
      const view = wrap.querySelector<HTMLAnchorElement>(".directors-home_view");

      /* The whole page takes the active director's colour (Sam, Nov 12: « c'est la page au complet qui devrait
         changer de couleur ... même le background du footer »): the page's theme turns to theirs, and so does every
         part that paints its own ground (`data-paint`, its own theme as the value: Home's opening, the reel and
         « Other Directors » on a director's page, the footer), back to their own when no name is active. Each keeps
         its own theme in the markup, read from there, never from what a script left on the page. Grounds, text and
         the curves' fills change together (CSS: --paint-duration on the travel curve): base to or from the page's own
         ground (Sam: the change to the black was too quick), medium between two directors. */
      const pageThemes = (root.dataset.pageTheme ?? "").split(" ").filter(Boolean);
      const painted = [...document.querySelectorAll<HTMLElement>("[data-paint]")].map((el) => ({
        el,
        own: (el.dataset.paint ?? "").split(" ").filter(Boolean),
      }));
      let paintedAs: string | null = null;
      let painting = 0;
      root.dataset.paints = "";
      const paint = (colour: string | null, instant = false) => {
        const theme = colour ? (THEMES[colour] ?? "theme-brand") : null;
        if (theme === paintedAs) return;
        const duration = instant
          ? 0
          : reduce.matches
            ? seconds("--duration-faster")
            : // quicker since Nov 17 (Sam: « plus snappy »): medium to or from the page's own ground (it was base), fast
              // between two directors (it was medium)
              seconds(theme && paintedAs ? "--duration-fast" : "--duration-medium");
        paintedAs = theme;
        root.style.setProperty("--paint-duration", `${duration}s`);
        // while it turns, the links' own colour transitions take the page's timing (project.css, data-painting)
        clearTimeout(painting);
        if (duration) {
          root.dataset.painting = "";
          // kept a little past the end, so no part takes its own (hover) timing back for the change's last frames
          painting = window.setTimeout(() => delete root.dataset.painting, duration * 1000 + 200);
        } else delete root.dataset.painting;
        root.classList.remove(...ALL, ...pageThemes);
        root.classList.add(...(theme ? [theme] : pageThemes));
        painted.forEach(({ el, own }) => {
          el.classList.remove(...ALL, ...own);
          el.classList.add(...(theme ? [theme] : own));
        });
      };

      /* The balls (job: show the active director's films, playfully). Only the active director's are out, two to
         four on the screen at once, spread as the Figma spreads them; each rises with the scroll faster than the names
         (its pace), a little behind it (a quick catch-up gives it weight), so they travel from the foot of the screen
         to its top as the names go by. A director's balls grow in when their name becomes active (base, ease-out, 80
         ms apart, see show) and shrink away when it gives way (fast, the leave curve), still rising. They move only with the
         scroll: at rest, they rest. None with reduced motion. Each plays its film's short loop over its still while
         it is out (Sam, Nov 17: « faire jouer des petits thumbnails, des vidéos »); the loops of the first names load
         as the list nears the screen, a neighbour's ahead of its turn. */
      type Ball = { el: HTMLElement; img: HTMLImageElement | null; video: HTMLVideoElement | null; item: HTMLElement; x: number; y: number; pace: number; s: number; at: number | null; hold?: boolean; leaving?: boolean };
      const balls: Ball[] = [];
      items.forEach((item, k) => {
        const layout = LAYOUTS[k % LAYOUTS.length];
        const mirror = Math.floor(k / LAYOUTS.length) % 2 === 1;
        wrap.querySelectorAll<HTMLElement>(`.directors-home_ball[data-for="${item.dataset.opItem}"]`).forEach((el, i) => {
          const [x, y, pace] = layout[i % layout.length];
          balls.push({ el, img: el.querySelector("img"), video: el.querySelector("video"), item, x: mirror ? 1 - x : x, y, pace, s: 0, at: null });
        });
      });
      const load = (item: HTMLElement | undefined) =>
        balls.forEach((b) => {
          if (b.item !== item) return;
          if (b.img && !b.img.getAttribute("src") && b.img.dataset.src) b.img.src = b.img.dataset.src;
          if (b.video && !b.video.getAttribute("src") && b.video.dataset.src) {
            b.video.preload = "auto";
            b.video.src = b.video.dataset.src;
          }
        });
      /* Where the names and the filters' row are on the page is read once (when the balls start, when the list or the
         window changes), not at every frame: a read of the layout in the middle of a colour change made the browser
         work the whole page's styles out twice a frame (Sam, Nov 17: « c'est peut-être un peu beaucoup pour le
         browser »). The frame only does arithmetic with the scroll's position, then writes transforms. */
      let size = 0;
      let screen = { width: innerWidth, height: innerHeight };
      const centres = new Map<HTMLElement, number>();
      let rowFoot = -Infinity;
      const scrolled = () => pageLenis()?.scroll ?? scrollY;
      const measure = () => {
        size = balls[0]?.el.offsetWidth ?? 0;
        screen = { width: innerWidth, height: innerHeight };
        const y = scrollY;
        centres.clear();
        items.forEach((item) => {
          if (item.hidden) return;
          const box = item.getBoundingClientRect();
          centres.set(item, box.top + box.height / 2 + y);
        });
        rowFoot = filterRow ? filterRow.getBoundingClientRect().bottom + y : -Infinity;
      };
      const draw = () => {
        const y = scrolled();
        const middle = screen.height / 2;
        // the balls never cover the filters (Sam, Nov 17): none rises above the foot of their row
        const floor = rowFoot - y;
        const k = 1 - Math.exp(-gsap.ticker.deltaRatio() / 6);
        balls.forEach((b) => {
          if (b.s <= 0.001) {
            b.at = null;
            b.hold = false;
            b.leaving = false;
            if (b.el.style.visibility !== "hidden") {
              b.el.style.visibility = "hidden";
              b.video?.pause();
            }
            return;
          }
          // a ball going out while the filter changes the list stays where it was: its row is moving or gone
          if (!b.hold || b.at === null) {
            const centre = centres.get(b.item);
            const target = screen.height * b.y + (centre === undefined ? 0 : centre - y - middle) * b.pace;
            b.at = b.at === null ? target : b.at + (target - b.at) * k;
          }
          const r = size / 2;
          b.el.style.visibility = "visible";
          // by its full size, whatever its scale: a ball growing in or out does not slide along the filters
          const top = Math.max(b.at, floor + r);
          b.el.style.transform = `translate3d(${(screen.width * b.x - r).toFixed(1)}px, ${(top - r).toFixed(1)}px, 0) scale(${b.s.toFixed(3)})`;
        });
      };
      // the list's size changes (its fonts arrive, the window turns): its places are read again, once
      const sized = new ResizeObserver(() => running && measure());
      sized.observe(wrap);
      signal.addEventListener("abort", () => sized.disconnect(), { once: true });
      let running = false;
      const start = () => {
        if (running || reduce.matches || !balls.length) return;
        running = true;
        measure();
        gsap.ticker.add(draw);
      };
      const stop = () => {
        if (!running) return;
        running = false;
        gsap.ticker.remove(draw);
      };
      let idle = 0;
      /* the frames stop once every ball is out, drawn out once more: a busy page (a slow phone) can be late with its
         frames, and a stop on the clock alone left balls on the screen, halfway out */
      const rest = () => {
        clearTimeout(idle);
        const wait = () => {
          if (balls.some((b) => b.s > 0.001)) {
            idle = window.setTimeout(wait, 100);
            return;
          }
          draw();
          stop();
        };
        idle = window.setTimeout(wait, seconds("--duration-medium") * 1000 + 100);
      };
      const show = (item: HTMLElement | null) => {
        if (reduce.matches) return;
        let i = 0;
        balls.forEach((b) => {
          const on = b.item === item;
          if (on) b.hold = b.leaving = false;
          // already on its way out since the filter's click: its tween is left alone
          if (!on && b.leaving) return;
          /* not out yet, but perhaps about to be: its growing waits its turn (a delay), and a name passed quickly
             left that wait running, so its balls came in after their director had given way and stayed (Sam, Nov
             18, comment 43: « certains cercles restent actifs »). The wait is cancelled with the rest. */
          if (!on && b.s === 0) {
            gsap.killTweensOf(b);
            return;
          }
          /* One step after the other, so the browser never does it all at once (Sam, Nov 17): the old balls stop
             their films and shrink (fast) while the colour changes; the new ones wait for most of that change
             (the colour's time less 100 ms), then grow in (medium, ease-out, 60 ms apart), each film starting with
             its ball. A name passed quickly never starts its balls at all. */
          if (on) {
            gsap.to(b, {
              s: 1,
              duration: seconds("--duration-medium"),
              ease: out,
              delay: Math.max(0, seconds("--duration-fast") - 0.1) + i++ * 0.06,
              overwrite: true,
              onStart: () => void b.video?.play().catch(() => {}),
            });
          } else {
            b.video?.pause();
            gsap.to(b, { s: 0, duration: seconds("--duration-fast"), ease: leave, overwrite: true });
          }
        });
        if (item) {
          // its films, and the neighbours' ahead of their turn
          const k = items.indexOf(item);
          [k, k + 1, k - 1, k + 2].forEach((n) => load(items[n]));
          clearTimeout(idle);
          start();
        } else {
          rest();
        }
      };

      /* « View director » (job: the way into the active director, never lost from sight): one for the whole list, at
         its far right, level with the active name. When the next name takes over it travels there (base, ease-out,
         taken up again from where it is when the scroll is quick) rather than leaving and coming back (Sam, Nov 12:
         « voyage de director en director ... au lieu de disparaitre puis réapparaitre »); it fades in on the first
         name and out after the last. With reduced motion it moves at once. */
      let viewShown = false;
      if (view) gsap.set(view, { yPercent: -50, autoAlpha: 0 });
      const place = (item: HTMLElement | null) => {
        if (!view) return;
        if (!item) {
          if (viewShown) gsap.to(view, { autoAlpha: 0, duration: seconds("--duration-medium"), ease: out, overwrite: "auto" });
          viewShown = false;
          return;
        }
        const y = item.offsetTop + item.offsetHeight / 2;
        view.href = item.querySelector<HTMLAnchorElement>(".directors-home_name")?.href ?? view.href;
        if (!viewShown || reduce.matches) {
          gsap.killTweensOf(view, "y");
          gsap.set(view, { y });
          gsap.to(view, { autoAlpha: 1, duration: seconds(reduce.matches ? "--duration-faster" : "--duration-medium"), ease: out, overwrite: "auto" });
        } else {
          gsap.to(view, { y, autoAlpha: 1, duration: seconds("--duration-base"), ease: out, overwrite: "auto" });
        }
        viewShown = true;
      };

      /* The active name (job: show whose colour and films these are): the one under the middle of the screen; the
         first is caught a quarter of a screen early (as its top reaches 75 % down) and the last kept a tenth late
         (until its foot rises to 40 %; Sam, Nov 12: « switch au noir un peu plus tôt pour le dernier »), so neither
         flicks by */
      let active: HTMLElement | null = null;
      const setActive = (item: HTMLElement | null, instant = false) => {
        if (item === active) return;
        active = item;
        items.forEach((i) => i.classList.toggle("is-active", i === item));
        wrap.classList.toggle("is-coloured", !!item);
        paint(item ? (item.dataset.colour ?? "red") : null, instant);
        show(item);
        place(item);
      };
      let changing = false;
      const find = () => {
        const middle = innerHeight / 2;
        const shown = items.filter((i) => !i.hidden);
        let found: HTMLElement | null = null;
        shown.forEach((item, k) => {
          if (found) return;
          const box = item.getBoundingClientRect();
          const from = k === 0 ? middle + innerHeight * 0.25 : middle;
          const until = k === shown.length - 1 ? middle - innerHeight * 0.1 : middle;
          if (box.top <= from && box.bottom > until) found = item;
        });
        return found as HTMLElement | null;
      };
      const check = (instant = false) => {
        // while a filter changes the list, the active name is left as it is: it is chosen once, when the list changes
        if (changing) return;
        setActive(find(), instant);
      };

      /* Filters: Industry and Location keep the names that match; « All » shows everyone */
      const chosen: Record<string, string> = { industry: "", location: "" };
      const matches = (item: HTMLElement) => {
        const industries = (item.dataset.industry ?? "").split("|").filter(Boolean);
        return (
          (!chosen.industry || industries.includes(chosen.industry)) &&
          (!chosen.location || item.dataset.location === chosen.location)
        );
      };
      const apply = () => {
        let shown = 0;
        items.forEach((item) => {
          const ok = matches(item);
          item.hidden = !ok;
          if (ok) shown++;
        });
        if (empty) empty.hidden = shown > 0;
      };
      /* A filter's change (job: say the list changed, in one movement; Sam, Nov 17: « les balles ... un peu
         glitchées ... tout le bloc resize », then « deux ou trois switches dans l'espace de à peine 1 ou 2 secondes
         ... plus seamless »). Who will be active in the new list is worked out first (the list is laid out as it
         will be, read, and put back, within the click: nothing of it is painted), so every part moves once, to where
         it ends:
         - the same director stays active: the colour and the balls do not move at all, only the names change;
         - another one, or nobody: the old one's balls shrink where they are while the list fades out (faster, the
           leave curve), the list changes while nothing of it shows (the page's new height is never seen moving), then, in
           the same beat, the colour goes straight from the old one to the new one (never by the page's own on the
           way), the names that stay, or « No director here yet. », rise in one after the other (350 ms, ease-out,
           160 ms of stagger at most; quicker since Nov 17, « plus snappy ») and the new balls grow in.
         A second click on the way starts again from where it is. Opacity and transform only. Reduced motion: the list
         changes at once. */
      const ahead = () => {
        const y = scrollY;
        const was = items.map((item) => item.hidden);
        items.forEach((item) => (item.hidden = !matches(item)));
        const found = find();
        items.forEach((item, k) => (item.hidden = was[k]));
        if (scrollY !== y) scrollTo(0, y);
        return found;
      };
      const names = wrap.querySelector<HTMLElement>(".directors-home_names");
      let change: gsap.core.Timeline | null = null;
      const settle = () => {
        changing = false;
        check();
        // the names moved: it follows the active one to its new line
        place(active);
      };
      const filter = () => {
        if (reduce.matches || !names) {
          apply();
          settle();
          return;
        }
        // from one filter with nobody to another with nobody: the same line stays, nothing to play (Sam, Nov 17)
        if (!change?.isActive() && items.every((item) => item.hidden) && !items.some(matches)) {
          apply();
          return;
        }
        change?.kill();
        changing = true;
        if (ahead() !== active) {
          balls.forEach((b) => {
            if (b.s <= 0.001) return;
            b.hold = b.leaving = true;
            b.video?.pause();
            gsap.to(b, { s: 0, duration: seconds("--duration-fast"), ease: leave, overwrite: true });
          });
          if (view && viewShown) gsap.to(view, { autoAlpha: 0, duration: seconds("--duration-fast"), ease: leave, overwrite: "auto" });
          viewShown = false;
        }
        const lines = () => {
          const shown = items.filter((i) => !i.hidden).map((i) => i.querySelector<HTMLElement>(".directors-home_name") ?? i);
          return shown.length ? shown : empty ? [empty] : [];
        };
        change = gsap
          .timeline()
          .to(names, { opacity: 0, duration: seconds("--duration-faster"), ease: leave })
          .add(() => {
            gsap.set(wrap.querySelectorAll(".directors-home_name, .directors-home_empty"), { clearProps: "transform,opacity" });
            apply();
            pageLenis()?.resize();
            measure();
            const next = lines();
            gsap.set(names, { opacity: 1 });
            gsap.fromTo(
              next,
              { yPercent: 35, opacity: 0 },
              {
                yPercent: 0,
                opacity: 1,
                duration: seconds("--duration-fast") * 1.4,
                ease: out,
                stagger: Math.min(0.03, 0.16 / Math.max(1, next.length)),
                clearProps: "transform,opacity",
                overwrite: true,
              },
            );
          })
          // with the list's change: the colour and the balls go straight to the new list's active name
          .add(settle);
      };
      /* Home's switch (job: say which of the two this is, and change it in one calm movement; Sam, Nov 27: « le plus
         seamless, le plus smooth »). « Featured work » shows the featured films as a director's reel (full screen,
         the lines scrolling over them, a click plays one whole, Close comes back where it was), « Directors » the
         names. One thing after the other, so nothing competes and the browser never does it all at once:
         - to the featured work: the dots answer at once; the active director's balls shrink away where they are
           (fast, the leave curve); the names fade (fast) and the filters leave line by line (faster, 12 ms apart,
           rising a little); then, with nothing else moving, the page's colour goes back to its own (medium, the
           travel curve); once it is home the reel takes the names' place, under a row that now stays at the top of
           the screen, and fades in (base, ease-out);
         - back to the directors, from anywhere in the reel: the reel fades (faster); under cover the page goes back to
           the row's own place, the row staying exactly where it is on the screen, so nothing is seen to scroll; the
           names rise one after the other as after a filter, the filters with them line by line, and only then the
           middle name gives the page its colour and its balls.
         Reduced motion: at once. */
      const reel = wrap.querySelector<HTMLElement>(".directors-home_reel");
      const reelWrap = reel?.querySelector<HTMLElement>(".director-reel_wrap") ?? null;
      const filterLines = () => [...wrap.querySelectorAll<HTMLElement>(".directors-home_filter > p, .directors-home_filter li")];
      let mode = "director";
      let switching: gsap.core.Timeline | null = null;
      const setMode = (work: boolean) => {
        wrap.classList.toggle("is-work", work);
        wrap.querySelectorAll<HTMLElement>(".directors-home_filter").forEach((f) => (f.inert = work));
      };
      const lay = (work: boolean) => {
        names!.hidden = work;
        reel!.hidden = !work;
        pageLenis()?.resize();
        measure();
        // the reel reads its place again (its films play only while it shows)
        reelWrap?.dispatchEvent(new Event("reel:refresh"));
      };
      const switchTo = (next: string) => {
        if (next === mode || !reel || !names || !filterRow) return;
        mode = next;
        const work = mode === "work";
        wrap.querySelectorAll<HTMLButtonElement>(".directors-home_mode").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.mode === mode)));
        switching?.kill();
        changing = true;
        const fast = seconds("--duration-fast");
        const faster = seconds("--duration-faster");
        const medium = seconds("--duration-medium");
        // where the row is on the screen now: it stays there
        const rowAt = filterRow.getBoundingClientRect().top;
        const backToRow = () => {
          const y = filterRow.getBoundingClientRect().top + scrollY - rowAt;
          if (Math.abs(y - scrollY) < 1) return;
          const lenis = pageLenis();
          if (lenis) lenis.scrollTo(y, { immediate: true, force: true });
          else scrollTo(0, y);
        };
        if (reduce.matches) {
          setActive(null, true);
          setMode(work);
          lay(work);
          gsap.set([names, reel, ...filterLines()], { clearProps: "opacity,transform" });
          if (!work) backToRow();
          changing = false;
          check(true);
          return;
        }
        const tl = gsap.timeline({ onComplete: () => void (switching = null) });
        switching = tl;
        if (work) {
          // the balls first, where they are
          balls.forEach((b) => {
            if (b.s <= 0.001) return;
            b.hold = b.leaving = true;
            b.video?.pause();
            gsap.to(b, { s: 0, duration: fast, ease: leave, overwrite: true });
          });
          rest();
          // then the names and the filters, then the colour alone, then the reel: one thing at a time, so the
          // browser has nothing else to draw while the page's ground turns (it was late doing both, Nov 27)
          const leaveAt = fast * 0.4;
          const paintAt = leaveAt + fast;
          tl.to(names, { opacity: 0, duration: fast, ease: leave }, leaveAt)
            .to(filterLines(), { opacity: 0, yPercent: -35, duration: faster, ease: leave, stagger: 0.012 }, leaveAt)
            .add(() => setActive(null), paintAt)
            .add(() => {
              setMode(true);
              lay(true);
            }, paintAt + medium + 0.05)
            .fromTo(reel, { opacity: 0 }, { opacity: 1, duration: seconds("--duration-base"), ease: out, clearProps: "opacity" })
            .add(() => void (changing = false), "<");
        } else {
          tl.to(reel, { opacity: 0, duration: faster, ease: leave })
            .add(() => {
              setMode(false);
              gsap.set(names, { opacity: 1 });
              lay(false);
              backToRow();
              measure();
              const next = items.filter((i) => !i.hidden).map((i) => i.querySelector<HTMLElement>(".directors-home_name") ?? i);
              gsap.fromTo(
                next,
                { yPercent: 35, opacity: 0 },
                {
                  yPercent: 0,
                  opacity: 1,
                  duration: fast * 1.4,
                  ease: out,
                  stagger: Math.min(0.03, 0.16 / Math.max(1, next.length)),
                  clearProps: "transform,opacity",
                  overwrite: true,
                },
              );
              gsap.fromTo(
                filterLines(),
                { yPercent: 35, opacity: 0 },
                { yPercent: 0, opacity: 1, duration: fast * 1.4, ease: out, stagger: 0.012, delay: 0.06, clearProps: "transform,opacity", overwrite: true },
              );
              gsap.set(reel, { clearProps: "opacity" });
            })
            // the names in: the middle one gives its colour and its balls
            .add(() => {
              changing = false;
              check();
            }, `+=${fast}`);
        }
      };
      wrap.addEventListener(
        "click",
        (event) => {
          const switcher = (event.target as HTMLElement).closest<HTMLButtonElement>(".directors-home_mode");
          if (switcher) {
            switchTo(switcher.dataset.mode ?? "director");
            return;
          }
          const button = (event.target as HTMLElement).closest<HTMLButtonElement>(".directors-home_option");
          if (!button) return;
          const key = button.dataset.filter ?? "";
          const value = button.dataset.value ?? "";
          // « All » pressed again changes nothing; a filter pressed again lets go, back to « All » (Sam, Nov 17)
          if (chosen[key] === value && !value) return;
          chosen[key] = chosen[key] === value ? "" : value;
          wrap.querySelectorAll<HTMLButtonElement>(`.directors-home_option[data-filter="${key}"]`).forEach((b) => {
            b.setAttribute("aria-pressed", String((b.dataset.value ?? "") === chosen[key]));
          });
          filter();
        },
        { signal },
      );

      // the first names' films, a screen and a half before the list shows
      if (!reduce.matches) {
        const near = new IntersectionObserver(
          ([entry]) => {
            if (!entry.isIntersecting) return;
            [0, 1].forEach((n) => load(items[n]));
            near.disconnect();
          },
          { rootMargin: "150% 0px" },
        );
        near.observe(wrap);
        signal.addEventListener("abort", () => near.disconnect(), { once: true });
      }
      // the page as it opens: its colour at once (a page change's veil still covers it)
      check(true);
      let frame = 0;
      const onScroll = () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => check());
      };
      window.addEventListener("scroll", onScroll, { passive: true, signal });
      window.addEventListener(
        "resize",
        () => {
          measure();
          check();
          if (view && active) gsap.set(view, { y: active.offsetTop + active.offsetHeight / 2 });
        },
        { signal },
      );
      reduce.addEventListener(
        "change",
        () => {
          if (reduce.matches) {
            stop();
            balls.forEach((b) => {
              gsap.killTweensOf(b);
              b.s = 0;
              b.el.style.visibility = "hidden";
            });
          } else show(active);
        },
        { signal },
      );
      // leaving the page: the next page brings its own theme with it, nothing to put back
      signal.addEventListener(
        "abort",
        () => {
          stop();
          clearTimeout(idle);
          cancelAnimationFrame(frame);
          balls.forEach((b) => gsap.killTweensOf(b));
          if (view) gsap.killTweensOf(view);
        },
        { once: true },
      );
    });
  });
</script>

<style is:global>
  @layer components {
    /* While the page's colour changes (data-painting on <html>, set by the script for the time it takes), the links
       that have a colour transition of their own for their hover take the page's duration and curve, so everything
       turns together (Sam, Nov 17, comment 25: measured, the filter's options turned in 250 ms and the names in 450
       while the ground took 800). Here, in the components' layer: a rule of project.css loses to their own. Their own
       timing comes back for the hovers once the page has turned. The menu's mark and « View director », which set
       their own colour and had no transition, turned at once: they are in the list too. */
    :root[data-painting] :is(.nav_wrap, .nav_logo, .nav_link, .directors-home_name, .directors-home_view) {
      transition: color var(--paint-duration, 0s) var(--ease-travel);
    }
    /* the footer's links take their menu's colour as it turns (it is the one that turns, project.css): none of their
       own meanwhile, which would start again at every frame (measured Nov 27: 300 ms late) */
    :root[data-painting] .footer_link {
      transition: none;
    }
    /* On Home, above the curve that follows it, with no ground of its own: the page's ground shows through, dark, or
       the active director's colour (the page's theme turns to it, src: the script; the change: project.css) */
    .directors-home_wrap {
      position: relative;
      z-index: 1;
      isolation: isolate;
      padding-top: var(--space-6);
      padding-bottom: var(--space-9);
    }
    /* On a director's page it paints its own dark over the reel's end, and the list ends 144 above the footer's rule
       (keyed on .is-dark, which stays: its theme changes with the page's colour) */
    .directors-home_wrap.is-dark {
      padding-top: var(--section-space-small);
      /* four times the space it had before the footer (Sam, Nov 17) */
      padding-bottom: calc(var(--section-space-medium) * 4);
    }
    .directors-home_wrap.is-page {
      padding-top: var(--page-top);
      padding-bottom: var(--section-space-medium);
    }
    .directors-home_layout {
      row-gap: var(--section-space-large);
    }
    .directors-home_row {
      grid-column: margin / end;
      display: grid;
      grid-template-columns: subgrid;
      row-gap: var(--space-7);
      align-items: start;
    }
    .directors-home_label {
      grid-column: margin / end;
      @media (width >= 48rem) {
        grid-column: margin / half;
      }
    }
    /* Home's switch: « Directors » and « Featured work » side by side where the label stands */
    .directors-home_switch {
      grid-column: margin / end;
      display: flex;
      flex-wrap: wrap;
      /* half the label's space between the two (Sam, Nov 27) */
      gap: var(--space-4) var(--space-5);
      /* a band round the two that takes the click (comment 55), its place in the row unchanged: a click in it that
         misses both buttons does nothing, never the film under it */
      padding: var(--space-switch);
      margin: calc(var(--space-switch) * -1);
      @media (width >= 48rem) {
        grid-column: margin / half;
      }
    }
    /* the chosen one's dot is full, the other's an outline of the page's line. The dot answers the pointer by
       shrinking, a little on the hover, more while pressed (Sam, Nov 27, comment 52: « un léger scale down ... un
       scale down plus présent pour le clic »): the hover on the hover's time, the press quicker, its way back on the
       hover's. Reduced motion: no shrinking, the dot simply turns. */
    .directors-home_mode {
      color: inherit;
      &::before {
        transition:
          background-color var(--hover-duration) var(--hover-ease),
          box-shadow var(--hover-duration) var(--hover-ease),
          scale var(--hover-duration) var(--hover-ease);
      }
      &[aria-pressed="false"]::before {
        background-color: transparent;
        box-shadow: inset 0 0 0 var(--border-width) var(--dot-color);
      }
      @media (prefers-reduced-motion: no-preference) {
        @media (hover: hover) {
          &:hover::before {
            scale: var(--dot-hover-scale);
          }
        }
        &:active::before {
          scale: var(--dot-press-scale);
          transition-duration: var(--duration-faster);
        }
      }
      /* the area a click takes: the button and half the space around it, the switch's own band round both (Sam, Nov
         27, comment 55: a click a little beside the button played the film under it) */
      &::after {
        content: "";
        position: absolute;
        inset: calc(var(--space-switch) * -1) calc(var(--space-5) * -0.5);
      }
    }
    /* With the featured work the row stays at the top of the screen over the reel (Sam, Nov 27), a margin down as the
       menu; it steps aside while a film is watched */
    .directors-home_wrap.is-work .directors-home_layout {
      position: sticky;
      top: var(--site-margin);
      z-index: var(--layer-raised);
      /* only the switch takes the pointer: a click anywhere else reaches the reel under it (it plays the film) */
      pointer-events: none;
      transition: opacity var(--duration-medium) var(--ease-out);
      & .directors-home_switch {
        pointer-events: auto;
      }
      /* the filters, gone with the names, take no room in the row that stays on screen */
      & .directors-home_filter {
        display: none;
      }
      :root[data-watching] & {
        opacity: 0;
        & .directors-home_switch {
          pointer-events: none;
        }
      }
    }
    /* The featured reel: right under the row, the films sooner than on a director's page (a shorter dissolve: no
       opening above it to come out of) and ending nearer the curve after it (Sam, Nov 27: « trop d'espace entre le
       dernier film et la phrase »). Its films carry a shade at their top too, under the row, so the row reads over any
       of them: in the film, never over the page's ground (a shade on the row drew a band across the page while its
       colour turned). */
    .directors-home_reel {
      /* the first film a section's space under the row, then its dissolve over half a screen (Sam, Nov 27: « commencer
         le premier featured film plus bas, plus d'espace entre la barre du haut et le premier film »; it was 40svh
         right under the row) */
      margin-top: var(--section-space-large);
      & .director-reel_fade.is-in {
        height: 50svh;
      }
      & .director-reel_fade.is-out {
        height: 30svh;
        margin-top: 0;
      }
      & .director-reel_shade {
        background:
          linear-gradient(color-mix(in srgb, var(--black) 40%, transparent), transparent 25%),
          linear-gradient(to top, color-mix(in srgb, var(--black) 45%, transparent), transparent 35%),
          color-mix(in srgb, var(--black) 20%, transparent);
      }
    }
    /* with the featured reel the list paints a film, not the page's ground: it no longer passes over the curve's ball
       (which rises into it as it rolls in), the ball passes over its end */
    .directors-home_wrap.is-work {
      padding-bottom: 0;
      z-index: 0;
    }
    /* the dots turn with the page while it turns (measured Nov 27: they turned in 250 ms and the ground in 450). A rule
       of its own: a pseudo-element cannot sit in a nested rule's :is() */
    :root[data-painting] .directors-home_mode::before {
      transition:
        background-color var(--paint-duration, 0s) var(--ease-travel),
        box-shadow var(--paint-duration, 0s) var(--ease-travel),
        scale var(--hover-duration) var(--hover-ease);
    }
    .directors-home_filter {
      display: flex;
      flex-direction: column;
      gap: var(--space-6);
      &.is-industry {
        grid-column: margin / span 2;
        @media (width >= 48rem) {
          grid-column: half / span 2;
        }
      }
      &.is-location {
        grid-column: three / end;
        @media (width >= 48rem) {
          grid-column: aside / end;
        }
      }
    }
    /* No transition of its own on the hover (Sam, Nov 17): with one, its colour ran on another clock than the page's
       when a filter changes the colour. During that change it takes the page's (the rule on :root[data-painting]).
       A chosen filter (not « All ») has a dot at its left and moves over to make room; pressed again, it lets go. */
    /* Its colour is its group's (which changes with the page, project.css), dimmed by opacity when it is not the
       chosen one. Not a colour of its own (--text-2) with a transition of its own: measured Nov 17, that transition
       started again at every frame while the group's ran, and only got going once it had ended, 0.8 s late. */
    .directors-home_option {
      position: relative;
      color: inherit;
      opacity: var(--tone-muted);
      &[aria-pressed="true"] {
        opacity: 1;
      }
      &[aria-pressed="true"]:not([data-value=""]) {
        padding-left: 0.8em;
        &::before {
          content: "";
          position: absolute;
          top: 50%;
          left: 0;
          width: 0.4em;
          height: 0.4em;
          border-radius: var(--radius-round);
          background-color: currentColor;
          translate: 0 -50%;
        }
      }
      @media (hover: hover) {
        &:hover {
          opacity: 1;
        }
      }
    }
    .directors-home_names {
      grid-column: margin / end;
    }
    .directors-home_names {
      position: relative;
    }
    .directors-home_list {
      color: var(--heading-accent);
      /* on a phone the names grow to 72 px and over (80 at most), each on two lines (Sam, Nov 12: « noms plus gros,
         sur 2 lignes »), meeting the tablet's size at 768 */
      @media (width < 48rem) {
        font-size: clamp(4.75rem, 19.5vw, 5.75rem);
      }
    }
    /* Under the balls but the active one, which stays above them (the Figma's hover frames) */
    .directors-home_item {
      position: relative;
      z-index: 1;
      .is-coloured & {
        color: var(--text-3);
      }
      &.is-active {
        z-index: 3;
        color: var(--text);
      }
    }
    /* The row is the link, across the whole width. A name not active answers a hover quietly, from 30 % to 40 %
       (Sam, Nov 12: « hover plus subtil », then « réduire encore plus ») */
    .directors-home_name {
      display: flex;
      color: inherit;
      transition: color var(--duration-medium) var(--ease-out);
      @media (hover: hover) {
        &:hover {
          color: var(--text);
          .is-coloured .directors-home_item:not(.is-active) & {
            color: color-mix(in srgb, var(--text) var(--tone-hover), transparent);
          }
        }
      }
    }
    /* « View director »: one for the list, at its far right, level with the active name (src: the script moves it
       and fades it); from a tablet up. Its arrow slides on a hover of it or of the active row */
    .directors-home_view {
      position: absolute;
      top: 0;
      right: 0;
      z-index: 3;
      color: var(--text);
      opacity: 0;
      visibility: hidden;
      @media (width < 48rem) {
        display: none;
