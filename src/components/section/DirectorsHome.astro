       Figma's 238 at 1728 (13.8 % of the width), 128 at the least on a phone */
    .directors-home_balls {
      position: fixed;
      inset: 0;
      z-index: 2;
      overflow: clip;
      pointer-events: none;
      @media (prefers-reduced-motion: reduce) {
        display: none;
      }
    }
    .directors-home_ball {
      position: absolute;
      top: 0;
      left: 0;
      width: max(13.8vw, 8rem);
      aspect-ratio: 1;
      overflow: hidden;
      border-radius: 50%;
      background-color: var(--black);
      visibility: hidden;
      will-change: transform;
