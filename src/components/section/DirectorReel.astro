---
/* A director's reel (Sam, Nov 11, the Figma: « le gradient, c'est comme la transition entre le hero ... la vidéo reste
   fixe en background et va switch en fade smooth entre les différents projets ... la ligne scroll »; Nov 12: « garder
   l'idée du fade, gradient, plus clean, plus smooth et subtil »). The film is fixed behind the page: the reel's stage
   sticks to the screen from before it shows (the section starts a screen higher, under the opening, which covers it)
   until after it (the other directors come over its last screen), so it never moves. The opening's colour dissolves
   into the film through a long eased gradient the scroll draws up; the film holds the screen while each project's
   line (play, title, client, agency, year) scrolls up over it, cross-fading to that project's as its line comes in;
   after the last, the dark rises over the film the same way, and the other directors follow on it. A project with a
   film file plays its short version (muted, looping); until the files are in, its still stands in.
   Watching a film (Sam, Nov 17, the Figma's three frames: « un bouton play qui follow le curseur ... la ligne
   principale va servir aussi de progress bar ... garde la ligne au même endroit du scroll ... si l'utilisateur bouge
   pas la souris pendant 2 secondes, on fait disparaître cette barre-là ... fais jouer avec le son »): a click on the
   reel, where « Play » follows the pointer, or on a line's title, plays that film whole, with its sound, in place:
   the page holds still, the other lines and the colour leave, the film's line stays where it was and its rule fills
   as the film plays, its triangle now a pause. « Close » follows the pointer: a click, Escape or the film's end
   leaves. Two seconds without the pointer moving and the line and the label fade out; they come back when it moves.
   Since Nov 17 (Sam): while the film loads, a small ring turns at the pointer between « Play » and « Close »; the
   rule is clicked or dragged to move through the film; the film shows in its own format (read from the file), from
   the full screen of its short version; the address names the film (?film=<its id>), so Back closes it where the
   page was and a link opens it. */
import Img from "@/components/media/Img.astro";
import { img, type Item } from "@/utils/content.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The director's films, in their order. */
  projects: Item<"projects">[];
  /** The page's colour, which dissolves into the film (the director's). */
  colour?: "red" | "mustard" | "teal";
  /** Shown alone (the components page): no screen under an opening before it or under a section after it. */
  alone?: boolean;
}

const { render = true, projects, colour = "red", alone = false } = Astro.props;
---

{
  render && projects.length > 0 && (
    <section
      class:list={["director-reel_wrap theme-dark", alone && "is-alone"]}
      style={`--_colour: var(--${colour})`}
      data-paint="theme-dark"
      data-op-section="DirectorReel"
      data-op-list="projects"
      data-op-source="astro:projects"
    >
      <div class="director-reel_stage" aria-hidden="true">
        <div class="director-reel_film">
          {projects.map((p, i) => (
            <div class:list={["director-reel_media", i === 0 && "is-active"]} data-index={i}>
              {p.data.still && (
                <Img class="director-reel_still cover-absolute object-fit-cover" {...img(p.data.still)} alt="" variant="full-width" loading={i === 0 ? "eager" : "lazy"} />
              )}
              {(p.data.cover || p.data.video) && (
                <video
                  class="director-reel_video cover-absolute object-fit-cover"
                  src={p.data.preview || p.data.cover || p.data.video}
                  data-film={p.data.video || p.data.cover}
                  muted
                  loop
                  playsinline
                  preload={i === 0 ? "auto" : "none"}
                />
              )}
            </div>
          ))}
        </div>
        {/* the film itself, whole, over its short version while it is watched (the script gives it its file) */}
        <div class="director-reel_media is-movie">
          <video class="director-reel_movie cover-absolute object-fit-contain" playsinline preload="none" />
        </div>
        <div class="director-reel_shade" />
      </div>
      <ol class="director-reel_list">
        <li class="director-reel_space" aria-hidden="true" />
        <li class="director-reel_fade is-in" aria-hidden="true" />
        {projects.map((p, i) => (
          <li class="director-reel_slot" data-op-item={p.id} data-index={i} data-vertical={p.data.vertical ? "true" : undefined}>
            <div class="director-reel_line site-grid rule-top text-style-main">
              <span class="director-reel_elapsed" aria-hidden="true" />
              <span class="director-reel_seek" aria-hidden="true" />
              {p.data.video || p.data.cover ? (
                <button class="director-reel_title" type="button" data-play={i} aria-label={`Play ${p.data.name}`}>
                  <svg class="director-reel_icon" viewBox="0 0 22 24" aria-hidden="true">
                    <path class="is-play" d="M0 0l22 12L0 24z" />
                    <path class="is-pause" d="M1 0h7v24H1zM14 0h7v24h-7z" />
                  </svg>
                  <span data-op-field="name">{p.data.name}</span>
                </button>
              ) : (
                <p class="director-reel_title">
                  <svg class="director-reel_icon" viewBox="0 0 22 24" aria-hidden="true">
                    <path d="M0 0l22 12L0 24z" />
                  </svg>
                  <span data-op-field="name">{p.data.name}</span>
                </p>
              )}
              {p.data.client && (
                <p class="director-reel_client">
                  <span class="director-reel_key">Client</span>
                  <br />
                  <span data-op-field="client">{p.data.client}</span>
                </p>
              )}
              {p.data.agency && (
                <p class="director-reel_agency">
                  <span class="director-reel_key">Agency</span>
                  <br />
                  <span data-op-field="agency">{p.data.agency}</span>
                </p>
              )}
              {p.data.year && (
                <p class="director-reel_year">
                  <span class="director-reel_key">Year</span>
                  <br />
                  <span data-op-field="year">{p.data.year}</span>
                </p>
              )}
            </div>
          </li>
        ))}
        <li class="director-reel_fade is-out" aria-hidden="true" />
        <li class="director-reel_space is-end" aria-hidden="true" />
      </ol>
      <button class="director-reel_close text-style-large" type="button">
        Close
      </button>
      <span class="director-reel_cursor text-style-main" aria-hidden="true">
        <span class="director-reel_word" />
        <span class="director-reel_ring" />
      </span>
    </section>
  )
}

<script>
  import { onPage } from "@/utils/page.ts";
  import { pageLenis } from "@/utils/smooth-scroll.ts";

  const clamp = (t: number) => Math.min(1, Math.max(0, t));

  onPage((signal) => {
    document.querySelectorAll<HTMLElement>(".director-reel_wrap").forEach((wrap) => {
      const film = wrap.querySelector<HTMLElement>(".director-reel_film");
      const fadeIn = wrap.querySelector<HTMLElement>(".director-reel_fade.is-in");
      const end = wrap.querySelector<HTMLElement>(".director-reel_space.is-end");
      const media = [...wrap.querySelectorAll<HTMLElement>(".director-reel_media[data-index]")];
      const slots = [...wrap.querySelectorAll<HTMLElement>(".director-reel_slot")];
      const reduce = matchMedia("(prefers-reduced-motion: reduce)");
      if (!film || !fadeIn || !end) return;

      /* The film behind (job: show the project whose line is on screen): the last line wholly in from the bottom wins;
         its layer fades in over the others (slow); its film plays while the reel shows, the others pause. The first
         film loads with the page and starts half a screen before the reel shows; the next one loads while the
         current plays (Sam, Nov 17: « starter les vidéos un peu plus tôt »), so none is seen waiting on its first
         frame. */
      let active = -1;
      let shown = false;
      let watching = -1;
      const movieBox = wrap.querySelector<HTMLElement>(".director-reel_media.is-movie");
      const play = () => {
        media.forEach((m, k) => {
          m.classList.toggle("is-active", k === active);
          const video = m.querySelector<HTMLVideoElement>("video");
          if (!video) return;
          if (k === active && shown && !reduce.matches && !(watching === k && movieBox?.classList.contains("is-active"))) {
            video.preload = "auto";
            video.play().catch(() => {});
          } else {
            video.pause();
            if (k === active + 1 && shown && !reduce.matches) video.preload = "auto";
          }
        });
      };

      /* The film travels up behind the page, slower than the scroll (job: depth, a smooth parallax; Sam, Nov 12:
         « parallax dans l'apparition du visuel », then comment 13: « bcp plus de parallax sur le visuel, movement sur
         Y de bas en haut, différente vitesse que le scroll »). The film is a third of a screen taller than the stage
         (--_travel) and rises through it: 24 % of a screen while the colour dissolves (from the gradient's top
         entering the screen to its foot leaving it), settling from 108 % to its size from its top, then the last 12 %
         over the whole reel, until the other directors cover it. Its top never comes below the stage's, its foot never
         above: no edge shows. Scrubbed by the scroll (Lenis smooths it). Transform only; none with reduced motion. */
      const place = () => {
        // reads first (the lines', the gradient's and the end's places), then the writes
        let found = 0;
        slots.forEach((slot, i) => {
          const bar = slot.querySelector<HTMLElement>(".director-reel_line");
          if (bar && bar.getBoundingClientRect().bottom <= innerHeight) found = i;
        });
        const fade = fadeIn.getBoundingClientRect();
        // seen from the gradient's top coming in to the screen under the other directors (alone: the section's foot)
        const tail = end.offsetParent ? end.getBoundingClientRect().top : wrap.getBoundingClientRect().bottom;
        const visible = fade.top < innerHeight * 1.5 && tail > 0;
        const settle = clamp((innerHeight - fade.top) / (innerHeight + fade.height));
        const drift = clamp(-fade.bottom / Math.max(1, tail - fade.bottom));
        const rise = 24 * settle + 12 * drift;
        film.style.transform = reduce.matches
          ? ""
          : `translate3d(0, ${(-rise).toFixed(2)}svh, 0) scale(${(1 + 0.08 * (1 - settle)).toFixed(4)})`;
        // a film being watched keeps the screen, whatever a resize makes of the lines
        if (watching >= 0) return;
        if (found !== active || visible !== shown) {
          active = found;
          shown = visible;
          play();
        }
      };
      place();
      let frame = 0;
      const tick = () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(place);
      };
      window.addEventListener("scroll", tick, { passive: true, signal });
      window.addEventListener("resize", tick, { signal });
      reduce.addEventListener("change", tick, { signal });
      /* Watching a film (job: watch it whole, with its sound, without leaving the reel). The film itself loads over
         its short version and fades in once it plays (medium), so nothing jumps; the page is held (wheel, touch and
         the scroll keys; Lenis stopped) so the film's line stays where it was; its rule fills with the film's time.
         The label at the pointer says what a click does (« Play », then « Close »): fine pointers only, never over a
         button or a link. Idle for two seconds while it plays (Sam's two seconds): the line and the label fade out,
         and the pointer with them; any move, key or pause brings them back. Reduced motion: the same, the fades
         shorter. */
      const IDLE = 2000;
      const root = document.documentElement;
      const movie = movieBox?.querySelector<HTMLVideoElement>("video") ?? null;
      const cursor = wrap.querySelector<HTMLElement>(".director-reel_cursor");
      const closer = wrap.querySelector<HTMLButtonElement>(".director-reel_close");
      const ms = (name: string) => {
        const v = getComputedStyle(root).getPropertyValue(name).trim();
        return (parseFloat(v) || 0) * (v.endsWith("ms") ? 1 : 1000);
      };
      const film$ = (i: number) => media[i]?.querySelector<HTMLVideoElement>("video") ?? null;
      const button$ = (i: number) => slots[i]?.querySelector<HTMLButtonElement>("[data-play]") ?? null;
      const elapsed$ = (i: number) => slots[i]?.querySelector<HTMLElement>(".director-reel_elapsed") ?? null;
      let over: EventTarget | null = null;
      let idle = 0;
      let bar = 0;
      let held: AbortController | null = null;
      let loading = false;
      let dragging = false;
      const word = cursor?.querySelector<HTMLElement>(".director-reel_word") ?? null;
      // a film asked for by its address, which no click has started yet: a click plays it
      const unplayed = () => Boolean(movie?.paused && !movieBox?.classList.contains("is-active"));
      const label = () => {
        if (!cursor || !word) return;
        const on = over instanceof Element && !over.closest("button, a, .director-reel_seek");
        const wait = on && watching >= 0 && loading;
        const text = !on ? "" : wait ? "Loading" : watching >= 0 ? (unplayed() ? "Play" : "Close") : shown && film$(active) ? "Play" : "";
        if (text) word.textContent = text;
        cursor.classList.toggle("is-loading", wait);
        cursor.classList.toggle("is-on", Boolean(text));
      };
      const wake = () => {
        wrap.classList.remove("is-idle");
        clearTimeout(idle);
        if (watching >= 0 && movie && !movie.paused && !loading && !dragging)
          idle = window.setTimeout(() => wrap.classList.add("is-idle"), IDLE);
      };
      /* The film's own format: it is shown whole (contain); --_cover is how much bigger it must be to fill the
         screen as its short version does, which is where it starts from and goes back to */
      const fit = () => {
        if (!movie || !movieBox || !movie.videoWidth || !movieBox.clientHeight) return;
        const screen = movieBox.clientWidth / movieBox.clientHeight;
        const format = movie.videoWidth / movie.videoHeight;
        movie.style.setProperty("--_cover", Math.max(screen / format, format / screen).toFixed(4));
      };
      /* The address names the film being watched. Close goes back over the entry this reel added (pushed), and Back
         or Forward on this page open and close the film here. Astro's router loads the page again on any step to an
         entry that carries a state, and leaves alone those that carry none: so while a film is open, the page's
         entry and the film's carry none (the router's state, kept here, goes back on the entry once it is the
         current one again, or before the router leaves it). */
      const path = location.pathname;
      const slug$ = (i: number) => slots[i]?.dataset.opItem ?? "";
      const address = (slug?: string) => {
        const url = new URL(location.href);
        if (slug) url.searchParams.set("film", slug);
        else url.searchParams.delete("film");
        return url;
      };
      let own = false;
      let pushed = false;
      let kept = history.state;
      const restore = () => {
        if (history.state === null && kept && !location.hash) history.replaceState({ ...kept, scrollX, scrollY }, "");
      };
      document.addEventListener("astro:before-preparation", restore, { signal });
      const fill = () => {
        cancelAnimationFrame(bar);
        const line = elapsed$(watching);
        if (!movie || !line) return;
        if (movie.duration) line.style.scale = `${Math.min(1, movie.currentTime / movie.duration)} 1`;
        if (!movie.paused) bar = requestAnimationFrame(fill);
      };
      const state = () => {
        if (watching < 0 || !movie) return;
        const name = button$(watching)?.textContent?.trim() ?? "";
        slots[watching]?.classList.toggle("is-playing", !movie.paused);
        button$(watching)?.setAttribute("aria-label", `${movie.paused ? "Play" : "Pause"} ${name}`);
        fill();
        wake();
      };
      const leave = (how: "close" | "back" | "gone" = "close") => {
        const i = watching;
        if (i < 0 || !movie) return;
        watching = -1;
        loading = false;
        dragging = false;
        if (how === "close") {
          if (pushed) {
            pushed = false;
            own = true;
            history.back();
          } else if (new URLSearchParams(location.search).has("film")) {
            history.replaceState(history.state, "", address());
            restore();
          }
        }
        held?.abort();
        held = null;
        clearTimeout(idle);
        cancelAnimationFrame(bar);
        movieBox?.classList.remove("is-active");
        wrap.classList.remove("is-watching", "is-idle");
        slots[i]?.classList.remove("is-current", "is-playing");
        button$(i)?.setAttribute("aria-label", `Play ${button$(i)?.textContent?.trim() ?? ""}`);
        delete root.dataset.watching;
        pageLenis()?.start();
        play();
        label();
        // the film leaves once it has faded out, its line's rule empty again
        window.setTimeout(() => {
          if (watching >= 0) return;
          movie.pause();
          movieBox?.classList.remove("is-whole");
          movie.removeAttribute("src");
          movie.load();
          const line = elapsed$(i);
          if (line) line.style.scale = "";
        }, ms("--duration-medium"));
      };
      const watch = (i: number, push = true) => {
        const source = film$(i);
        if (!source || !movie || !movieBox) return;
        watching = i;
        loading = true;
        if (push && slug$(i)) {
          kept = history.state ?? kept;
          history.replaceState(null, "");
          history.pushState(null, "", address(slug$(i)));
          pushed = true;
        }
        if (active !== i) {
          active = i;
          play();
        }
        wrap.classList.add("is-watching");
        slots[i]?.classList.add("is-current");
        root.dataset.watching = "";
        // the page holds still: the line stays where it was
        held = new AbortController();
        const hold = { signal: held.signal, passive: false } as const;
        const stay = (event: Event) => event.preventDefault();
        window.addEventListener("wheel", stay, hold);
        window.addEventListener("touchmove", stay, hold);
        window.addEventListener("pointermove", wake, { signal: held.signal });
        window.addEventListener(
          "keydown",
          (event) => {
            const onButton = event.target instanceof Element && event.target.closest("button, a");
            if (event.key === "Escape") leave();
            else if (event.key === " " && !onButton) {
              event.preventDefault();
              if (movie.paused) movie.play().catch(() => {});
              else movie.pause();
            } else if ((event.key === "ArrowLeft" || event.key === "ArrowRight") && movie.duration) {
              // five seconds back or on
              movie.currentTime = Math.min(movie.duration, Math.max(0, movie.currentTime + (event.key === "ArrowLeft" ? -5 : 5)));
              fill();
            } else if (["ArrowUp", "ArrowDown", "PageUp", "PageDown", "Home", "End"].includes(event.key)) event.preventDefault();
            wake();
          },
          { signal: held.signal },
        );
        pageLenis()?.stop();
        movieBox.classList.remove("is-whole");
        movie.src = source.dataset.film || source.currentSrc || source.src;
        movie.muted = false;
        movie.play().catch(() => {
          // not allowed to start by itself (a film opened by its address): it waits for a click
          loading = false;
          state();
          label();
        });
        label();
      };
      movie?.addEventListener("loadedmetadata", fit, { signal });
      window.addEventListener("resize", fit, { signal });
      movie?.addEventListener(
        "playing",
        () => {
          if (watching < 0) return;
          loading = false;
          label();
          wake();
          if (movieBox?.classList.contains("is-active")) return;
          fit();
          // it fades in and settles into its own format in the same movement (Sam, Nov 17: later was too late)
          movieBox?.classList.add("is-active", "is-whole");
          // its short version rests once the film covers it
          const k = watching;
          window.setTimeout(() => watching === k && film$(k)?.pause(), ms("--duration-medium"));
        },
        { signal },
      );
      // the film stalls on its file: the ring again
      movie?.addEventListener(
        "waiting",
        () => {
          if (watching < 0) return;
          loading = true;
          label();
          wake();
        },
        { signal },
      );
      /* Moving through the film: the rule is pressed or dragged (the pointer is kept while it is down), and the
         filled part follows at once */
      const seek = (event: PointerEvent, track: HTMLElement) => {
        if (!movie || !movie.duration) return;
        const box = track.getBoundingClientRect();
        const t = clamp((event.clientX - box.left) / Math.max(1, box.width));
        movie.currentTime = t * movie.duration;
        const line = elapsed$(watching);
        if (line) line.style.scale = `${t} 1`;
      };
      wrap.addEventListener(
        "pointerdown",
        (event) => {
          const track = (event.target as Element).closest<HTMLElement>(".director-reel_seek");
          if (!track || watching < 0) return;
          event.preventDefault();
          dragging = true;
          track.setPointerCapture(event.pointerId);
          seek(event, track);
          wake();
        },
        { signal },
      );
      const drop = () => {
        dragging = false;
        wake();
      };
      wrap.addEventListener("pointerup", drop, { signal });
      wrap.addEventListener("pointercancel", drop, { signal });
      window.addEventListener(
        "popstate",
        (event) => {
          // an entry with a state is the router's: it loads the page again, and this reel with it
          if (location.pathname !== path || event.state !== null) return;
          const film = new URLSearchParams(location.search).get("film");
          if (!film) restore();
          if (own) {
            // this reel's own step back, after Close
            own = false;
            return;
          }
          if (watching >= 0) {
            pushed = false;
            leave("back");
          }
          const i = film ? slots.findIndex((slot) => slot.dataset.opItem === film) : -1;
          // Forward, onto a film's entry: it opens here; Close will then clear the address on that entry
          if (i >= 0 && film$(i)) watch(i, false);
        },
        { signal },
      );
      movie?.addEventListener("play", state, { signal });
      movie?.addEventListener("pause", state, { signal });
      movie?.addEventListener("ended", () => leave(), { signal });
      wrap.addEventListener(
        "pointermove",
        (event) => {
          if (event.pointerType !== "mouse" || !cursor) return;
          over = event.target;
          if (dragging) {
            const track = slots[watching]?.querySelector<HTMLElement>(".director-reel_seek");
            if (track) seek(event, track);
          }
          cursor.style.setProperty("--_x", `${event.clientX}px`);
          cursor.style.setProperty("--_y", `${event.clientY}px`);
          label();
        },
        { signal },
      );
      wrap.addEventListener(
        "pointerleave",
        () => {
          over = null;
          label();
        },
        { signal },
      );
      wrap.addEventListener(
        "click",
        (event) => {
          const target = event.target as Element;
          if (target.closest("a, .director-reel_seek")) return;
          const button = target.closest<HTMLButtonElement>("[data-play]");
          if (watching >= 0) {
            // the film's own line pauses and plays (anywhere, for a film not started yet); anything else leaves
            if (movie && ((button && Number(button.dataset.play) === watching) || (unplayed() && !loading))) {
              if (movie.paused) movie.play().catch(() => {});
              else movie.pause();
            } else leave();
            return;
          }
          if (button) watch(Number(button.dataset.play));
          else if (shown && !target.closest(".director-reel_space")) watch(active);
        },
        { signal },
      );
      closer?.addEventListener("click", () => leave(), { signal });
      // a link to a film: the page goes to its line and opens it (its sound waits for a click, as browsers ask)
      const asked = new URLSearchParams(location.search).get("film");
      const first = asked ? slots.findIndex((slot) => slot.dataset.opItem === asked) : -1;
      if (first >= 0 && film$(first) && !wrap.classList.contains("is-alone")) {
        requestAnimationFrame(() => {
          const top = slots[first].getBoundingClientRect().bottom + scrollY - innerHeight;
          const lenis = pageLenis();
          if (lenis) lenis.scrollTo(top, { immediate: true, force: true });
          else scrollTo(0, top);
          requestAnimationFrame(() => {
            place();
            watch(first, false);
          });
        });
      }
      signal.addEventListener(
        "abort",
        () => {
          cancelAnimationFrame(frame);
          leave("gone");
          movie?.pause();
          media.forEach((m) => m.querySelector("video")?.pause());
        },
        { once: true },
      );
    });
  });
</script>

<style is:global>
  @layer components {
    /* The section starts a screen higher, under the opening (which paints its own ground above it), and ends a screen
       lower, under the other directors (likewise): its stage, stuck to the screen all that time, is only seen
       between them, so the film never moves */
    .director-reel_wrap {
      position: relative;
      z-index: 0;
      margin-block: -100svh;
      background-color: transparent;
      /* the rule and the text stay stone over any film */
      --border: var(--text);
      /* an eased gradient's stops (ease-in-out): from the colour's full strength to none, without a visible edge */
      --_eased: black 0%, rgb(0 0 0 / 0.987) 8.1%, rgb(0 0 0 / 0.951) 15.5%, rgb(0 0 0 / 0.896) 22.5%,
