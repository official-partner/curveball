---
/* A director's reel (Sam, Nov 11, the Figma: « le gradient, c'est comme la transition entre le hero ... la vidéo reste
   fixe en background et va switch en fade smooth entre les différents projets ... la ligne scroll »; Nov 12: « garder
   l'idée du fade, gradient, plus clean, plus smooth et subtil »). The film is fixed behind the page: the reel's stage
   sticks to the screen from before it shows (the section starts a screen higher, under the opening, which covers it)
   until after it (the other directors come over its last screen), so it never moves. The opening's colour dissolves
   into the film through a long eased gradient the scroll draws up; the film holds the screen while each project's
   line (play, title, client, agency, year) scrolls up over it, cross-fading to that project's as its line comes in;
   after the last, the dark rises over the film the same way, and the other directors follow on it. A project with a
   film file plays it (muted, looping) and its line opens the player; until the files are in, its still stands in. */
import Img from "@/components/media/Img.astro";
import { img, type Item } from "@/utils/content.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The director's films, in their order. */
  projects: Item<"projects">[];
  /** The page's colour, which dissolves into the film (the director's). */
  colour?: "red" | "mustard" | "teal";
  /** Shown alone (the components page): no screen under an opening before it or under a section after it. */
  alone?: boolean;
}

const { render = true, projects, colour = "red", alone = false } = Astro.props;
---

{
  render && projects.length > 0 && (
    <section
      class:list={["director-reel_wrap theme-dark", alone && "is-alone"]}
      style={`--_colour: var(--${colour})`}
      data-paint="theme-dark"
      data-op-section="DirectorReel"
      data-op-list="projects"
      data-op-source="astro:projects"
    >
      <div class="director-reel_stage" aria-hidden="true">
        <div class="director-reel_film">
          {projects.map((p, i) => (
            <div class:list={["director-reel_media", i === 0 && "is-active"]} data-index={i}>
              {p.data.still && (
                <Img {...img(p.data.still)} alt="" variant="full-width" loading={i === 0 ? "eager" : "lazy"} />
              )}
              {p.data.video && <video class="director-reel_video" src={p.data.video} muted loop playsinline preload="none" />}
            </div>
          ))}
        </div>
        <div class="director-reel_shade" />
      </div>
      <ol class="director-reel_list">
        <li class="director-reel_space" aria-hidden="true" />
        <li class="director-reel_fade is-in" aria-hidden="true" />
        {projects.map((p, i) => (
          <li class="director-reel_slot" data-op-item={p.id} data-index={i} data-vertical={p.data.vertical ? "true" : undefined}>
            <div class="director-reel_line site-grid rule-top text-style-main">
              {p.data.video ? (
                <button class="director-reel_title" type="button" data-play={i} aria-label={`Play ${p.data.name}`}>
                  <svg class="director-reel_icon" viewBox="0 0 22 24" aria-hidden="true">
                    <path d="M0 0l22 12L0 24z" />
                  </svg>
                  <span data-op-field="name">{p.data.name}</span>
                </button>
              ) : (
                <p class="director-reel_title">
                  <svg class="director-reel_icon" viewBox="0 0 22 24" aria-hidden="true">
                    <path d="M0 0l22 12L0 24z" />
                  </svg>
                  <span data-op-field="name">{p.data.name}</span>
                </p>
              )}
              {p.data.client && (
                <p class="director-reel_client">
                  <span class="director-reel_key">Client</span>
                  <br />
                  <span data-op-field="client">{p.data.client}</span>
                </p>
              )}
              {p.data.agency && (
                <p class="director-reel_agency">
                  <span class="director-reel_key">Agency</span>
                  <br />
                  <span data-op-field="agency">{p.data.agency}</span>
                </p>
              )}
              {p.data.year && (
                <p class="director-reel_year">
                  <span class="director-reel_key">Year</span>
                  <br />
                  <span data-op-field="year">{p.data.year}</span>
                </p>
              )}
            </div>
          </li>
        ))}
        <li class="director-reel_fade is-out" aria-hidden="true" />
        <li class="director-reel_space is-end" aria-hidden="true" />
      </ol>
      <dialog class="director-reel_player theme-dark" aria-label="Film">
        <video class="director-reel_movie" playsinline />
        <button class="director-reel_close text-style-large" type="button">Close</button>
        <div class="director-reel_bar site-grid text-style-main">
          <div class="director-reel_progress" aria-hidden="true">
            <span class="director-reel_elapsed" />
          </div>
          <button class="director-reel_toggle" type="button" aria-label="Pause">
            <svg viewBox="0 0 16 22" aria-hidden="true">
              <path class="is-pause" d="M0 0h5v22H0zM11 0h5v22h-5z" />
              <path class="is-play" d="M0 0l16 11L0 22z" />
            </svg>
            <span class="director-reel_now" />
          </button>
        </div>
      </dialog>
    </section>
  )
}

<script>
  import { onPage } from "@/utils/page.ts";

  const clamp = (t: number) => Math.min(1, Math.max(0, t));

  onPage((signal) => {
    document.querySelectorAll<HTMLElement>(".director-reel_wrap").forEach((wrap) => {
      const film = wrap.querySelector<HTMLElement>(".director-reel_film");
      const fadeIn = wrap.querySelector<HTMLElement>(".director-reel_fade.is-in");
      const end = wrap.querySelector<HTMLElement>(".director-reel_space.is-end");
      const media = [...wrap.querySelectorAll<HTMLElement>(".director-reel_media")];
      const slots = [...wrap.querySelectorAll<HTMLElement>(".director-reel_slot")];
      const reduce = matchMedia("(prefers-reduced-motion: reduce)");
      if (!film || !fadeIn || !end) return;

      /* The film behind (job: show the project whose line is on screen): the last line wholly in from the bottom wins;
         its layer fades in over the others (slow); its film plays while the reel shows, the others pause */
      let active = -1;
      let shown = false;
      const play = () => {
        media.forEach((m, k) => {
          m.classList.toggle("is-active", k === active);
          const video = m.querySelector<HTMLVideoElement>("video");
          if (!video) return;
          if (k === active && shown && !reduce.matches) {
            video.preload = "auto";
            video.play().catch(() => {});
          } else video.pause();
        });
      };

      /* The film travels up behind the page, slower than the scroll (job: depth, a smooth parallax; Sam, Nov 12:
         « parallax dans l'apparition du visuel », then comment 13: « bcp plus de parallax sur le visuel, movement sur
         Y de bas en haut, différente vitesse que le scroll »). The film is a third of a screen taller than the stage
         (--_travel) and rises through it: 24 % of a screen while the colour dissolves (from the gradient's top
         entering the screen to its foot leaving it), settling from 108 % to its size from its top, then the last 12 %
         over the whole reel, until the other directors cover it. Its top never comes below the stage's, its foot never
         above: no edge shows. Scrubbed by the scroll (Lenis smooths it). Transform only; none with reduced motion. */
      const place = () => {
        // reads first (the lines', the gradient's and the end's places), then the writes
        let found = 0;
        slots.forEach((slot, i) => {
          const bar = slot.querySelector<HTMLElement>(".director-reel_line");
          if (bar && bar.getBoundingClientRect().bottom <= innerHeight) found = i;
        });
        const fade = fadeIn.getBoundingClientRect();
        // seen from the gradient's top coming in to the screen under the other directors (alone: the section's foot)
        const tail = end.offsetParent ? end.getBoundingClientRect().top : wrap.getBoundingClientRect().bottom;
        const visible = fade.top < innerHeight && tail > 0;
        const settle = clamp((innerHeight - fade.top) / (innerHeight + fade.height));
        const drift = clamp(-fade.bottom / Math.max(1, tail - fade.bottom));
        const rise = 24 * settle + 12 * drift;
        film.style.transform = reduce.matches
          ? ""
          : `translate3d(0, ${(-rise).toFixed(2)}svh, 0) scale(${(1 + 0.08 * (1 - settle)).toFixed(4)})`;
        if (found !== active || visible !== shown) {
          active = found;
          shown = visible;
          play();
        }
      };
      place();
      let frame = 0;
      const tick = () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(place);
      };
      window.addEventListener("scroll", tick, { passive: true, signal });
      window.addEventListener("resize", tick, { signal });
      reduce.addEventListener("change", tick, { signal });
      /* The player (job: watch a film whole): its line opens it over everything, the film plays with its sound, the
         rule fills as it plays, a click or the button pauses, Close or Escape leaves */
      const dialog = wrap.querySelector<HTMLDialogElement>(".director-reel_player");
      const movie = dialog?.querySelector<HTMLVideoElement>(".director-reel_movie");
      const toggle = dialog?.querySelector<HTMLButtonElement>(".director-reel_toggle");
      const now = dialog?.querySelector<HTMLElement>(".director-reel_now");
      const elapsed = dialog?.querySelector<HTMLElement>(".director-reel_elapsed");
      const sync = () => {
        if (!movie || !toggle) return;
        toggle.classList.toggle("is-paused", movie.paused);
        toggle.setAttribute("aria-label", movie.paused ? "Play" : "Pause");
      };
      wrap.addEventListener(
        "click",
        (event) => {
          const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-play]");
          if (!button || !dialog || !movie) return;
          const i = Number(button.dataset.play);
          const source = media[i]?.querySelector<HTMLVideoElement>("video");
          if (!source) return;
          movie.src = source.currentSrc || source.src;
          movie.classList.toggle("is-vertical", slots[i]?.dataset.vertical === "true");
          if (now) now.textContent = button.textContent?.trim() ?? "";
          dialog.showModal();
          movie.play().catch(() => {});
        },
        { signal },
      );
      movie?.addEventListener("click", () => (movie.paused ? movie.play() : movie.pause()), { signal });
      toggle?.addEventListener("click", () => movie && (movie.paused ? movie.play() : movie.pause()), { signal });
      movie?.addEventListener("play", sync, { signal });
      movie?.addEventListener("pause", sync, { signal });
      movie?.addEventListener(
        "timeupdate",
        () => {
          if (movie && elapsed && movie.duration) elapsed.style.scale = `${movie.currentTime / movie.duration} 1`;
        },
        { signal },
      );
      dialog?.querySelector(".director-reel_close")?.addEventListener("click", () => dialog.close(), { signal });
      dialog?.addEventListener(
        "close",
        () => {
          movie?.pause();
          movie?.removeAttribute("src");
          movie?.load();
        },
        { signal },
      );
      signal.addEventListener(
        "abort",
        () => {
          cancelAnimationFrame(frame);
          media.forEach((m) => m.querySelector("video")?.pause());
        },
        { once: true },
      );
    });
  });
</script>

<style is:global>
  @layer components {
    /* The section starts a screen higher, under the opening (which paints its own ground above it), and ends a screen
       lower, under the other directors (likewise): its stage, stuck to the screen all that time, is only seen
       between them, so the film never moves */
    .director-reel_wrap {
      position: relative;
      z-index: 0;
      margin-block: -100svh;
      background-color: transparent;
      /* the rule and the text stay stone over any film */
      --border: var(--text);
      /* an eased gradient's stops (ease-in-out): from the colour's full strength to none, without a visible edge */
      --_eased: black 0%, rgb(0 0 0 / 0.987) 8.1%, rgb(0 0 0 / 0.951) 15.5%, rgb(0 0 0 / 0.896) 22.5%,
        rgb(0 0 0 / 0.825) 29%, rgb(0 0 0 / 0.741) 35.3%, rgb(0 0 0 / 0.648) 41.2%, rgb(0 0 0 / 0.55) 47.1%,
        rgb(0 0 0 / 0.45) 52.9%, rgb(0 0 0 / 0.352) 58.8%, rgb(0 0 0 / 0.259) 64.7%, rgb(0 0 0 / 0.175) 71%,
        rgb(0 0 0 / 0.104) 77.5%, rgb(0 0 0 / 0.049) 84.5%, rgb(0 0 0 / 0.013) 91.9%, transparent 100%;
    }
    .director-reel_stage {
      position: sticky;
      top: 0;
      height: 100svh;
      overflow: hidden;
      background-color: var(--black);
    }
    /* taller than the stage by the way it travels up (the script) */
    .director-reel_film {
      --_travel: 36svh;
      position: absolute;
      inset: 0 0 auto;
      height: calc(100% + var(--_travel));
      background-color: var(--black);
      transform-origin: 50% 0;
      will-change: transform;
      @media (prefers-reduced-motion: reduce) {
        height: 100%;
      }
    }
    .director-reel_media {
      position: absolute;
      inset: 0;
      opacity: 0;
      transition: opacity var(--duration-slow) var(--ease-out);
      &.is-active {
        opacity: 1;
      }
      & img,
      & video {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      @media (prefers-reduced-motion: reduce) {
        transition-duration: var(--duration-fast);
      }
    }
    /* the Figma's 20 % black over the film, and a shade at its foot for the line */
    .director-reel_shade {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(to top, color-mix(in srgb, var(--black) 45%, transparent), transparent 35%),
        color-mix(in srgb, var(--black) 20%, transparent);
    }
    .director-reel_list {
      position: relative;
      margin-top: -100svh;
    }
    /* a screen under the opening, a screen under the other directors */
    .director-reel_space {
      height: 100svh;
    }
    .director-reel_wrap.is-alone {
      margin-block: 0;
      & .director-reel_space {
        display: none;
      }
    }
    /* The gradients the scroll draws over the film, 90 % of a screen each: the opening's colour into the film (the
       colour's own ground through an eased mask), and after the last project's line and a breath (the last film's
       third of a screen), the film into the section's ground, dark, or the colour the directors list paints it */
    .director-reel_fade {
      height: 90svh;
      &.is-in {
        background-color: var(--_colour);
        mask-image: linear-gradient(to bottom, var(--_eased));
      }
      &.is-out {
        margin-top: 30svh;
        background-color: var(--background);
        mask-image: linear-gradient(to top, var(--_eased));
        transition: background-color var(--paint-duration, 0s) var(--ease-travel);
      }
    }
    .director-reel_slot {
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      height: 100svh;
      padding-bottom: var(--space-7);
    }
    /* the first project's line comes in half a screen sooner, while the colour is still dissolving (Sam, Nov 12:
       « amener le bloc Factor plus tôt ») */
    .director-reel_fade.is-in + .director-reel_slot {
      height: 50svh;
    }
    .director-reel_line {
      row-gap: var(--space-5);
      align-items: start;
      color: var(--text);
    }
    .director-reel_title {
      grid-column: margin / span 3;
      display: flex;
      align-items: flex-start;
      gap: var(--space-3);
      @media (width >= 64rem) {
        grid-column: margin / half;
      }
    }
    button.director-reel_title {
      text-align: start;
      transition: color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          color: var(--text-2);
        }
      }
    }
    .director-reel_icon {
      flex: none;
      width: 1.2em;
      height: 1.3em;
      margin-top: -0.12em;
      fill: currentColor;
    }
    .director-reel_title {
      @media (48rem <= width < 64rem) {
        grid-column: margin / span 3;
      }
    }
    .director-reel_client {
      grid-column: margin / span 2;
      @media (width >= 48rem) {
        grid-column: 4 / span 2;
      }
      @media (width >= 64rem) {
        grid-column: half / span 3;
      }
    }
    .director-reel_agency {
      grid-column: three / end;
      @media (width >= 48rem) {
        grid-column: 6 / span 2;
      }
      @media (width >= 64rem) {
        grid-column: aside / span 2;
      }
    }
    .director-reel_year {
      grid-column: last;
      grid-row: 1;
      @media (width >= 48rem) {
        grid-row: auto;
      }
    }
    .director-reel_key {
      color: var(--text-2);
    }
    /* The player */
    .director-reel_player {
      width: 100%;
      max-width: none;
      height: 100%;
      max-height: none;
      margin: 0;
      padding: 0;
      border: 0;
      background-color: var(--black);
      color: var(--text);
      &::backdrop {
        background-color: var(--black);
      }
      &[open] {
        animation: director-reel-in var(--duration-medium) var(--ease-out);
      }
    }
    @keyframes director-reel-in {
      from {
        opacity: 0;
      }
    }
    .director-reel_movie {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      &.is-vertical {
        object-fit: contain;
      }
    }
    .director-reel_close {
      position: absolute;
      top: var(--site-margin);
      right: var(--site-margin);
      color: var(--text);
    }
    .director-reel_bar {
      position: absolute;
      inset: auto 0 0;
      padding-bottom: var(--space-7);
      row-gap: var(--space-rule);
    }
    .director-reel_progress {
      grid-column: margin / end;
      position: relative;
      height: var(--border-width);
      background-color: color-mix(in srgb, var(--text) var(--tone-muted), transparent);
    }
    .director-reel_elapsed {
      position: absolute;
      inset: auto 0 0;
      height: 6px;
      background-color: var(--text);
      transform-origin: left;
      scale: 0 1;
    }
    .director-reel_toggle {
      grid-column: margin / end;
      display: flex;
      align-items: center;
      gap: var(--space-4);
      justify-self: start;
      color: var(--text);
      & svg {
        width: 1em;
        height: 1.3em;
        fill: currentColor;
      }
      & .is-play {
        display: none;
      }
      &.is-paused .is-play {
        display: inline;
      }
      &.is-paused .is-pause {
        display: none;
      }
    }
  }
</style>
