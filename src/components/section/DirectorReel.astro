---
/* A director's reel, told by the scroll (Sam, Nov 11, the Figma's note: « the video player is sticky and the bottom bar
   scrolls »; Nov 12: « plus immersif, scrollytelling, mieux intégré »). The page's colour runs on from the opening;
   a ball rises into it carrying the film and grows until the film fills the screen. The film then holds the screen
   while each project's line (play, title, client, agency, year) scrolls up over it, one screen apart, the film
   cross-fading to that project's as its line comes in. After the last project the ball shrinks away upward and
   leaves the page's dark, where the other directors follow. A project with a film file plays it (muted, looping) and
   its line opens the player; until the files are in, its still stands in. */
import Img from "@/components/media/Img.astro";
import { img, type Item } from "@/utils/content.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The director's films, in their order. */
  projects: Item<"projects">[];
  /** The page's colour, which the ball rises into (the director's). */
  colour?: "red" | "mustard" | "teal";
}

const { render = true, projects, colour = "red" } = Astro.props;
---

{
  render && projects.length > 0 && (
    <section
      class="director-reel_wrap theme-dark"
      style={`--_colour: var(--${colour})`}
      data-op-section="DirectorReel"
      data-op-list="projects"
      data-op-source="astro:projects"
    >
      <div class="director-reel_stage">
        <div class="director-reel_ball" aria-hidden="true">
          <div class="director-reel_film">
            {projects.map((p, i) => (
              <div class:list={["director-reel_media", i === 0 && "is-active"]} data-index={i}>
                {p.data.still && (
                  <Img {...img(p.data.still)} alt="" variant="full-width" loading={i === 0 ? "eager" : "lazy"} />
                )}
                {p.data.video && <video class="director-reel_video" src={p.data.video} muted loop playsinline preload="none" />}
              </div>
            ))}
            <div class="director-reel_shade" />
          </div>
        </div>
      </div>
      <ol class="director-reel_list">
        <li class="director-reel_slot is-space" aria-hidden="true" />
        {projects.map((p, i) => (
          <li class="director-reel_slot" data-op-item={p.id} data-index={i} data-vertical={p.data.vertical ? "true" : undefined}>
            <div class="director-reel_line site-grid rule-top text-style-main">
              {p.data.video ? (
                <button class="director-reel_title" type="button" data-play={i} aria-label={`Play ${p.data.name}`}>
                  <svg class="director-reel_icon" viewBox="0 0 22 24" aria-hidden="true">
                    <path d="M0 0l22 12L0 24z" />
                  </svg>
                  <span data-op-field="name">{p.data.name}</span>
                </button>
              ) : (
                <p class="director-reel_title">
                  <svg class="director-reel_icon" viewBox="0 0 22 24" aria-hidden="true">
                    <path d="M0 0l22 12L0 24z" />
                  </svg>
                  <span data-op-field="name">{p.data.name}</span>
                </p>
              )}
              {p.data.client && (
                <p class="director-reel_client">
                  <span class="director-reel_key">Client</span>
                  <br />
                  <span data-op-field="client">{p.data.client}</span>
                </p>
              )}
              {p.data.agency && (
                <p class="director-reel_agency">
                  <span class="director-reel_key">Agency</span>
                  <br />
                  <span data-op-field="agency">{p.data.agency}</span>
                </p>
              )}
              {p.data.year && (
                <p class="director-reel_year">
                  <span class="director-reel_key">Year</span>
                  <br />
                  <span data-op-field="year">{p.data.year}</span>
                </p>
              )}
            </div>
          </li>
        ))}
        <li class="director-reel_slot is-space" aria-hidden="true" />
      </ol>
      <dialog class="director-reel_player theme-dark" aria-label="Film">
        <video class="director-reel_movie" playsinline />
        <button class="director-reel_close text-style-large" type="button">Close</button>
        <div class="director-reel_bar site-grid text-style-main">
          <div class="director-reel_progress" aria-hidden="true">
            <span class="director-reel_elapsed" />
          </div>
          <button class="director-reel_toggle" type="button" aria-label="Pause">
            <svg viewBox="0 0 16 22" aria-hidden="true">
              <path class="is-pause" d="M0 0h5v22H0zM11 0h5v22h-5z" />
              <path class="is-play" d="M0 0l16 11L0 22z" />
            </svg>
            <span class="director-reel_now" />
          </button>
        </div>
      </dialog>
    </section>
  )
}

<script>
  import { onPage } from "@/utils/page.ts";

  const clamp = (t: number) => Math.min(1, Math.max(0, t));
  // smoothstep: the ball eases into its growth and out of it, the scroll still the clock
  const ease = (t: number) => t * t * (3 - 2 * t);

  onPage((signal) => {
    document.querySelectorAll<HTMLElement>(".director-reel_wrap").forEach((wrap) => {
      const stage = wrap.querySelector<HTMLElement>(".director-reel_stage");
      const ball = wrap.querySelector<HTMLElement>(".director-reel_ball");
      const film = wrap.querySelector<HTMLElement>(".director-reel_film");
      const media = [...wrap.querySelectorAll<HTMLElement>(".director-reel_media")];
      const slots = [...wrap.querySelectorAll<HTMLElement>(".director-reel_slot:not(.is-space)")];
      const reduce = matchMedia("(prefers-reduced-motion: reduce)");
      if (!stage || !ball || !film) return;

      /* The film behind (job: show the project whose line is on screen): the last line wholly in from the bottom wins;
         its layer fades in over the others (slow), its film plays, the others pause */
      let active = -1;
      const play = (i: number) => {
        media.forEach((m, k) => {
          m.classList.toggle("is-active", k === i);
          const video = m.querySelector<HTMLVideoElement>("video");
          if (!video) return;
          if (k === i && !reduce.matches) {
            video.preload = "auto";
            video.play().catch(() => {});
          } else video.pause();
        });
      };

      /* The ball (job: carry the reader from the page's colour into the film, and out to the dark): a circle as wide
         as the screen's diagonal, scaled, the film inside counter-scaled so it stays still while the ball reveals it.
         It grows from a tenth, low in the screen, to the whole screen while the reel's top travels from 60 % down the
         screen to 85 % of a screen past its top; holds; after the last project shrinks to nothing on its way up. The
         stage turns dark once the film covers it. Transform only, from the scroll; with reduced motion the film simply
         fills the stage. */
      let top = 0;
      let height = innerHeight;
      const measure = () => {
        height = innerHeight;
        top = wrap.getBoundingClientRect().top + window.scrollY;
        ball.style.setProperty("--_d", `${Math.hypot(innerWidth, height)}px`);
      };
      const place = () => {
        const y = window.scrollY - top;
        const n = slots.length;
        let scale = 1;
        let centre = 0.5;
        if (!reduce.matches) {
          if (y < height * 0.85) {
            const t = ease(clamp((y + height * 0.6) / (height * 1.45)));
            scale = 0.1 + 0.9 * t;
            centre = 0.78 - 0.28 * t;
          } else if (y > height * n) {
            // done as the stage lets go (the last space is 70 % of a screen)
            const t = ease(clamp((y - height * n) / (height * 0.7)));
            scale = 1 - t;
            centre = 0.5 - 0.3 * t;
          }
        }
        const lift = (centre - 0.5) * height;
        const s = Math.max(scale, 0.001);
        ball.style.transform = `translate3d(0, ${lift.toFixed(1)}px, 0) scale(${s.toFixed(4)})`;
        film.style.transform = `scale(${(1 / s).toFixed(4)}) translate3d(0, ${(-lift).toFixed(1)}px, 0)`;
        ball.style.visibility = scale < 0.01 ? "hidden" : "";
        stage.classList.toggle("is-dark", y > height * 0.85);
        let found = 0;
        slots.forEach((slot, i) => {
          const bar = slot.querySelector<HTMLElement>(".director-reel_line");
          if (bar && bar.getBoundingClientRect().bottom <= innerHeight) found = i;
        });
        if (found !== active) {
          active = found;
          play(active);
        }
      };
      measure();
      place();
      let frame = 0;
      const tick = () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(place);
      };
      window.addEventListener("scroll", tick, { passive: true, signal });
      window.addEventListener(
        "resize",
        () => {
          measure();
          tick();
        },
        { signal },
      );
      // the page's pictures above settle their height once loaded: measure again then
      window.addEventListener("load", () => (measure(), tick()), { once: true, signal });
      reduce.addEventListener("change", tick, { signal });

      /* The player (job: watch a film whole): its line opens it over everything, the film plays with its sound, the
         rule fills as it plays, a click or the button pauses, Close or Escape leaves */
      const dialog = wrap.querySelector<HTMLDialogElement>(".director-reel_player");
      const movie = dialog?.querySelector<HTMLVideoElement>(".director-reel_movie");
      const toggle = dialog?.querySelector<HTMLButtonElement>(".director-reel_toggle");
      const now = dialog?.querySelector<HTMLElement>(".director-reel_now");
      const elapsed = dialog?.querySelector<HTMLElement>(".director-reel_elapsed");
      const sync = () => {
        if (!movie || !toggle) return;
        toggle.classList.toggle("is-paused", movie.paused);
        toggle.setAttribute("aria-label", movie.paused ? "Play" : "Pause");
      };
      wrap.addEventListener(
        "click",
        (event) => {
          const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-play]");
          if (!button || !dialog || !movie) return;
          const i = Number(button.dataset.play);
          const source = media[i]?.querySelector<HTMLVideoElement>("video");
          if (!source) return;
          movie.src = source.currentSrc || source.src;
          movie.classList.toggle("is-vertical", slots[i]?.dataset.vertical === "true");
          if (now) now.textContent = button.textContent?.trim() ?? "";
          dialog.showModal();
          movie.play().catch(() => {});
        },
        { signal },
      );
      movie?.addEventListener("click", () => (movie.paused ? movie.play() : movie.pause()), { signal });
      toggle?.addEventListener("click", () => movie && (movie.paused ? movie.play() : movie.pause()), { signal });
      movie?.addEventListener("play", sync, { signal });
      movie?.addEventListener("pause", sync, { signal });
      movie?.addEventListener(
        "timeupdate",
        () => {
          if (movie && elapsed && movie.duration) elapsed.style.scale = `${movie.currentTime / movie.duration} 1`;
        },
        { signal },
      );
      dialog?.querySelector(".director-reel_close")?.addEventListener("click", () => dialog.close(), { signal });
      dialog?.addEventListener(
        "close",
        () => {
          movie?.pause();
          movie?.removeAttribute("src");
          movie?.load();
        },
        { signal },
      );
      signal.addEventListener(
        "abort",
        () => {
          cancelAnimationFrame(frame);
          media.forEach((m) => m.querySelector("video")?.pause());
        },
        { once: true },
      );
    });
  });
</script>

<style is:global>
  @layer components {
    .director-reel_wrap {
      position: relative;
      background-color: transparent;
      /* the rule and the text stay stone over any film */
      --border: var(--text);
    }
    .director-reel_stage {
      position: sticky;
      top: 0;
      height: 100svh;
      overflow: hidden;
      background-color: var(--_colour);
      &.is-dark {
        background-color: var(--black);
      }
    }
    /* the ball: a circle as wide as the screen's diagonal, centred; the film inside as big as the screen, centred */
    .director-reel_ball {
      position: absolute;
      left: 50%;
      top: 50%;
      width: var(--_d, 150vmax);
      aspect-ratio: 1;
      margin-left: calc(var(--_d, 150vmax) / -2);
      margin-top: calc(var(--_d, 150vmax) / -2);
      overflow: hidden;
      border-radius: var(--radius-round);
      will-change: transform;
    }
    .director-reel_film {
      position: absolute;
      left: 50%;
      top: 50%;
      width: 100vw;
      height: 100svh;
      margin-left: -50vw;
      margin-top: -50svh;
      background-color: var(--black);
      will-change: transform;
    }
    .director-reel_media {
      position: absolute;
      inset: 0;
      opacity: 0;
      transition: opacity var(--duration-slow) var(--ease-out);
      &.is-active {
        opacity: 1;
      }
      & img,
      & video {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      @media (prefers-reduced-motion: reduce) {
        transition-duration: var(--duration-fast);
      }
    }
    /* the Figma's 20 % black over the film, and a shade at its foot for the line */
    .director-reel_shade {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(to top, color-mix(in srgb, var(--black) 45%, transparent), transparent 35%),
        color-mix(in srgb, var(--black) 20%, transparent);
    }
    .director-reel_list {
      position: relative;
      margin-top: -100svh;
    }
    .director-reel_slot {
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      height: 100svh;
      padding-bottom: var(--space-7);
      /* the ball's way out: it is gone as the stage lets go, and the other directors come up */
      &.is-space:last-child {
        height: 70svh;
      }
    }
    .director-reel_line {
      row-gap: var(--space-5);
      align-items: start;
      color: var(--text);
    }
    .director-reel_title {
      grid-column: margin / span 3;
      display: flex;
      align-items: flex-start;
      gap: var(--space-3);
      @media (width >= 64rem) {
        grid-column: margin / half;
      }
    }
    button.director-reel_title {
      text-align: start;
      transition: color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          color: var(--text-2);
        }
      }
    }
    .director-reel_icon {
      flex: none;
      width: 1.2em;
      height: 1.3em;
      margin-top: -0.12em;
      fill: currentColor;
    }
    .director-reel_client {
      grid-column: margin / span 2;
      @media (width >= 48rem) {
        grid-column: two / span 2;
      }
      @media (width >= 64rem) {
        grid-column: half / span 3;
      }
    }
    .director-reel_agency {
      grid-column: three / end;
      @media (width >= 48rem) {
        grid-column: aside / span 1;
      }
      @media (width >= 64rem) {
        grid-column: aside / span 2;
      }
    }
    .director-reel_year {
      grid-column: last;
      grid-row: 1;
      @media (width >= 48rem) {
        grid-row: auto;
      }
    }
    .director-reel_key {
      color: var(--text-2);
    }
    /* The player */
    .director-reel_player {
      width: 100%;
      max-width: none;
      height: 100%;
      max-height: none;
      margin: 0;
      padding: 0;
      border: 0;
      background-color: var(--black);
      color: var(--text);
      &::backdrop {
        background-color: var(--black);
      }
      &[open] {
        animation: director-reel-in var(--duration-medium) var(--ease-out);
      }
    }
    @keyframes director-reel-in {
      from {
        opacity: 0;
      }
    }
    .director-reel_movie {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      &.is-vertical {
        object-fit: contain;
      }
    }
    .director-reel_close {
      position: absolute;
      top: var(--site-margin);
      right: var(--site-margin);
      color: var(--text);
    }
    .director-reel_bar {
      position: absolute;
      inset: auto 0 0;
      padding-bottom: var(--space-7);
      row-gap: var(--space-rule);
    }
    .director-reel_progress {
      grid-column: margin / end;
      position: relative;
      height: var(--border-width);
      background-color: color-mix(in srgb, var(--text) var(--tone-muted), transparent);
    }
    .director-reel_elapsed {
      position: absolute;
      inset: auto 0 0;
      height: 6px;
      background-color: var(--text);
      transform-origin: left;
      scale: 0 1;
    }
    .director-reel_toggle {
      grid-column: margin / end;
      display: flex;
      align-items: center;
      gap: var(--space-4);
      justify-self: start;
      color: var(--text);
      & svg {
        width: 1em;
        height: 1.3em;
        fill: currentColor;
      }
      & .is-play {
        display: none;
      }
      &.is-paused .is-play {
        display: inline;
      }
      &.is-paused .is-pause {
        display: none;
      }
    }
  }
</style>
