---
/* The curve that closes a page above the footer: ES Build's « u » blown up and turned, in black, over the page's own
   colour, with the ball caught in it. The Figma draws it differently on each page (variant): on Home a red ground
   with the « u » opening left and the CTA inside its lower stem; on News and Contact the page's own ground with an
   outline of the « u » opening to one side. Geometry in the Figma's units (1728 wide), measured on each page and
   scaled with the page's width; the band's foot meets the footer's curve (28 apart on News and Contact). */
import ArrowLink from "@/components/content/ArrowLink.astro";
import tracks from "@/data/curve-tracks.json";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Which page's drawing. */
  variant?: "home" | "news" | "contact";
}

const { render = true, variant = "home" } = Astro.props;

/* Each drawing: its height, the black shapes (a path and its offset), the ball where it rests (centre and radius, as
   the Figma renders it: the PDF export), the ground (whether the band paints the page's colour itself), how far it
   rises behind the section before it on a computer (rise) and on a tablet (riseTablet; Home's no longer does, Nov 11:
   its directors turn to a colour, which the curve's black must not run behind), and when the ball travels: it
   leaves the start of its track when that point is `startAt` down the screen, passes where the Figma rests it, and
   has left the frame by the other edge when its exit is `endAt` down (Sam, Nov 12). The tracks (the stroke's centre
   line, the ball's radius along it) come from system/curve-tracks.py. */
const art = {
  home: {
    height: 1709,
    ground: true,
    rise: 0,
    riseTablet: 0,
    shapes: [
      {
        y: -226.84,
        d: "M1852.96 949.314C1848.7 336.304 1465.57 0 924.931 0L-194.663 0L-194.663 587.468L882.361 587.468C1163.32 587.468 1337.86 710.921 1342.12 949.314C1346.38 1208.99 1171.84 1319.67 886.618 1319.67L-194.663 1319.67L-194.663 1907.14L929.188 1907.14C1444.29 1907.14 1857.22 1511.24 1852.96 949.314Z",
      },
      { y: 0, d: "M1121.51 0H1728V317.88H1121.51Z" },
    ],
    ball: { cx: 1167, cy: 1342, r: 276 },
    startAt: 0.95,
    endAt: 0.35,
  },
  news: {
    height: 1935.5,
    ground: false,
    rise: 1260,
    riseTablet: 0,
    shapes: [
      {
        y: 0,
        d: "M2265.01 957.828C2260.76 1570.84 1877.63 1907.14 1336.99 1907.14L-39.7122 1907.14L-39.7122 1319.67L1294.42 1319.67C1575.38 1319.67 1749.92 1196.22 1754.17 957.828C1758.43 698.15 2143.2 587.468 1857.98 587.468L1791.58 587.468L1791.58 0L1900.55 0C2415.65 0 2269.27 395.902 2265.01 957.828Z",
      },
    ],
    ball: { cx: 1123.5, cy: 1610.8, r: 273 },
    startAt: 1,
    endAt: 0.35,
  },
  contact: {
    height: 1935.5,
    ground: false,
    rise: 991,
    riseTablet: 0,
    shapes: [
      {
        y: 0,
        d: "M-524.684 957.828C-520.427 1570.84 -137.295 1907.14 403.345 1907.14L1780.04 1907.14L1780.04 1319.67L445.916 1319.67C164.953 1319.67 -9.58459 1196.22 -13.8417 957.828C-18.0987 698.15 -402.872 587.468 -117.652 587.468L-51.2505 587.468L-51.2505 0L-160.223 0C-675.321 0 -528.941 395.902 -524.684 957.828Z",
      },
    ],
    ball: { cx: 1556.5, cy: 1612.3, r: 273 },
    startAt: 1.1,
    endAt: 0.35,
  },
}[variant];
const track = tracks[variant].points;
---

{
  render && (
    <section
      class:list={["curve-band_wrap", `is-${variant}`]}
      style={`--_h: ${art.height}; --_rise: ${art.rise}; --_rise-tablet: ${art.riseTablet};`}
      data-op-section="CurveBand"
    >
      {variant === "home" && (
        <div class="curve-band_content site-grid">
          <h2 class="curve-band_title text-style-h3">Off the usual playbook? Tell us, we'll find who was made for it.</h2>
          <ArrowLink class="curve-band_link" href="/contact" text="Start a conversation" />
        </div>
      )}
      <div class="curve-band_art" aria-hidden="true">
        <svg class="curve-band_drawing" viewBox={`0 0 1728 ${art.height}`} focusable="false">
          {art.ground && <rect class="curve-band_ground" width="1728" height={art.height} />}
          {art.shapes.map((s) => (
            <path class="curve-band_shape" d={s.d} transform={s.y ? `translate(0 ${s.y})` : undefined} />
          ))}
        </svg>
        <svg
          class="curve-band_layer"
          viewBox={`0 0 1728 ${art.height}`}
          focusable="false"
          data-track={JSON.stringify(track)}
          data-start-at={art.startAt}
          data-end-at={art.endAt}
        >
          <circle class="curve-band_ball" cx={art.ball.cx} cy={art.ball.cy} r={art.ball.r} />
        </svg>
      </div>
    </section>
  )
}

<script>
  /* The ball travels through its curve as the page scrolls (Sam, Nov 11: « qu'au scroll down, la boule voyage à travers
     sa shape »; Nov 12: « all the way, même sortir du cadre »): along the stroke's centre line, filling it by the
     share the Figma gives it at rest (a little smaller round a bend), from beyond the frame to where the Figma rests
     it.
     Scrubbed: the scroll is the curve, smoothed a little on top of Lenis. The markup shows the ball at rest: without
     JS or with reduced motion it simply sits there. */
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { onPage } from "@/utils/page.ts";
  import { scrollTriggerWithLenis } from "@/utils/smooth-scroll.ts";

  gsap.registerPlugin(ScrollTrigger);
  scrollTriggerWithLenis(gsap, ScrollTrigger);

  onPage((signal) => {
    const mm = gsap.matchMedia();
    mm.add("(prefers-reduced-motion: no-preference)", () => {
      const undo: (() => void)[] = [];
      document.querySelectorAll<SVGSVGElement>(".curve-band_art svg[data-track]").forEach((svg) => {
        const ball = svg.querySelector<SVGCircleElement>(".curve-band_ball");
        const track = JSON.parse(svg.dataset.track ?? "[]") as number[];
        const count = track.length / 3;
        if (!ball || count < 2) return;
        const startAt = Number(svg.dataset.startAt ?? 0.8);
        const endAt = Number(svg.dataset.endAt ?? 0.6);
        const rest = (["cx", "cy", "r"] as const).map((a) => ball.getAttribute(a) ?? "");
        const height = svg.viewBox.baseVal.height;
        const box = () => svg.getBoundingClientRect();
        // a point of the track (in the drawing's units) as a scroll position: when it sits `at` down the screen
        const scrollFor = (y: number, at: number) => {
          const r = box();
          return r.top + window.scrollY + (y / height) * r.height - window.innerHeight * at;
        };
        const place = (p: number) => {
          const f = Math.min(Math.max(p, 0), 1) * (count - 1);
          const i = Math.min(Math.floor(f), count - 2);
          const t = f - i;
          const a = i * 3;
          const b = a + 3;
          ball.setAttribute("cx", (track[a] + (track[b] - track[a]) * t).toFixed(1));
          ball.setAttribute("cy", (track[a + 1] + (track[b + 1] - track[a + 1]) * t).toFixed(1));
          ball.setAttribute("r", (track[a + 2] + (track[b + 2] - track[a + 2]) * t).toFixed(1));
        };
        const state = { p: 0 };
        place(0);
        gsap.to(state, {
          p: 1,
          ease: "none",
          onUpdate: () => place(state.p),
          scrollTrigger: {
            trigger: svg,
            start: () => scrollFor(track[1], startAt),
            end: () => scrollFor(track[(count - 1) * 3 + 1], endAt),
            scrub: 0.5,
            invalidateOnRefresh: true,
          },
        });
        undo.push(() => {
          ball.setAttribute("cx", rest[0]);
          ball.setAttribute("cy", rest[1]);
          ball.setAttribute("r", rest[2]);
        });
      });
      return () => undo.forEach((u) => u());
    });
    signal.addEventListener("abort", () => mm.revert(), { once: true });
  });
</script>

<style is:global>
  @layer components {
    .curve-band_wrap {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: var(--section-space-small);
    }
    .curve-band_art {
      position: relative;
      aspect-ratio: 1728 / var(--_h);
      & svg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
      }
      /* the ball on its own layer, free of the drawing's frame: it travels all the way and may leave it (Sam, Nov 12),
         never cut by a section's edge. Under the directors' names it passes behind them (their section has no ground
         of its own: the page's colour is behind both) */
      & .curve-band_layer {
        z-index: 0;
        overflow: visible;
        pointer-events: none;
      }
    }
    .curve-band_ground {
      fill: var(--page-accent);
    }
    .curve-band_shape {
      fill: var(--black);
    }
    /* on Home the « u » is the page's own ground showing through the red, so it takes the colour the directors list
       gives the page, with the rest (Sam, Nov 12: no seam between the list and the curve) */
    .curve-band_wrap.is-home .curve-band_shape {
      fill: var(--background);
      transition: fill var(--paint-duration, 0s) var(--ease-travel);
    }
    .curve-band_ball {
      fill: var(--page-accent);
    }
    .curve-band_content {
      position: relative;
      z-index: 1;
      row-gap: var(--space-9);
      padding-top: var(--section-space-medium);
      color: var(--heading-accent);
    }
    .curve-band_title {
      grid-column: margin / end;
      max-width: 24ch;
    }
    .curve-band_link {
      grid-column: margin / end;
      justify-self: start;
    }
    /* From a tablet up, the CTA sits inside the « u »'s lower stem, as the Figma draws it (its cap top 1283 down
       the band, 600 wide), and the band rises behind the section before it. Home's starts 110 lower: its ball, as it
       rolls in along the top stem, rises 218 above the band and only grazes the last director's name (Sam, Nov 12:
       « elle peut embarquer un petit peu, mais pas trop ») */
    @media (width >= 48rem) {
      .curve-band_wrap {
        display: block;
        margin-top: calc(var(--u) * var(--_rise-tablet) * -1);
        @media (width >= 64rem) {
          margin-top: calc(var(--u) * var(--_rise) * -1);
        }
        &.is-home {
          margin-top: calc(var(--u) * 110);
        }
      }
      .curve-band_content {
        position: absolute;
        inset: 0 0 auto;
        padding-top: calc(var(--u) * 1283);
      }
      .curve-band_title {
        max-width: calc(var(--u) * 600);
      }
      /* inside the stroke, which is the page's ground: taupe on the dark, black on a director's colour */
      .curve-band_content {
        color: var(--heading-accent);
      }
    }
  }
</style>
