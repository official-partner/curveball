---
/* Home's opening: the featured films (the list « featured-work » of src/data/lists.json names them; each one's cover video over its still) across
   the screen under the wordmark, darker towards the foot (30 % black, then a fade to the page's ground), and the featured work's row at the foot of the first screen.
   The wordmark runs margin to margin (its own drawing measures the Figma's « curveball » exactly: 1664 x 315.6 at
   1728). The featured work turns by itself (Sam, Nov 12: « créer l'anim switch hero visuel et numéros, smooth anim
   switch counter entre les numéros »): each one holds the screen six seconds while the row's rule fills, then the next
   still fades in over it as it settles, the client and agency cross-fade, and the counter rolls to its number. The
   counter is the pause; a hover or a focus in the row pauses it too, and it waits while the opening is off screen or
   the tab hidden. With reduced motion it does not turn by itself.
   Leaving it is told like a director's reel (Sam, Nov 12: « une anim similaire à la page director ... le visuel du
   hero fixed, parallax, gradient, transition smooth, beaucoup plus d'espace entre Featured work et Directors »): the
   stills are fixed behind the page, seen only within the opening (its clip-path), the wordmark and the row scroll up
   over them, then a screen-tall eased gradient draws the page's ground up over them while they drift up at their own
   pace, and the directors follow on that ground.
   The row names the film on screen, its triangle before it (Sam, Nov 27, comment 54: « mettre le nom du projet et
   bouton play, et pouvoir play le projet sur le hero aussi »): its title plays the film whole, over the opening, as a
   reel does (DirectorReel). */
import Wordmark from "@/assets/logo/logo.svg";
import Img from "@/components/media/Img.astro";
import FilmControls from "@/components/media/FilmControls.astro";
import PlayTitle from "@/components/content/PlayTitle.astro";
import { img } from "@/utils/content.ts";
import { listed, ruleMarks } from "@/utils/lists.ts";
import { SITE_NAME } from "@/consts.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true } = Astro.props;
/* the featured films: the list « featured-work », its rule in src/data/lists.json (picked by hand, in that order),
   which OP System's List options changes itself; each one's short version behind the opening, its film whole when it
   is played */
const featured = (await listed<"projects">("featured-work")).map(({ id, data }) => {
  const { name, client, agency, still, preview, cover, video } = data;
  return { id, name, client, agency, still, film: preview || cover || video, whole: video || cover };
});
const count = featured.length;
---

{
  render && (
    <section class="hero-home_wrap theme-dark" data-paint="theme-dark" data-op-section="HeroHome">
      <div class="hero-home_media" aria-hidden="true">
        <div class="hero-home_drift">
        {featured.map((f, i) => (
          <div class:list={["hero-home_still", i === 0 && "is-active"]}>
            {f.still && (
              <Img
                class="hero-home_img"
                {...img(f.still)}
                alt=""
                variant="full-width"
                loading={i === 0 ? "eager" : "lazy"}
                fetchPriority={i === 0 ? "high" : "low"}
              />
            )}
            {f.film && (
              <video class="hero-home_film" src={f.film} data-whole={f.whole} muted loop playsinline preload={i === 0 ? "auto" : "none"} />
            )}
          </div>
        ))}
        </div>
      </div>
      {/* the film itself, whole, over the stills and their shades while it is watched (the script gives it its file) */}
      <div class="hero-home_movie" aria-hidden="true">
        <video class="cover-absolute object-fit-contain" playsinline preload="none" />
      </div>
      <div class="hero-home_layout site-grid">
        <h1 class="hero-home_title" data-page-reveal>
          <Wordmark class="hero-home_wordmark logo-art" aria-hidden="true" />
          <span class="sr-only">{SITE_NAME}</span>
        </h1>
        <div class="hero-home_row rule-top" data-page-reveal>
          <span class="hero-home_time" aria-hidden="true" />
          <span class="hero-home_seek" aria-hidden="true" />
          <ol class="hero-home_slides" aria-label="Featured work" {...ruleMarks("featured-work")}>
            {featured.map((f, i) => (
              <li class:list={["hero-home_slide text-style-main", i === 0 && "is-active"]} data-op-item={f.id} inert={i !== 0}>
                <PlayTitle class="hero-home_name" name={f.name} play={f.whole ? i : undefined} />
                {f.client && (
                  <p class="hero-home_client">
                    <span class="hero-home_key">Client</span>
                    <br />
                    <span data-op-field="client">{f.client}</span>
                  </p>
                )}
                {f.agency && (
                  <p class="hero-home_agency">
                    <span class="hero-home_key">Agency</span>
                    <br />
                    <span data-op-field="agency">{f.agency}</span>
                  </p>
                )}
              </li>
            ))}
          </ol>
          <button class="hero-home_count text-style-main" type="button" aria-label="Pause the featured work" disabled={count < 2}>
            <span class="hero-home_now" aria-hidden="true">
              <span class="hero-home_digits">
                {[...featured.map((_, i) => i + 1), 1].map((n) => (
                  <span>{n}</span>
                ))}
              </span>
            </span>
            <span aria-hidden="true">&nbsp;— {count}</span>
          </button>
        </div>
      </div>
      <div class="hero-home_fade" aria-hidden="true" />
      <FilmControls />
    </section>
  )
}

<script>
  import { onPage } from "@/utils/page.ts";
  import { pageLenis } from "@/utils/smooth-scroll.ts";

  /* The featured work turning (job: show the studio's range, one film at a time). Each holds six seconds, its time
     the row's rule filling (linear); then the next still fades in over the last (slow, ease-out) as it settles from
     104 % (on the arrive curve), its client and agency cross-fade (medium) and the counter's digit rolls up to its
     number (base, the arrive curve; from the last back to the first it rolls on to a second « 1 », then sits back at
     the top unseen). It pauses while the row is hovered or holds the focus, while the opening is off screen and while
     the tab is hidden; the counter pauses and plays it. With reduced motion it waits for the counter. */
  const HOLD = 6000;

  onPage((signal) => {
    document.querySelectorAll<HTMLElement>(".hero-home_wrap").forEach((wrap) => {
      const stills = [...wrap.querySelectorAll<HTMLElement>(".hero-home_still")];
      const drift = wrap.querySelector<HTMLElement>(".hero-home_drift");
      const fade = wrap.querySelector<HTMLElement>(".hero-home_fade");
      const slides = [...wrap.querySelectorAll<HTMLElement>(".hero-home_slide")];
      const row = wrap.querySelector<HTMLElement>(".hero-home_row");
      const time = wrap.querySelector<HTMLElement>(".hero-home_time");
      const button = wrap.querySelector<HTMLButtonElement>(".hero-home_count");
      const digits = wrap.querySelector<HTMLElement>(".hero-home_digits");
      const reduce = matchMedia("(prefers-reduced-motion: reduce)");
      const n = slides.length;

      /* Leaving the opening (job: carry the eye from the films down to the directors, with depth): while the gradient
         rises over the fixed stills, they rise slower than the scroll, 24 % of a screen as they grow 6 % from their
         top (a parallax, the reel's own travel on a director's page since Sam's comment 13: « bcp plus de parallax,
         movement sur Y de bas en haut, différente vitesse que le scroll »), scrubbed by the scroll, from the
         gradient's top at the screen's foot to its foot at the top. Their foot, faded out, stays under the ground's
         two gradients (the media's own and the rising one, together at least 97 % there), so no edge shows and the
         opening keeps the design's framing. Transform only; none with reduced motion. */
      if (drift && fade) {
        let frame = 0;
        const place = () => {
          const box = fade.getBoundingClientRect();
          const p = Math.min(1, Math.max(0, (innerHeight - box.top) / (innerHeight + box.height)));
          drift.style.transform = reduce.matches ? "" : `translate3d(0, ${(-24 * p).toFixed(2)}svh, 0) scale(${(1 + 0.06 * p).toFixed(4)})`;
        };
        const tick = () => {
          cancelAnimationFrame(frame);
          frame = requestAnimationFrame(place);
        };
        place();
        window.addEventListener("scroll", tick, { passive: true, signal });
        window.addEventListener("resize", tick, { signal });
        reduce.addEventListener("change", tick, { signal });
        signal.addEventListener("abort", () => cancelAnimationFrame(frame), { once: true });
      }

      if (!row || !time || !button || !digits) return;

      let current = 0;
      let stopped = reduce.matches;
      let held = false;
      let away = false;
      let watching = -1;
      const fill = time.animate([{ scale: "0 1" }, { scale: "1 1" }], { duration: HOLD, easing: "linear", fill: "both" });
      fill.pause();

      /* The films (job: show the work moving): the active one plays, muted, while the opening is on screen and the
         tab shown; the counter's pause stops it with the turning, and it never plays with reduced motion. Its still
         shows under it until its first frame is in. The first loads with the page and the next one while the
         current plays (Sam, Nov 17: « starter les vidéos un peu plus tôt »), so a film is already moving as it
         fades in. Once a film is watched whole, its short version rests under it. */
      const movieBox = wrap.querySelector<HTMLElement>(".hero-home_movie");
      const movie = movieBox?.querySelector<HTMLVideoElement>("video") ?? null;
      const film = () => {
        const on = !stopped && !away && !document.hidden;
        const covered = watching >= 0 && Boolean(movieBox?.classList.contains("is-whole"));
        stills.forEach((s, i) => {
          const video = s.querySelector("video");
          if (!video) return;
          if (on && i === current && !covered) {
            video.preload = "auto";
            video.play().catch(() => {});
          } else {
            video.pause();
            if (on && i === (current + 1) % n) video.preload = "auto";
          }
        });
      };
      const roll = (to: number, instant = false) => {
        digits.style.transition = instant ? "none" : "";
        digits.style.translate = `0 ${-to * 1.2}em`;
        if (instant) void digits.offsetHeight;
      };
      const show = async (next: number) => {
        const still = stills[next];
        // the next still decoded first, so it never fades in empty
        const picture = still?.querySelector("img");
        // its film starts under the last one, so it is moving when it fades in
        if (!stopped) still?.querySelector("video")?.play().catch(() => {});
        await picture?.decode().catch(() => {});
        if (watching >= 0) return;
        const last = stills[current];
        last?.classList.add("is-leaving");
        stills.forEach((s, i) => s.classList.toggle("is-active", i === next));
        // once the next is in, the last one leaves from under it
        window.setTimeout(() => last?.classList.remove("is-leaving"), 1300);
        slides.forEach((s, i) => {
          s.classList.toggle("is-active", i === next);
          // only the one shown takes a click or the focus (they sit in one cell)
          s.inert = i !== next;
        });
        if (next === 0) {
          // past the last: on to the second « 1 », then back to the top unseen
          roll(n);
          window.setTimeout(() => current === 0 && roll(0, true), 900);
        } else roll(next);
        current = next;
        fill.currentTime = 0;
        run();
        label();
      };
      const run = () => {
        // the featured one's time starts once the home's intro has handed over (HomeIntro.astro); a film watched
        // holds it, its rule then the film's time
        const play = n > 1 && watching < 0 && !stopped && !held && !away && !document.hidden && !document.documentElement.dataset.intro;
        if (play) fill.play();
        else fill.pause();
        film();
        button.setAttribute("aria-label", stopped ? "Play the featured work" : "Pause the featured work");
        button.classList.toggle("is-stopped", stopped);
      };
      // its time run out, the next one (never while stopped: a screenshot that settles every animation, say)
      fill.onfinish = () => !stopped && watching < 0 && show((current + 1) % n);

      button.addEventListener(
        "click",
        () => {
          stopped = !stopped;
          run();
        },
        { signal },
      );
      row.addEventListener("pointerenter", (e) => e.pointerType === "mouse" && ((held = true), run()), { signal });
      row.addEventListener("pointerleave", () => ((held = false), run()), { signal });
      row.addEventListener("focusin", () => ((held = true), run()), { signal });
      row.addEventListener("focusout", () => ((held = false), run()), { signal });
      document.addEventListener("visibilitychange", run, { signal });
      document.addEventListener("home-intro:end", run, { signal });
      const seen = new IntersectionObserver(([entry]) => {
        away = !entry.isIntersecting;
        run();
      });
      seen.observe(wrap);
      reduce.addEventListener("change", () => ((stopped = reduce.matches), run()), { signal });

      /* Watching a featured film whole (job: watch it, with its sound, without leaving the opening; Sam, Nov 27,
         comment 54), the way a reel does (DirectorReel): its title plays it. The page goes back to its top if it had
         left it (medium, on the travel's curve) and holds still there; the wordmark, the menu and the counter step
         aside (medium) while the row stays, its rule now the film's time, six times its weight, pressed or dragged
         to move through it, its triangle a pause. The film loads over the short version and fades in once it plays,
         growing from the full screen into its own format (base, the travel's curve). « Close » at the pointer: a
         click, Escape or the film's end leaves, the film growing back and dissolving into its short version, and the
         featured work turns again from that film. Two seconds without the pointer moving and the row and the label
         fade out. Space pauses, the arrows move five seconds. Reduced motion: no growing, the fades shorter. */
      const IDLE = 2000;
      const root = document.documentElement;
      const cursor = wrap.querySelector<HTMLElement>(".film-controls_cursor");
      const word = cursor?.querySelector<HTMLElement>(".film-controls_word") ?? null;
      const closer = wrap.querySelector<HTMLButtonElement>(".film-controls_close");
      const seekBand = wrap.querySelector<HTMLElement>(".hero-home_seek");
      const ms = (name: string) => {
        const v = getComputedStyle(root).getPropertyValue(name).trim();
        return (parseFloat(v) || 0) * (v.endsWith("ms") ? 1 : 1000);
      };
      const title$ = (i: number) => slides[i]?.querySelector<HTMLButtonElement>("[data-play]") ?? null;
      let over: EventTarget | null = null;
      let idle = 0;
      let bar = 0;
      let hold: AbortController | null = null;
      let loading = false;
      let dragging = false;
      /* « Play » follows the pointer over the opening (Sam, Nov 27: « avoir le play en hover qui suit le curseur »),
         « Close » while a film plays, the ring while it loads (over its title too, where nothing else shows that it
         is coming); never over the menu, a button or the rule */
      const label = () => {
        if (!cursor || !word) return;
        const at = over instanceof Element && over.closest(".hero-home_layout") ? over : null;
        const free = Boolean(at) && !at!.closest("button, a, .hero-home_seek");
        const wait = Boolean(at) && watching >= 0 && loading;
        const text = wait ? "Loading" : !free ? "" : watching >= 0 ? "Close" : title$(current) ? "Play" : "";
        if (text) word.textContent = text;
        cursor.classList.toggle("is-loading", wait);
        cursor.classList.toggle("is-on", Boolean(text));
      };
      const wake = () => {
        wrap.classList.remove("is-idle");
        clearTimeout(idle);
        if (watching >= 0 && movie && !movie.paused && !loading && !dragging)
          idle = window.setTimeout(() => wrap.classList.add("is-idle"), IDLE);
      };
      // the film's own format: shown whole (contain); --_cover is how much bigger it is to fill the screen
      const fit = () => {
        if (!movie || !movieBox || !movie.videoWidth || !movieBox.clientHeight) return;
        const screen = movieBox.clientWidth / movieBox.clientHeight;
        const format = movie.videoWidth / movie.videoHeight;
        movie.style.setProperty("--_cover", Math.max(screen / format, format / screen).toFixed(4));
      };
      // the rule follows the film's time (the turning's own animation, held, set to the film's share of it)
      const elapsed = (t: number) => {
        fill.pause();
        fill.currentTime = Math.min(HOLD - 1, Math.max(0, t) * HOLD);
      };
      const tick = () => {
        cancelAnimationFrame(bar);
        if (!movie || watching < 0) return;
        if (movie.duration) elapsed(movie.currentTime / movie.duration);
        if (!movie.paused) bar = requestAnimationFrame(tick);
      };
      const state = () => {
        if (watching < 0 || !movie) return;
        const name = title$(watching)?.textContent?.trim() ?? "";
        slides[watching]?.classList.toggle("is-playing", !movie.paused);
        title$(watching)?.setAttribute("aria-label", `${movie.paused ? "Play" : "Pause"} ${name}`);
        tick();
        wake();
      };
      // the travel's curve, as the scroll eases (an ease in-out)
      const travel = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - (-2 * t + 2) ** 3 / 2);
      const leave = (how: "close" | "gone" = "close") => {
        const i = watching;
        if (i < 0 || !movie) return;
        watching = -1;
        loading = false;
        dragging = false;
        clearTimeout(idle);
        cancelAnimationFrame(bar);
        const still = how === "gone" || reduce.matches;
        const back = still ? 0 : ms("--duration-base");
        const fade = ms("--duration-medium");
        movie.pause();
        if (!still) movieBox?.classList.add("is-closing");
        movieBox?.classList.remove("is-whole");
        wrap.classList.remove("is-watching", "is-idle");
        slides[i]?.classList.remove("is-playing");
        title$(i)?.setAttribute("aria-label", `Play ${title$(i)?.textContent?.trim() ?? ""}`);
        delete root.dataset.watching;
        label();
        // the featured work turns again from this film, its time from the start
        fill.currentTime = 0;
        run();
        const free = () => {
          hold?.abort();
          hold = null;
          pageLenis()?.start();
        };
        if (still) free();
        // the dissolve starts once most of the way back is seen (60 %), and ends a little after it
        const from = back * 0.6;
        window.setTimeout(() => watching < 0 && movieBox?.classList.remove("is-active"), from);
        window.setTimeout(() => {
          if (watching >= 0) return;
          if (!still) free();
          movieBox?.classList.remove("is-closing", "is-active");
          movie.removeAttribute("src");
          movie.load();
        }, from + fade);
      };
      const watch = (i: number) => {
        const source = stills[i]?.querySelector<HTMLVideoElement>("video");
        if (!source?.dataset.whole || !movie || !movieBox) return;
        watching = i;
        loading = true;
        run();
        elapsed(0);
        wrap.classList.add("is-watching");
        root.dataset.watching = "";
        movieBox.classList.remove("is-closing", "is-whole");
        // the page goes back to its top, then holds still (wheel, touch and the scroll keys; Lenis stopped)
        hold?.abort();
        hold = new AbortController();
        const keep = { signal: hold.signal, passive: false } as const;
        const stay = (event: Event) => event.preventDefault();
        window.addEventListener("wheel", stay, keep);
        window.addEventListener("touchmove", stay, keep);
        window.addEventListener("pointermove", wake, { signal: hold.signal });
        window.addEventListener(
          "keydown",
          (event) => {
            const onButton = event.target instanceof Element && event.target.closest("button, a");
            if (event.key === "Escape") leave();
            else if (event.key === " " && !onButton) {
              event.preventDefault();
              if (movie.paused) movie.play().catch(() => {});
              else movie.pause();
            } else if ((event.key === "ArrowLeft" || event.key === "ArrowRight") && movie.duration) {
              movie.currentTime = Math.min(movie.duration, Math.max(0, movie.currentTime + (event.key === "ArrowLeft" ? -5 : 5)));
              tick();
            } else if (["ArrowUp", "ArrowDown", "PageUp", "PageDown", "Home", "End"].includes(event.key)) event.preventDefault();
            wake();
          },
          { signal: hold.signal },
        );
        const lenis = pageLenis();
        if (scrollY > 0) {
          if (lenis && !reduce.matches)
            lenis.scrollTo(0, { duration: ms("--duration-medium") / 1000, easing: travel, lock: true, force: true, onComplete: () => watching === i && lenis.stop() });
          else {
            lenis?.scrollTo(0, { immediate: true, force: true });
            lenis?.stop();
            scrollTo({ top: 0, behavior: reduce.matches ? "auto" : "smooth" });
          }
        } else lenis?.stop();
        movie.src = source.dataset.whole;
        movie.muted = false;
        movie.play().catch(() => {
          loading = false;
          state();
          label();
        });
        label();
      };
      movie?.addEventListener("loadedmetadata", fit, { signal });
      window.addEventListener("resize", fit, { signal });
      movie?.addEventListener(
        "playing",
        () => {
          if (watching < 0) return;
          loading = false;
          label();
          wake();
          if (movieBox?.classList.contains("is-active")) return;
          fit();
          movieBox?.classList.add("is-active", "is-whole");
          // its short version rests once the film covers it
          const k = watching;
          window.setTimeout(() => watching === k && film(), ms("--duration-medium"));
        },
        { signal },
      );
      movie?.addEventListener(
        "waiting",
        () => {
          if (watching < 0) return;
          loading = true;
          label();
          wake();
        },
        { signal },
      );
      movie?.addEventListener("play", state, { signal });
      movie?.addEventListener("pause", state, { signal });
      movie?.addEventListener("ended", () => leave(), { signal });
      // moving through the film: the band on the rule pressed or dragged, the filled part following at once
      const seek = (event: PointerEvent) => {
        if (!movie || !movie.duration || !seekBand) return;
        const box = seekBand.getBoundingClientRect();
        const t = Math.min(1, Math.max(0, (event.clientX - box.left) / Math.max(1, box.width)));
        movie.currentTime = t * movie.duration;
        elapsed(t);
      };
      seekBand?.addEventListener(
        "pointerdown",
        (event) => {
          if (watching < 0) return;
          event.preventDefault();
          dragging = true;
          seekBand.setPointerCapture(event.pointerId);
          seek(event);
          wake();
        },
        { signal },
      );
      const drop = () => {
        dragging = false;
        wake();
      };
      seekBand?.addEventListener("pointerup", drop, { signal });
      seekBand?.addEventListener("pointercancel", drop, { signal });
      wrap.addEventListener(
        "pointermove",
        (event) => {
          if (event.pointerType !== "mouse" || !cursor) return;
          over = event.target;
          if (dragging) seek(event);
          cursor.style.setProperty("--_x", `${event.clientX}px`);
          cursor.style.setProperty("--_y", `${event.clientY}px`);
          label();
        },
        { signal },
      );
      wrap.addEventListener(
        "pointerleave",
        () => {
          over = null;
          label();
        },
        { signal },
      );
      wrap.addEventListener(
        "click",
        (event) => {
          const target = event.target as Element;
          if (target.closest("a, .hero-home_seek, .hero-home_count, .film-controls_close")) return;
          const title = target.closest<HTMLButtonElement>("[data-play]");
          if (watching >= 0) {
            // its own title pauses and plays (nothing while the film loads); anything else leaves
            if (movie && title && Number(title.dataset.play) === watching) {
              if (loading) return;
              if (movie.paused) movie.play().catch(() => {});
              else movie.pause();
            } else leave();
            return;
          }
          // its title, or anywhere on the opening's first screen: the film on screen
          if (title) watch(Number(title.dataset.play));
          else if (target.closest(".hero-home_layout") && !target.closest("button") && title$(current)) watch(current);
        },
        { signal },
      );
      closer?.addEventListener("click", () => leave(), { signal });
      signal.addEventListener(
        "abort",
        () => {
          seen.disconnect();
          leave("gone");
          fill.cancel();
          movie?.pause();
        },
        { once: true },
      );
      run();
    });
  });
</script>

<style is:global>
  @layer components {
    /* the opening: its first screen, then the gradient; the stills fixed behind, seen only within it */
    .hero-home_wrap {
      position: relative;
      clip-path: inset(0);
    }
    /* the stills under 30 % black, then a fade to the page's ground at its foot: the ground's own colour through a
       mask, so it turns with the page when the directors list colours it (Sam, Nov 12: « quand on est sur le premier
       director, le hero devrait être la même couleur ») */
    .hero-home_media {
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      background-color: var(--black);
      &::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 2;
        background-color: color-mix(in srgb, var(--black) 30%, transparent);
      }
      &::after {
        z-index: 3;
        content: "";
        position: absolute;
        inset: 0;
        background-color: var(--background);
