---
/* Home's opening: a featured film's still across the screen under the wordmark, darker towards the foot (30 % black,
   then a fade to the page's black), « Play » where the Figma puts it, and the featured work's row at the bottom.
   The wordmark runs margin to margin (its own drawing measures the Figma's « curveball » exactly: 1664 x 315.6 at
   1728). The still is the Figma's placeholder (a 793 px screenshot), cut to the part the Figma shows and enlarged twice,
   until the films are in. */
import Wordmark from "@/assets/logo/logo.svg";
import Img from "@/components/media/Img.astro";
import { featured } from "@/data/featured.ts";
import { SITE_NAME } from "@/consts.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The still (an import from src/assets), once supplied. */
  still?: ImageMetadata;
}

const { render = true, still } = Astro.props;
const first = featured[0];
---

{
  render && (
    <section class="hero-home_wrap theme-dark" data-op-section="HeroHome">
      <div class="hero-home_media" aria-hidden="true">
        {still ? (
          <Img class="hero-home_still" src={still} alt="" variant="full-width" loading="eager" fetchPriority="high" />
        ) : (
          <div class="hero-home_placeholder">
            <span class="text-style-small">Featured film still: to supply</span>
          </div>
        )}
      </div>
      <div class="hero-home_layout site-grid">
        <h1 class="hero-home_title">
          <Wordmark class="hero-home_wordmark" aria-hidden="true" />
          <span class="sr-only">{SITE_NAME}</span>
        </h1>
        <span class="hero-home_play text-style-main" aria-hidden="true">Play</span>
        <div class="hero-home_row rule-top" data-op-list="featured" data-op-source="src/data/featured.ts">
          <p class="hero-home_label dot-label text-style-main">Featured work</p>
          <p class="hero-home_client text-style-main" data-op-item="0">
            <span class="hero-home_key">Client</span>
            <br />
            <span>{first.client}</span>
          </p>
          <p class="hero-home_agency text-style-main">
            <span class="hero-home_key">Agency</span>
            <br />
            <span>{first.agency}</span>
          </p>
          <p class="hero-home_count text-style-main">
            1 — {featured.length}
          </p>
        </div>
      </div>
    </section>
  )
}

<style is:global>
  @layer components {
    .hero-home_wrap {
      position: relative;
      display: flex;
      flex-direction: column;
      min-height: 100svh;
      overflow: clip;
    }
    .hero-home_media {
      position: absolute;
      inset: 0;
      &::after {
        content: "";
        position: absolute;
        inset: 0;
        background:
          linear-gradient(to bottom, transparent, var(--black)),
          color-mix(in srgb, var(--black) 30%, transparent);
      }
    }
    .hero-home_still,
    .hero-home_placeholder {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .hero-home_placeholder {
      display: grid;
      place-items: center;
      background-color: var(--background-3);
      color: var(--text-2);
    }
    .hero-home_layout {
      position: relative;
      flex: 1;
      grid-template-rows: auto 1fr auto;
      /* Under the menu below a computer's width, where the wordmark is too short to hold it between its letters */
      padding-top: calc(var(--nav-height) + var(--space-4));
      padding-bottom: var(--section-space-small);
      @media (width >= 64rem) {
        padding-top: var(--site-margin);
      }
    }
    .hero-home_title {
      grid-column: margin / end;
      grid-row: 1;
      color: var(--text);
    }
    .hero-home_wordmark {
      display: block;
      width: 100%;
      height: auto;
    }
    .hero-home_play {
      grid-column: aside;
      grid-row: 2;
      align-self: center;
      display: none;
      @media (width >= 64rem) {
        display: block;
      }
    }
    .hero-home_row {
      grid-column: margin / end;
      grid-row: 3;
      display: grid;
      grid-template-columns: subgrid;
      row-gap: var(--space-5);
      align-items: start;
    }
    .hero-home_label {
      grid-column: margin / span 2;
    }
    .hero-home_client {
      grid-column: half / span 2;
    }
    .hero-home_agency {
      grid-column: aside / span 2;
    }
    .hero-home_count {
      grid-column: last / end;
      justify-self: end;
      white-space: nowrap;
    }
    .hero-home_key {
      color: var(--text-2);
    }
    @media (width < 48rem) {
      .hero-home_label {
        grid-column: margin / end;
        grid-row: 1;
      }
      .hero-home_count {
        grid-row: 1;
      }
      .hero-home_client {
        grid-column: margin / span 2;
      }
      .hero-home_agency {
        grid-column: three / end;
      }
    }
  }
</style>
