---
/* The home's intro (Sam, Nov 25: option 1 of the study, « La plongée »). The first frame is the wordmark itself,
   turned a quarter and seen very close: the middle band is its « u », the top one its « r » (drawn a little closer
   than in the wordmark, as in the storyboard). Two balls run through the letters while the footer's sentence fades
   up; then the camera goes into the logo: the black thins to the opening's film and each letter grows at its own pace
   until the film fills the screen, while the opening's own elements come in one after another.
   The first frame is CSS, there from the first paint (Sam, Nov 25: « que ça load instantanément »): the letters are
   two SVGs that slide in, the balls run on keyframes written here from system/intro-tracks.py's tracks, all moved by
   transform so the browser plays them on its own even while the page's scripts load. The dive is drawn on a canvas
   by the script, on the CSS's own clock: a full-screen drawing redrawn by CSS at every frame glitched (Sam, Nov 25:
   squares of an older frame left on the screen). Without the script, the intro fades into the page at the dive.
   `head` goes in the page's head (the decision before the first paint), the cover first in the page, `sample` is its
   first frame, still, for the components page. */
import logo from "@/assets/logo/logo.svg?raw";
import tracks from "@/data/intro-tracks.json";
import { LINE } from "@/data/site.ts";

type Props = {
  /** `head`: the script that decides, before the first paint, whether the intro plays. `cover`: the intro itself, first in the page. `sample`: its first frame, still, in a box. */
  part?: "head" | "cover" | "sample";
};

const { part = "cover" } = Astro.props;

/* The storyboard's box is 2000 x 1129. The camera's first place: the wordmark turned a quarter (its « u » across the
   screen, its bowl at the right edge), 24.87 units of the box to one of the wordmark. The script below uses the same
   numbers. */
const CAMERA = { x: -557.7, y: 3860, s: 24.87 };
const camera = `translate(${CAMERA.x} ${CAMERA.y}) scale(${CAMERA.s}) rotate(-90)`;
// the « r » 4.4 units closer to the « u » than in the wordmark, as in the storyboard
const R_SHIFT = -4.4;

/* The wordmark's letters, as logo.svg draws them (one subpath each: the « u » is the 11th, the « r » the 10th, as
   system/intro-tracks.py reads them). Each with its run-ons in one shape, on the stems' own ends (no overlap, so no
   seam): the « u »'s stems on past the screen's left edge, as the site's curves do; the « r »'s stem on past the
   screen's right edge (Sam, Nov 25: no red at its end) and its arm past the top. */
const subpaths = logo.match(/ d="([^"]+)"/)?.[1].match(/M[^M]+/g) ?? [];
const box = (x: number, y: number, w: number, h: number) => `M${x} ${y}H${x + w}V${y + h}H${x}Z`;
const U = (subpaths[10] ?? "") + box(75.99, -2000, 20.4374, 2031.3965) + box(121.9, -2000, 20.437, 2031.3965);
const R = (subpaths[9] ?? "") + box(147.337, 101.002, 20.437, 2000) + box(187.767, 30.9519, 2000, 18.364);

/* The balls: each runs the whole of its letter and leaves the frame before the dive, slowest where the storyboard has
   it and never stopping (fast at both ends), its size the stroke's (97 %). Their keyframes are in the box's units
   (one unit is 0.05cqw of the box); a ball's own size is 250 units of radius, scaled. */
type Track = { points: number[]; rest: number };
const linger = (p: number) => p + (0.72 * Math.sin(2 * Math.PI * p)) / (2 * Math.PI);
const STEPS = 72;
const BALL = 250;
const along = (t: Track, i: number) => {
  const n = t.points.length / 3;
  const k = Math.max(0, Math.min(n - 1.001, i));
  const a = Math.floor(k);
  const f = k - a;
  const p = t.points;
  return [0, 1, 2].map((j) => p[a * 3 + j] + (p[(a + 1) * 3 + j] - p[a * 3 + j]) * f);
};
const onScreen = ([x, y, r]: number[], dx: number) => ({
  cx: CAMERA.x + CAMERA.s * y,
  cy: CAMERA.y - CAMERA.s * (x + dx),
  r: CAMERA.s * r,
});
const keyframes = (name: string, t: Track, reach: number, dx: number) => {
  const frames = [];
  for (let s = 0; s <= STEPS; s++) {
    const { cx, cy, r } = onScreen(along(t, t.rest + reach * (2 * linger(s / STEPS) - 1)), dx);
    frames.push(
      `${((s / STEPS) * 100).toFixed(2)}%{transform:translate(calc(${cx.toFixed(1)}*.05cqw),calc(${cy.toFixed(1)}*.05cqw)) scale(${(r / BALL).toFixed(4)})}`,
    );
  }
  return `@keyframes ${name}{${frames.join("")}}`;
};
const ballKeyframes =
  keyframes("home-intro-ball-r", tracks.r, 155, R_SHIFT) + keyframes("home-intro-ball-u", tracks.u, 180, 0);
const rest = (t: Track, dx: number) => onScreen(t.points.slice(t.rest * 3, t.rest * 3 + 3), dx);

/* The sentence on the storyboard's four lines */
const BREAKS = ["filmmakers", "between", "and"];
const lines = LINE.split(" ").reduce<string[]>((all, word) => {
  if (!all.length || BREAKS[all.length - 1] === word) all.push(word);
  else all[all.length - 1] += ` ${word}`;
  return all;
}, []);
---

{
  part === "head" && (
    <script is:inline>
      (() => {
        /* The home's intro (src/components/section/HomeIntro.astro): on a visit that starts on the home, once per
           tab session, every time with ?op-intro in the address; never with reduced motion, nor on a page change
           within the site (the document is already loaded then). Its CSS plays it; this only decides. */
        if (document.readyState !== "loading") return;
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        const root = document.documentElement;
        const asked = new URLSearchParams(location.search).has("op-intro");
        let seen = true;
        try {
          seen = sessionStorage.getItem("home-intro") === "1";
          sessionStorage.setItem("home-intro", "1");
        } catch {}
        if (seen && !asked) return;
        root.dataset.intro = "play";
        /* if the page's script never says it has ended, the page comes back by itself */
        setTimeout(() => {
          if (root.dataset.intro === undefined) return;
          delete root.dataset.intro;
          document.dispatchEvent(new Event("home-intro:end"));
        }, 9000);
      })();
    </script>
  )
}

{
  part === "cover" && (
    <div class="home-intro_wrap" aria-hidden="true" data-u={U} data-r={R}>
      <style is:inline set:html={ballKeyframes} />
      <div class="home-intro_box">
        <svg class="home-intro_shape is-u" viewBox="0 0 2000 1129">
          <path d={U} transform={camera} />
        </svg>
        <svg class="home-intro_shape is-r" viewBox="0 0 2000 1129">
          <path d={R} transform={`${camera} translate(${R_SHIFT} 0)`} />
        </svg>
        <span class="home-intro_runner is-r">
          <span class="home-intro_ball is-r" />
        </span>
        <span class="home-intro_runner is-u">
          <span class="home-intro_ball is-u" />
        </span>
      </div>
      <canvas class="home-intro_dive" />
      <div class="home-intro_words site-grid">
        <p class="home-intro_line text-style-h3">
          {lines.map((l) => (
            <span class="home-intro_part">{l}</span>
          ))}
        </p>
      </div>
    </div>
  )
}

{
  part === "sample" && (
    <div class="home-intro_sample" aria-hidden="true">
      <svg class="home-intro_still" viewBox="0 0 2000 1129">
        <path d={U} transform={camera} />
        <path d={R} transform={`${camera} translate(${R_SHIFT} 0)`} />
        <circle class="home-intro_still-ball" {...rest(tracks.r, R_SHIFT)} />
        <circle class="home-intro_still-ball" {...rest(tracks.u, 0)} />
      </svg>
      <p class="home-intro_line text-style-h3">
        {lines.map((l) => (
          <span class="home-intro_part">{l}</span>
        ))}
      </p>
    </div>
  )
}

<script>
  import { onPage } from "@/utils/page.ts";
  import { onLenis } from "@/utils/smooth-scroll.ts";

  type Plane = { shift: number; pace: number };

  /* The dive (job: go into the logo and come out on the work), drawn on a canvas on the CSS's own clock (the wrap's
     animation, counted from the first paint): the red with the letters as holes, the black over them thinning to the
     film beneath, each letter growing round where the sentence was read, the « r » nearer, so faster. The script also
     holds the smooth scroll while the intro plays and tells the page when it has ended. */
  const BOX = { w: 2000, h: 1129, x: -557.7, y: 3860, s: 24.87 };
  const FOCUS = { x: 1250, y: 580 };
  const PLANES: Record<"u" | "r", Plane> = { u: { shift: 0, pace: 1 }, r: { shift: -4.4, pace: 1.32 } };

  onPage((signal) => {
    const root = document.documentElement;
    if (root.dataset.intro === undefined) return;
    const wrap = document.querySelector<HTMLElement>(".home-intro_wrap");
    const canvas = wrap?.querySelector<HTMLCanvasElement>(".home-intro_dive");
    const ctx = canvas?.getContext("2d");
    const layer = document.createElement("canvas");
    const lctx = layer.getContext("2d");
    const named = (name: string) =>
      wrap?.getAnimations().find((a): a is CSSAnimation => a instanceof CSSAnimation && a.animationName === name);
    const clock = named("home-intro-gone");

    let lenis: { stop(): void; start(): void } | undefined;
    const release = onLenis((l) => {
      lenis = l;
      if (root.dataset.intro !== undefined) l.stop();
    });
    let frame = 0;
    const end = () => {
      cancelAnimationFrame(frame);
      if (root.dataset.intro === undefined) return;
      delete root.dataset.intro;
      lenis?.start();
      release();
      document.dispatchEvent(new Event("home-intro:end"));
    };
    signal.addEventListener("abort", end, { once: true });
    // a page opened far down (a reload keeps the scroll): straight to the page
    if (scrollY > innerHeight * 0.3) return end();
    const mine = document
      .getAnimations()
      .filter((a): a is CSSAnimation => a instanceof CSSAnimation && a.animationName.startsWith("home-intro"));
    Promise.allSettled(mine.map((a) => a.finished)).then(end);

    const css = getComputedStyle(root);
    const seconds = (name: string) => {
      const v = css.getPropertyValue(name).trim();
      return v.endsWith("ms") ? parseFloat(v) / 1000 : parseFloat(v) || 0;
    };
    const HOLD = seconds("--intro-hold");
    const DIVE = seconds("--intro-dive-duration");
    const THIN = seconds("--duration-base");
    const now = () => Number(clock?.currentTime ?? 0) / 1000;
    // too late to take the dive over (the page's scripts came after it started): the CSS fades into the page
    if (!wrap || !canvas || !ctx || !lctx || !clock || now() > HOLD - 0.1) return;
    named("home-intro-fade")?.cancel();

    // the site's travel curve, as CSS draws it
    const curve = css
      .getPropertyValue("--ease-travel")
      .match(/cubic-bezier\(([^)]+)\)/)?.[1]
      .split(",")
      .map(Number) ?? [0.65, 0, 0.35, 1];
    const travel = (x: number) => {
      const [x1, y1, x2, y2] = curve;
      if (x <= 0 || x >= 1) return x <= 0 ? 0 : 1;
      let t = x;
      for (let i = 0; i < 8; i++) {
        const cx = 3 * x1 * t * (1 - t) ** 2 + 3 * x2 * t * t * (1 - t) + t ** 3 - x;
        const dx = 3 * x1 * (1 - t) ** 2 + 6 * (x2 - x1) * t * (1 - t) + 3 * (1 - x2) * t * t;
        if (Math.abs(cx) < 1e-6 || !dx) break;
        t = Math.min(1, Math.max(0, t - cx / dx));
      }
      return 3 * y1 * t * (1 - t) ** 2 + 3 * y2 * t * t * (1 - t) + t ** 3;
    };
    const RED = css.getPropertyValue("--red").trim();
    const BLACK = css.getPropertyValue("--black").trim();
    const SHAPES = { u: new Path2D(wrap.dataset.u ?? ""), r: new Path2D(wrap.dataset.r ?? "") };

    // the box as the CSS places it: covering the screen across; upright, its right part as wide as the screen
    const L = { W: 0, H: 0, dpr: 1, f: 1, ox: 0, oy: 0, zoom: 3.2 };
    const layout = () => {
      L.W = wrap.clientWidth;
      L.H = wrap.clientHeight;
      L.dpr = Math.min(devicePixelRatio || 1, 3);
      const upright = L.W < L.H;
      L.f = upright ? L.W / 1040 : Math.max(L.W / BOX.w, L.H / BOX.h);
      L.ox = upright ? -960 * L.f : (L.W - BOX.w * L.f) / 2;
      L.oy = (L.H - BOX.h * L.f) / 2;
      L.zoom = parseFloat(getComputedStyle(wrap).getPropertyValue("--intro-zoom")) || 3.2;
      canvas.width = layer.width = Math.round(L.W * L.dpr);
      canvas.height = layer.height = Math.round(L.H * L.dpr);
    };
    const place = (c: CanvasRenderingContext2D, p: Plane, grow: number) => {
      const fx = FOCUS.x * L.f + L.ox;
      const fy = FOCUS.y * L.f + L.oy;
      const z = 1 + (L.zoom - 1) * grow * p.pace;
      c.setTransform(L.dpr, 0, 0, L.dpr, 0, 0);
      c.translate(fx, fy);
      c.scale(z, z);
      c.translate(-fx, -fy);
      c.translate(BOX.x * L.f + L.ox, BOX.y * L.f + L.oy);
      c.scale(BOX.s * L.f, BOX.s * L.f);
      c.rotate(-Math.PI / 2);
      c.translate(p.shift, 0);
    };
    // one frame: the red, the holes, the black laid on at its opacity (painted whole first: where the letters cross as
    // they grow at their own pace, it never darkens)
    const draw = (t: number) => {
      const grow = travel(Math.min(1, Math.max(0, (t - HOLD) / DIVE)));
      const black = 1 - travel(Math.min(1, Math.max(0, (t - HOLD - 0.1) / THIN)));
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.globalAlpha = 1;
      ctx.globalCompositeOperation = "source-over";
      ctx.fillStyle = RED;
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.globalCompositeOperation = "destination-out";
      for (const k of ["u", "r"] as const) {
        place(ctx, PLANES[k], grow);
        ctx.fill(SHAPES[k]);
      }
      ctx.globalCompositeOperation = "source-over";
      if (black <= 0) return;
      lctx.setTransform(1, 0, 0, 1, 0, 0);
      lctx.clearRect(0, 0, layer.width, layer.height);
      lctx.fillStyle = BLACK;
      for (const k of ["u", "r"] as const) {
        place(lctx, PLANES[k], grow);
        lctx.fill(SHAPES[k]);
      }
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.globalAlpha = black;
      ctx.drawImage(layer, 0, 0);
    };
    // until the dive the CSS shows the letters; from it, the canvas (the same picture at that moment)
    const tick = () => {
      const t = now();
      if (t >= HOLD) {
        draw(t);
        wrap.dataset.dive = "";
      }
      if (t < HOLD + DIVE) frame = requestAnimationFrame(tick);
    };

    layout();
    draw(HOLD);
    addEventListener("resize", () => (layout(), draw(Math.max(now(), HOLD))), { signal });
    frame = requestAnimationFrame(tick);
  });
</script>

<style is:global>
  @layer components {
    .home-intro_wrap {
      display: none;
    }
    /* the storyboard's box: covering the screen across; upright, its right part as wide as the screen, centred */
    .home-intro_box {
      position: absolute;
      top: 50%;
      left: 50%;
      width: max(100cqw, 100cqh * 2000 / 1129);
      aspect-ratio: 2000 / 1129;
      translate: -50% -50%;
      container-type: size;
      @media (orientation: portrait) {
        left: calc(100cqw * -960 / 1040);
        width: calc(100cqw * 2000 / 1040);
        translate: 0 -50%;
      }
    }
    /* each letter its own layer, the drawing running on past the box */
    :is(.home-intro_shape, .home-intro_still) {
      position: absolute;
      inset: 0;
      display: block;
      width: 100%;
      height: 100%;
      overflow: visible;
      fill: var(--black);
    }
    .home-intro_runner {
      position: absolute;
      inset: 0;
    }
    .home-intro_ball {
      position: absolute;
      top: 0;
      left: 0;
      width: 25cqw;
      margin: -12.5cqw;
      aspect-ratio: 1;
      border-radius: var(--radius-round);
      background-color: var(--red);
    }
    .home-intro_dive {
      position: absolute;
      inset: 0;
      display: block;
      width: 100%;
      height: 100%;
      visibility: hidden;
    }
    /* the footer's sentence on the « u », on the grid: in the menu's column across, on the margin upright */
    .home-intro_words {
      position: absolute;
      inset-inline: 0;
      top: calc(50cqh + 0.01373 * max(100cqh, 100cqw * 1129 / 2000));
      translate: 0 -50%;
      @media (orientation: portrait) {
        top: calc(50cqh + 0.01373 * 100cqw * 1129 / 1040);
      }
    }
    .home-intro_line {
      grid-column: half / end;
      margin: 0;
      color: var(--taupe);
      @media (orientation: portrait) {
        grid-column: margin / end;
      }
    }
    .home-intro_part {
      display: block;
      white-space: nowrap;
    }
    .home-intro_part:nth-child(2) {
      --_i: 1;
    }
    .home-intro_part:nth-child(3) {
      --_i: 2;
    }
    .home-intro_part:nth-child(4) {
      --_i: 3;
    }

    /* While it plays: it covers the page (held still, its scrollbar's room kept) on the red of the storyboard, and
       goes once the film fills the screen. The opening's own elements come in one after another as the film opens
       up (past half the dive): the wordmark, the menu, the row's rule drawn from the left, the row; the film settles
       from 112 % through the dive. */
    html[data-intro] {
      --intro-reveal: calc(var(--intro-hold) + var(--intro-dive-duration) * 0.55);
      overflow: hidden;
      scrollbar-gutter: stable;
      & .home-intro_wrap {
        --intro-zoom: 3.2;
        position: fixed;
        inset: 0;
        z-index: var(--intro-layer);
        display: block;
        overflow: hidden;
        background-color: var(--red);
        container-type: size;
        /* the intro's clock (the script reads it), then, unless the script draws the dive, a fade into the page */
        animation:
          home-intro-gone var(--duration-faster) linear calc(var(--intro-hold) + var(--intro-dive-duration)) both,
          home-intro-fade var(--intro-dive-duration) var(--ease-travel) var(--intro-hold) both;
        @media (orientation: portrait) {
          --intro-zoom: 4.8;
        }
      }
      /* the dive drawn by the script: the canvas shows, the red behind it and the SVG letters go */
      & .home-intro_wrap[data-dive] {
        background-color: transparent;
        & .home-intro_dive {
          visibility: visible;
        }
        & .home-intro_box {
          visibility: hidden;
        }
      }
      /* the letters slide in from either side, a little (Sam, Nov 25: « plus subtil, plus smooth »), their balls
         with them; each ball runs through its letter from the first paint and leaves the frame before the dive */
      & :is(.home-intro_shape, .home-intro_runner) {
        animation: home-intro-enter calc(var(--duration-slow) * 1.25) var(--ease-smooth) both;
      }
      & :is(.home-intro_shape, .home-intro_runner).is-u {
        --_from: -8cqw;
      }
      & :is(.home-intro_shape, .home-intro_runner).is-r {
        --_from: 8cqw;
      }
      & .home-intro_ball {
        animation: home-intro-ball-r calc(var(--intro-hold) - 0.1 * 1s) linear both;
        &.is-u {
          animation-name: home-intro-ball-u;
          animation-duration: calc(var(--intro-hold) - 0.2 * 1s);
          animation-delay: calc(0.1 * 1s);
        }
      }
      & .home-intro_part {
        animation:
          home-intro-up var(--duration-base) var(--ease-out) calc((0.3 + var(--_i, 0) * 0.07) * 1s) both,
          home-intro-out var(--duration-fast) var(--ease-leave) calc(var(--intro-hold) + (var(--_i, 0) * 0.03 - 0.2) * 1s) forwards;
      }
      & .hero-home_media {
        animation: home-intro-settle calc(var(--intro-dive-duration) + 0.6 * 1s) var(--ease-out) var(--intro-hold) both;
      }
      & :is(.hero-home_title, .nav_logo, .nav_links > li, .nav_contact, .nav_action, .hero-home_label, .hero-home_slides, .hero-home_count) {
        animation: home-intro-up var(--duration-base) var(--ease-out) calc(var(--intro-reveal) + var(--_at, 0) * 1s) both;
      }
      & .nav_logo {
        --_at: 0.12;
      }
      & .nav_links > li:nth-child(1) {
        --_at: 0.2;
      }
      & .nav_links > li:nth-child(2) {
        --_at: 0.28;
      }
      & .nav_links > li:nth-child(3) {
        --_at: 0.36;
      }
      & .nav_contact {
        --_at: 0.44;
      }
      & .nav_action {
        --_at: 0.52;
      }
      & .hero-home_label {
        --_at: 0.5;
      }
      & .hero-home_slides {
        --_at: 0.6;
      }
      & .hero-home_count {
        --_at: 0.7;
      }
      & .hero-home_row {
        border-top-color: transparent;
        &::before {
          content: "";
          position: absolute;
          inset: calc(var(--border-width) * -1) 0 auto;
          height: var(--border-width);
          background-color: var(--border);
          transform-origin: left;
          animation: home-intro-rule var(--duration-slow) var(--ease-arrive) calc(var(--intro-reveal) + 0.3 * 1s) both;
        }
      }
    }

    @keyframes home-intro-enter {
      from {
        translate: var(--_from) 0;
      }
    }
    @keyframes home-intro-up {
      from {
        opacity: 0;
        translate: 0 1.25rem;
      }
    }
    @keyframes home-intro-out {
      to {
        opacity: 0;
        translate: 0 -0.75rem;
      }
    }
    @keyframes home-intro-settle {
      from {
        scale: 1.12;
      }
    }
    @keyframes home-intro-rule {
      from {
        scale: 0 1;
      }
    }
    @keyframes home-intro-fade {
      to {
        opacity: 0;
      }
    }
    @keyframes home-intro-gone {
      to {
        visibility: hidden;
      }
    }

    /* the components page: the first frame, still (the storyboard's type size: 62 of its 2000) */
    .home-intro_sample {
      position: relative;
      width: 100%;
      aspect-ratio: 2000 / 1129;
      overflow: hidden;
      background-color: var(--red);
      container-type: inline-size;
      & .home-intro_line {
        position: absolute;
        left: 50.15%;
        top: 40.3%;
        font-size: 3.1cqi;
      }
    }
    .home-intro_still-ball {
      fill: var(--red);
    }
  }
</style>
