---
/* The home's intro (Sam, Nov 25: option 1 of the study, « La plongée »). The first frame is the wordmark itself,
   turned a quarter and seen very close: the middle band is its « u », the top one its « r » (drawn a little closer
   than in the wordmark, as in the storyboard). Two balls run through the letters while the footer's sentence fades
   up; then the camera goes into the logo: the black thins to the opening's film, each letter grows at its own pace
   until the film fills the screen, and the opening's own elements come in one after another.
   `head` goes in the page's head (the decision before the first paint), the cover first in the page, `sample` is its
   first frame, still, for the components page. */
import logo from "@/assets/logo/logo.svg?raw";
import tracks from "@/data/intro-tracks.json";
import { LINE } from "@/data/site.ts";

type Props = {
  /** `head`: the script that decides, before the first paint, whether the intro plays. `cover`: the intro itself, first in the page. `sample`: its first frame, still, in a box. */
  part?: "head" | "cover" | "sample";
};

const { part = "cover" } = Astro.props;

/* The wordmark's letters, as logo.svg draws them (one subpath each: the « u » is the 11th, the « r » the 10th, as
   system/intro-tracks.py reads them) */
const subpaths = logo.match(/ d="([^"]+)"/)?.[1].match(/M[^M]+/g) ?? [];
/* Each letter and its run-ons in one shape (the same turn as the letter's own outline, the stems' own edges), so they
   read as one stroke with no seam: the « u »'s stems on past the screen's left edge, as the site's curves do; the « r »'s stem on past
   the screen's right edge (Sam, Nov 25: no red at its end) and its arm past the top */
const box = (x: number, y: number, w: number, h: number) => `M${x} ${y}H${x + w}V${y + h}H${x}Z`;
const U = (subpaths[10] ?? "") + box(75.99, -400, 20.4374, 440) + box(121.9, -400, 20.437, 440);
const R = (subpaths[9] ?? "") + box(147.337, 60, 20.437, 440) + box(187.767, 30.9519, 50, 18.364);

/* The sentence on the storyboard's four lines */
const BREAKS = ["filmmakers", "between", "and"];
const lines = LINE.split(" ").reduce<string[]>((all, word) => {
  if (!all.length || BREAKS[all.length - 1] === word) all.push(word);
  else all[all.length - 1] += ` ${word}`;
  return all;
}, []);

/* The still: the storyboard's box (2000 x 1129) with the letters at the camera's first place, the balls where they
   pass slowest */
const at = (t: { points: number[]; rest: number }) => t.points.slice(t.rest * 3, t.rest * 3 + 3);
const [ux, uy, ur] = at(tracks.u);
const [rx, ry, rr] = at(tracks.r);
const camera = "translate(-557.7 3860) scale(24.87) rotate(-90)";
---

{
  part === "head" && (
    <script is:inline>
      (() => {
        /* The home's intro (src/components/section/HomeIntro.astro): on a visit that starts on the home, once per
           tab session, every time with ?op-intro in the address; never with reduced motion, nor on a page change
           within the site (the document is already loaded then). */
        if (document.readyState !== "loading") return;
        const root = document.documentElement;
        if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        const asked = new URLSearchParams(location.search).has("op-intro");
        let seen = true;
        try {
          seen = sessionStorage.getItem("home-intro") === "1";
          sessionStorage.setItem("home-intro", "1");
        } catch {}
        if (seen && !asked) return;
        root.dataset.intro = "play";
        /* if its script never runs, or stops half way, the page comes back by itself */
        const back = () => delete root.dataset.intro;
        setTimeout(() => root.dataset.intro === "play" && back(), 4000);
        setTimeout(() => root.dataset.intro && back(), 12000);
      })();
    </script>
  )
}

{
  part === "cover" && (
    <div class="home-intro_wrap" aria-hidden="true" data-u={U} data-r={R}>
      <canvas class="home-intro_scene" />
      <p class="home-intro_line text-style-h2">
        {lines.map((l) => (
          <span class="home-intro_part">{l}</span>
        ))}
      </p>
    </div>
  )
}

{
  part === "sample" && (
    <div class="home-intro_sample" aria-hidden="true">
      <svg class="home-intro_still" viewBox="0 0 2000 1129">
        <g transform={camera}>
          <path d={U} />
          <circle class="home-intro_ball" cx={ux} cy={uy} r={ur} />
        </g>
        <g transform={`${camera} translate(-4.4 0)`}>
          <path d={R} />
          <circle class="home-intro_ball" cx={rx} cy={ry} r={rr} />
        </g>
      </svg>
      <p class="home-intro_line text-style-h2">
        {lines.map((l) => (
          <span class="home-intro_part">{l}</span>
        ))}
      </p>
    </div>
  )
}

<script>
  import { gsap } from "gsap";
  import { CustomEase } from "gsap/CustomEase";
  import { onPage } from "@/utils/page.ts";
  import { onLenis } from "@/utils/smooth-scroll.ts";
  import tracks from "@/data/intro-tracks.json";

  gsap.registerPlugin(CustomEase);

  type Track = { points: number[]; rest: number };
  type Plane = { lx: number; ly: number; drift: number; zoom: number };

  /* The storyboard's box is 2000 x 1129. The camera's first place: the wordmark turned a quarter (its « u » across the
     screen, its bowl at the right edge), 24.87 units of the box to one of the wordmark. The « r » is drawn 4.4 units
     closer to the « u » than in the wordmark, as in the storyboard. */
  const BOX = { w: 2000, h: 1129, x: -557.7, y: 3860, s: 24.87 };
  const R_SHIFT = -4.4;
  // where the sentence sits (its left and its middle) and where the camera goes in: on the « u », where it was read
  const WORDS = { x: 1003, y: 580 };
  const FOCUS = { x: 1250, y: 580 };
  // the bowl's outer edge in the box (the storyboard's), which the sentence keeps clear of
  const BOWL = { x: 1190, y: 1125, r: 805 };

  onPage((signal) => {
    const root = document.documentElement;
    const wrap = document.querySelector<HTMLElement>(".home-intro_wrap");
    const canvas = wrap?.querySelector<HTMLCanvasElement>(".home-intro_scene");
    const sentence = wrap?.querySelector<HTMLElement>(".home-intro_line");
    const ctx = canvas?.getContext("2d");
    if (!wrap || !canvas || !sentence || !ctx || root.dataset.intro !== "play") return;
    // a page opened far down (a reload keeps the scroll): straight to the page
    if (scrollY > innerHeight * 0.3) {
      delete root.dataset.intro;
      return;
    }

    const css = getComputedStyle(root);
    const seconds = (name: string) => {
      const v = css.getPropertyValue(name).trim();
      return v.endsWith("ms") ? parseFloat(v) / 1000 : parseFloat(v) || 0;
    };
    const ease = (name: string) => {
      const m = css.getPropertyValue(name).match(/cubic-bezier\(([^)]+)\)/);
      return m ? CustomEase.create(name, m[1]) : "power2.out";
    };
    const colour = (name: string) => css.getPropertyValue(name).trim();
    const OUT = ease("--ease-out"), ARRIVE = ease("--ease-arrive"), TRAVEL = ease("--ease-travel"), LEAVE = ease("--ease-leave");
    const FAST = seconds("--duration-fast"), BASE = seconds("--duration-base"), SLOW = seconds("--duration-slow");
    const HOLD = seconds("--intro-hold"), DIVE = seconds("--intro-dive-duration");
    const RED = colour("--red"), BLACK = colour("--black");

    // the letters, each with its run-ons, as one canvas path
    const SHAPES = { U: [new Path2D(wrap.dataset.u ?? "")], R: [new Path2D(wrap.dataset.r ?? "")] };
    // the black is painted whole on its own layer, then laid on at its opacity: where the letters cross as they grow
    // at their own pace, it never darkens
    const layer = document.createElement("canvas");
    const lctx = layer.getContext("2d");
    if (!lctx) return;

    const media = document.querySelector<HTMLElement>(".hero-home_media");
    const title = document.querySelector<HTMLElement>(".hero-home_title");
    const row = document.querySelector<HTMLElement>(".hero-home_row");
    const nav = [...document.querySelectorAll<HTMLElement>(".nav_logo, .nav_links > li, .nav_contact, .nav_action")];
    const rowItems = row ? [...row.querySelectorAll<HTMLElement>(":scope > :is(.hero-home_label, .hero-home_slides, .hero-home_count)")] : [];
    const words = [...sentence.querySelectorAll<HTMLElement>(".home-intro_part")];

    /* ---- where everything is, for this screen ---- */
    const L = { W: 0, H: 0, dpr: 1, f: 1, ox: 0, oy: 0, fill: 3.2, rise: 20 };
    const P: Record<"U" | "R", Plane> = { U: { lx: 0, ly: -40, drift: 0, zoom: 0 }, R: { lx: 25, ly: 0, drift: 0, zoom: 0 } };
    const B = { u: 0, r: 0, showU: 1, showR: 1 };
    const S = { black: 1 };
    const box = (x: number, y: number) => [x * L.f + L.ox, y * L.f + L.oy];

    function layout() {
      L.W = innerWidth;
      L.H = innerHeight;
      L.dpr = Math.min(devicePixelRatio || 1, 3);
      if (L.W < L.H) {
        // upright: the box's right part, its width the screen's, the « u » seen whole below
        L.f = L.W / 1040;
        L.ox = -960 * L.f;
        L.oy = (L.H - BOX.h * L.f) / 2;
        L.fill = 4.8;
      } else {
        // across: the box covers the screen
        L.f = Math.max(L.W / BOX.w, L.H / BOX.h);
        L.ox = (L.W - BOX.w * L.f) / 2;
        L.oy = (L.H - BOX.h * L.f) / 2;
        L.fill = 3.2;
      }
      L.rise = parseFloat(css.fontSize) * 1.25;
      canvas!.width = layer.width = Math.round(L.W * L.dpr);
      canvas!.height = layer.height = Math.round(L.H * L.dpr);
      // the sentence: its middle on the band's, its left where the storyboard has it unless a line would reach the
      // bowl's edge; then left enough for its longest line, never past the site's margin
      sentence!.style.left = "0px";
      const height = sentence!.offsetHeight;
      const top = box(0, WORDS.y)[1] - height / 2;
      let left = box(WORDS.x, 0)[0];
      words.forEach((w) => {
        const middle = top + w.offsetTop + w.offsetHeight / 2;
        const yb = (middle - L.oy) / L.f;
        const edge = box(BOWL.x + Math.sqrt(Math.max(0, BOWL.r ** 2 - (BOWL.y - yb) ** 2)), 0)[0];
        left = Math.min(left, edge - w.offsetWidth - L.rise * 2);
      });
      sentence!.style.left = `${Math.max(left, parseFloat(css.getPropertyValue("--site-margin")) || 0)}px`;
      sentence!.style.top = `${top}px`;
    }

    /* ---- one frame: the red, the letters' black (the film shows where it thins), the balls ---- */
    const track = (t: Track, i: number) => {
      const n = t.points.length / 3;
      const k = Math.max(0, Math.min(n - 1.001, i));
      const a = Math.floor(k), f = k - a, p = t.points;
      return [0, 1, 2].map((j) => p[a * 3 + j] + (p[(a + 1) * 3 + j] - p[a * 3 + j]) * f);
    };
    function plane(c: CanvasRenderingContext2D, p: Plane, lx: number, ly: number) {
      const [fx, fy] = box(FOCUS.x, FOCUS.y);
      const z = 1 + (L.fill - 1) * p.zoom;
      c.setTransform(L.dpr, 0, 0, L.dpr, 0, 0);
      c.translate(fx, fy);
      c.scale(z, z);
      c.translate(-fx, -fy + p.drift * L.H);
      c.translate(BOX.x * L.f + L.ox, BOX.y * L.f + L.oy);
      c.scale(BOX.s * L.f, BOX.s * L.f);
      c.rotate(-Math.PI / 2);
      c.translate(lx, ly);
    }
    const planes = () =>
      [
        ["R", P.R, R_SHIFT + P.R.lx, 0],
        ["U", P.U, 0, P.U.ly],
      ] as const;
    function draw() {
      const c = ctx!;
      c.setTransform(1, 0, 0, 1, 0, 0);
      c.globalAlpha = 1;
      c.globalCompositeOperation = "source-over";
      c.fillStyle = RED;
      c.fillRect(0, 0, canvas!.width, canvas!.height);
      const solid = S.black >= 1;
      if (!solid) {
        c.globalCompositeOperation = "destination-out";
        for (const [k, p, lx, ly] of planes()) {
          plane(c, p, lx, ly);
          SHAPES[k].forEach((s) => c.fill(s));
        }
        c.globalCompositeOperation = "source-over";
        lctx!.setTransform(1, 0, 0, 1, 0, 0);
        lctx!.clearRect(0, 0, layer.width, layer.height);
      }
      if (S.black > 0) {
        const b = solid ? c : lctx!;
        b.fillStyle = BLACK;
        for (const [k, p, lx, ly] of planes()) {
          plane(b, p, lx, ly);
          SHAPES[k].forEach((s) => b.fill(s));
        }
        if (!solid) {
          c.setTransform(1, 0, 0, 1, 0, 0);
          c.globalAlpha = S.black;
          c.drawImage(layer, 0, 0);
          c.globalAlpha = 1;
        }
      }
      c.fillStyle = RED;
      const balls = [
        [P.R, R_SHIFT + P.R.lx, 0, track(tracks.r, B.r), B.showR],
        [P.U, 0, P.U.ly, track(tracks.u, B.u), B.showU],
      ] as const;
      for (const [p, lx, ly, [x, y, r], show] of balls) {
        if (!show) continue;
        plane(c, p, lx, ly);
        c.beginPath();
        c.arc(x, y, r, 0, Math.PI * 2);
        c.fill();
      }
      sentence!.style.translate = `0 ${(P.U.drift * L.H).toFixed(2)}px`;
    }

    /* ---- the timeline ---- */
    // fast at both ends, slow through the middle: a ball lingers where the storyboard has it, never stops
    const linger = (p: number) => p + (0.72 * Math.sin(2 * Math.PI * p)) / (2 * Math.PI);
    const tl = gsap.timeline({ paused: true, onUpdate: draw });
    const through = (key: "u" | "r", t: Track, reach: number, at: number, duration: number) => {
      const run = { p: 0 };
      tl.to(run, { p: 1, duration, ease: "none", onUpdate: () => (B[key] = t.rest + reach * (2 * linger(run.p) - 1)) }, at);
    };

    // the first frame (job: say who Curveball is, in its own shapes): the « u » comes in from the left, the « r »
    // from the top; the shapes rise a little the whole time, the « r » nearer, faster
    tl.to(P.U, { ly: 0, duration: BASE, ease: ARRIVE }, 0);
    tl.to(P.R, { lx: 0, duration: BASE, ease: ARRIVE }, 0.08);
    tl.to(P.R, { drift: -0.035, duration: HOLD + DIVE, ease: "none" }, 0);
    tl.to(P.U, { drift: -0.02, duration: HOLD + DIVE, ease: "none" }, 0);
    // each ball runs the whole of its letter and leaves the frame: the r's round its shoulder and out by the right,
    // the u's up from below through the bowl, along the band behind the sentence and out by the left as the dive
    // starts; its size is the stroke's (97 %), so it never touches an edge where the stroke narrows
    through("r", tracks.r, 155, 0.2, HOLD + 0.25);
    through("u", tracks.u, 180, 0.35, HOLD - 0.35);
    // the sentence fades up line by line, as the site's openings do (no mask)
    tl.fromTo(words, { autoAlpha: 0, y: L.rise * 0.9 }, { autoAlpha: 1, y: 0, duration: BASE, ease: OUT, stagger: 0.07 }, 0.45);

    // the dive (job: go into the logo and come out on the work): the sentence goes, the black thins to the film
    // while each letter grows round the place it was read, the « r » faster; the film settles as it comes
    tl.to(words, { autoAlpha: 0, y: () => -L.rise * 0.6, duration: FAST, ease: LEAVE, stagger: 0.03 }, HOLD - 0.15);
    tl.to(P.U, { zoom: 1, duration: DIVE, ease: TRAVEL }, HOLD);
    tl.to(P.R, { zoom: 1.32, duration: DIVE, ease: TRAVEL }, HOLD);
    tl.to(S, { black: 0, duration: BASE, ease: TRAVEL }, HOLD + 0.1);
    if (media) tl.fromTo(media, { scale: 1.12 }, { scale: 1, duration: DIVE + 0.6, ease: OUT }, HOLD);
    tl.set(wrap, { autoAlpha: 0 }, HOLD + DIVE);

    // the opening's own elements (job: hand over to the page) while the film is still opening up: the wordmark,
    // the menu, the row's rule drawn from the left, then the row, one after another
    const reveal = HOLD + DIVE * 0.55;
    const up = () => ({ autoAlpha: 0, y: L.rise });
    const into = (stagger = 0) => ({ autoAlpha: 1, y: 0, duration: BASE, ease: OUT, stagger });
    if (title) tl.fromTo(title, up(), into(), reveal);
    if (nav.length) tl.fromTo(nav, up(), into(0.08), reveal + 0.12);
    if (row) tl.fromTo(row, { "--intro-rule": 0 }, { "--intro-rule": 1, duration: SLOW, ease: ARRIVE }, reveal + 0.3);
    if (rowItems.length) tl.fromTo(rowItems, up(), into(0.1), reveal + 0.5);
    tl.call(() => finish(), [], ">");

    /* ---- the page held still while it plays; a click, a key, the wheel or a swipe hurries it to its end ---- */
    let lenis: { stop(): void; start(): void } | undefined;
    const stopLenis = onLenis((l) => {
      lenis = l;
      l.stop();
    });
    root.style.overflow = "hidden";
    let done = false;
    function finish() {
      if (done) return;
      done = true;
      tl.kill();
      delete root.dataset.intro;
      gsap.set(wrap!, { autoAlpha: 0 });
      gsap.set([title, ...nav, ...rowItems, media].filter(Boolean), { clearProps: "opacity,visibility,transform,translate,scale" });
      row?.style.removeProperty("--intro-rule");
      root.style.removeProperty("overflow");
      lenis?.start();
      stopLenis();
      document.dispatchEvent(new Event("home-intro:end"));
    }
    let hurried = false;
    const hurry = () => {
      if (hurried || done) return;
      hurried = true;
      gsap.to(tl, { timeScale: 5, duration: FAST, ease: "none" });
    };
    for (const type of ["pointerdown", "keydown", "wheel", "touchmove"]) addEventListener(type, hurry, { signal, passive: true });
    addEventListener("resize", () => (layout(), draw()), { signal });
    signal.addEventListener("abort", finish, { once: true });

    layout();
    draw();
    root.dataset.intro = "run";
    // the sentence's face first (a second at most), then it plays
    Promise.race([document.fonts?.ready, new Promise((resolve) => setTimeout(resolve, 1000))]).then(() => {
      if (done) return;
      layout();
      tl.play();
    });
  });
</script>

<style is:global>
  @layer components {
    .home-intro_wrap {
      display: none;
    }
    /* while it plays it covers the page; at the first paint, before its drawing, the red of the storyboard */
    html[data-intro] .home-intro_wrap {
      position: fixed;
      inset: 0;
      z-index: var(--intro-layer);
      display: block;
      overflow: hidden;
    }
    html[data-intro="play"] .home-intro_wrap {
      background-color: var(--red);
    }
    /* the drawing fills the cover (the canvas) or the sample's box (the still) */
    :is(.home-intro_scene, .home-intro_still) {
      position: absolute;
      inset: 0;
      display: block;
      width: 100%;
      height: 100%;
    }
    /* the footer's sentence, on the « u »: the site's h2, smaller upright so it stays inside the band */
    .home-intro_line {
      position: absolute;
      margin: 0;
      color: var(--taupe);
      @media (orientation: portrait) {
        font-size: var(--h4);
      }
    }
    .home-intro_part {
      display: block;
      white-space: nowrap;
    }
    html[data-intro] .home-intro_part {
      opacity: 0;
    }
    /* the opening's own elements wait for it, which brings them in; the row's rule is drawn from the left */
    html[data-intro]
      :is(.nav_logo, .nav_links > li, .nav_contact, .nav_action, .hero-home_title, .hero-home_label, .hero-home_slides, .hero-home_count) {
      opacity: 0;
    }
    html[data-intro] .hero-home_row {
      border-top-color: transparent;
      &::before {
        content: "";
        position: absolute;
        inset: calc(var(--border-width) * -1) 0 auto;
        height: var(--border-width);
        background-color: var(--border);
        transform-origin: left;
        scale: var(--intro-rule, 0) 1;
      }
    }
    html[data-intro] .hero-home_media {
      transform-origin: center;
    }
    /* the components page: the first frame, still */
    .home-intro_sample {
      position: relative;
      width: 100%;
      aspect-ratio: 2000 / 1129;
      overflow: hidden;
      background-color: var(--red);
      container-type: inline-size;
      /* the storyboard's size: 62 of its 2000 */
      & .home-intro_line {
        left: 50.15%;
        top: 40.3%;
        font-size: 3.1cqi;
      }
    }
    .home-intro_still {
      fill: var(--black);
    }
    .home-intro_ball {
      fill: var(--red);
    }
  }
</style>
