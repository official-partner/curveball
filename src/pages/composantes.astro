---
import Layout from "@/layouts/BaseLayout.astro";
import ComponentList from "@/components/system/ComponentList.astro";
import ComponentSample from "@/components/system/ComponentSample.astro";
import Grid from "@/components/wrapper/Grid.astro";
import CardTeam from "@/components/content/CardTeam.astro";
import photo from "@/assets/content/team/lea-photo.webp";
import ArrowLink from "@/components/content/ArrowLink.astro";
import HeroHome from "@/components/section/HeroHome.astro";
import DirectorsHome from "@/components/section/DirectorsHome.astro";
import CurveBand from "@/components/section/CurveBand.astro";
import still from "@/assets/content/home/hero-still.jpg";
import SectionHead from "@/components/content/SectionHead.astro";
import CardNews from "@/components/content/CardNews.astro";
import ContactBlock from "@/components/content/ContactBlock.astro";
import CardPerson from "@/components/content/CardPerson.astro";
import NewsList from "@/components/section/NewsList.astro";
import ContactIntro from "@/components/section/ContactIntro.astro";
import TeamList from "@/components/section/TeamList.astro";
import Statement from "@/components/section/Statement.astro";
import { news } from "@/data/news.ts";
import { blocks, people } from "@/data/contact.ts";
---

<Layout
  title="Composantes"
  description="Les composantes faites pour ce site, chacune avec un exemple."
>
  <ComponentList>
    {
      /* One sample per component made for this site, with sample props: <ComponentSample file="content/HeroBlog.astro"><HeroBlog … /></ComponentSample> (CLAUDE.md, The components page) */
    }
    <ComponentSample file="content/ArrowLink.astro" note="A link with its arrow: Home's CTA, the news cards' « Read ».">
      <div class="container">
        <ArrowLink href="/contact" text="Start a conversation" />
      </div>
    </ComponentSample>
    <ComponentSample file="section/HeroHome.astro" note="Home's opening: the featured film's still, the wordmark, Play and the featured work's row.">
      <HeroHome still={still} />
    </ComponentSample>
    <ComponentSample file="section/DirectorsHome.astro" note="Every director in the big type, with the filters Industry and Location.">
      <DirectorsHome />
    </ComponentSample>
    <ComponentSample file="section/CurveBand.astro" note="The curve above the footer, Home's drawing with its CTA (News and Contact have their own).">
      <CurveBand variant="home" />
    </ComponentSample>
    <ComponentSample file="content/SectionHead.astro" note="An inner page's section head: the rule, the label, the heading.">
      <div class="site-grid">
        <SectionHead label="Get in touch." heading="Tell us which one you are and we'll skip you to the right person." />
      </div>
    </ComponentSample>
    <ComponentSample file="content/CardNews.astro" note="A news card: the round photo, the source and the date, the title, the text, Read.">
      <div class="site-grid theme-mustard">
        <div style="grid-column: margin / span 3"><CardNews item={news[0]} /></div>
      </div>
    </ComponentSample>
    <ComponentSample file="content/ContactBlock.astro" note="One way in on Contact; hover it for the dot.">
      <div class="site-grid theme-teal">
        <div style="grid-column: margin / span 4"><ContactBlock block={blocks[0]} /></div>
      </div>
    </ComponentSample>
    <ComponentSample file="content/CardPerson.astro" note="A person of the team.">
      <div class="site-grid theme-teal">
        <div style="grid-column: margin / span 3"><CardPerson person={people[0]} /></div>
      </div>
    </ComponentSample>
    <ComponentSample file="section/NewsList.astro" note="News: the head and the cards in three staggered columns.">
      <div class="theme-mustard"><NewsList /></div>
    </ComponentSample>
    <ComponentSample file="section/ContactIntro.astro" note="Contact's head and its four ways in.">
      <div class="theme-teal"><ContactIntro /></div>
    </ComponentSample>
    <ComponentSample file="section/TeamList.astro" note="Contact's team, scattered as the Figma places them.">
      <div class="theme-teal"><TeamList /></div>
    </ComponentSample>
    <ComponentSample file="section/Statement.astro" note="A statement over the full width, with its link.">
      <div class="theme-teal">
        <Statement label="Where it started" heading="New Orleans is the flagship city, not an office address." link={{ text: "Start a conversation", href: "/contact" }} />
      </div>
    </ComponentSample>
    <ComponentSample
      file="content/CardTeam.astro"
      note="Une personne de l’équipe : complète, puis avec son nom seulement."
    >
      <div class="container">
        <Grid small={2} medium={3}>
          <CardTeam
            person={{
              name: "Léa Tremblay",
              role: "Direction",
              bio: "Elle a fondé le studio en 2014 et suit chaque projet du premier appel jusqu’à la mise en ligne.",
              photo,
              specialties: ["Stratégie", "Identité", "Direction artistique"],
            }}
          />
          <CardTeam person={{ name: "Sophie Roy" }} />
        </Grid>
      </div>
    </ComponentSample>
  </ComponentList>
</Layout>
